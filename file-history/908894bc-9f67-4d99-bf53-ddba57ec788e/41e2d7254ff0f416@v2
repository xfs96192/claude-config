#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
从 Word 季报提取各产品策略描述，填入 Excel 对应行
"""
from docx import Document
import pandas as pd
from openpyxl import load_workbook

WORD_PATH = '/Users/fanshengxia/Desktop/季报汇总/季报20260331/2026年一季报策略报告-徐莹更新.docx'
EXCEL_PATH = '/Users/fanshengxia/Desktop/季报汇总/季报20260331/多资产投资部投资经理和投资策略部分 (5).xlsx'

# ============================================================
# 1. 从 Word 提取各产品完整文本
# ============================================================
doc = Document(WORD_PATH)
paras = [p.text.strip() for p in doc.paragraphs]

def full_text(para_indices):
    """合并多个段落文本（去掉空行）"""
    parts = [paras[i] for i in para_indices if paras[i]]
    return '\n  '.join(parts)  # 段前空2字符（全角空格代替）

# 产品代码 → 策略文本映射
# 以 Word 文档段落索引提取（已从上面的输出确认）
content_map = {
    '9K221040': full_text([3, 5]),          # ESG兴动绿色发展
    '9K221050': full_text([8, 10, 11]),     # ESG兴动责任投资
    '9K221060': full_text([15, 16]),        # ESG兴动优质企业
    '9S650300': paras[19],                  # 多策略1年持有期3号（含名称前缀）
    '9S232010': paras[22],                  # 丰利兴动ESG日开
    '9K717310': paras[24],                  # 价值回报
    '9K717120': paras[26],                  # 资源优势
    '9S128030': paras[29],                  # 灵动优选九个月持有期1号
    '9K717810': paras[31],                  # 逸动1M
    '9K706130': paras[33],                  # 逸动6个月日开03号
    '9K707200': paras[35],                  # 逸动10M 2号
    '9K709160': paras[37],                  # 逸动1年6号
    '9K717240': paras[38],                  # 逸动3M日开7号
    '9K221501': paras[41],                  # 兴动未来1号
    '9K777010': paras[43],                  # 兴承恒享1号
    '9K212086': paras[45],                  # 灵动全天候36号
    '9K717430': paras[46],                  # 灵动日开
    '9K210030': paras[51],                  # 悦动9M
    '9K731010': paras[53],                  # 悦动1M
    '9K220110': paras[55],                  # 悦动2号ESG
    '9K220160': paras[57],                  # ESG悦动7号
    '9K241190': paras[59],                  # 合享119号
    '9K241290': paras[60],                  # 合享129号
    '9K241350': paras[61],                  # 合享135号
    '9K241420': paras[62],                  # 合享142号
    '9K241480': paras[63],                  # 合享148号
    '9K251550': paras[64],                  # 合享155号
    '9K251610': paras[65],                  # 合享161号
    '9K251650': paras[66],                  # 合享165号
    '9T310560': paras[69],                  # 悦动56号
    '9T310510': paras[70],                  # 悦动51号
    '9T310610': paras[71],                  # 悦动61号
}

print(f"提取产品数量: {len(content_map)}")

# ============================================================
# 2. 写入 Excel
# ============================================================
wb = load_workbook(EXCEL_PATH)
ws = wb.active

# 找列索引：header 在第2行（row=2）
header_row = 2
col_map = {}
for cell in ws[header_row]:
    if cell.value:
        col_map[str(cell.value).strip()[:10]] = cell.column

print("Excel 列映射:", {k: v for k, v in col_map.items()})

# 找产品代码列和策略文本列
code_col = None
strategy_col = None
for col_key, col_idx in col_map.items():
    if '产品代码' in col_key:
        code_col = col_idx
    if '投资策略' in col_key:
        strategy_col = col_idx

print(f"产品代码列: {code_col}, 策略文本列: {strategy_col}")

if code_col is None or strategy_col is None:
    raise ValueError("未找到必要列")

# 遍历数据行，匹配产品代码并填入
filled = 0
not_found = []
for row in ws.iter_rows(min_row=header_row + 1, max_row=ws.max_row):
    code_cell = row[code_col - 1]
    code = str(code_cell.value).strip() if code_cell.value else ''
    if code in content_map:
        strategy_cell = row[strategy_col - 1]
        strategy_cell.value = content_map[code]
        # 设置单元格自动换行
        from openpyxl.styles import Alignment
        strategy_cell.alignment = Alignment(wrap_text=True, vertical='top')
        filled += 1
    elif code and code != 'nan':
        # 检查是否是徐莹/夏凡盛的产品但没有内容映射
        manager_cell = row[2]  # 第3列是投资经理
        manager = str(manager_cell.value) if manager_cell.value else ''
        if '徐莹' in manager or '夏凡盛' in manager:
            not_found.append((code, manager))

wb.save(EXCEL_PATH)
print(f"\n成功填入 {filled} 个产品")
if not_found:
    print(f"徐莹/夏凡盛管理但未找到对应内容的产品: {not_found}")
else:
    print("所有徐莹/夏凡盛产品均已填入")
