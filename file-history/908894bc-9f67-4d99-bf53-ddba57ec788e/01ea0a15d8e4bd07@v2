def insert_after_paragraph_containing(text, decoded, new_para_text_list):
    """在包含 text 的段落的 </w:p> 后插入新段落"""
    # 找到文本所在的段落，然后在</w:p>之后插入
    pos = decoded.find(text)
    if pos == -1:
        print(f"WARNING: 未找到锚点文本: {text[:30]}")
        return decoded
    # 找到这之后最近的 </w:p>
    close_pos = decoded.find('</w:p>', pos)
    if close_pos == -1:
        print(f"WARNING: 未找到</w:p>: {text[:30]}")
        return decoded
    insert_point = close_pos + len('</w:p>')
    new_xml = ''
    for t in new_para_text_list:
        new_xml += make_para(t)
    return decoded[:insert_point] + new_xml + decoded[insert_point:]

