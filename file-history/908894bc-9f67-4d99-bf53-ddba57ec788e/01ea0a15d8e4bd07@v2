# ---- 工具函数 ----
def encode_ascii(text):
    """将Unicode字符串编码回ASCII实体"""
    result = []
    for ch in text:
        if ord(ch) > 127:
            result.append(f'&#{ord(ch)};')
        elif ch == '&':
            result.append('&amp;')
        elif ch == '<':
            result.append('&lt;')
        elif ch == '>':
            result.append('&gt;')
        else:
            result.append(ch)
    return ''.join(result)

def make_para(text, indent="420", font_size=None):
    """生成简单段落 XML（带缩进）"""
    enc = encode_ascii(text)
    if font_size:
        rpr = (f'<w:rPr>'
               f'<w:rFonts w:ascii="&#23435;&#20307;" w:eastAsia="&#23435;&#20307;" '
               f'w:hAnsi="&#23435;&#20307;" w:cs="&#23435;&#20307;"/>'
               f'<w:sz w:val="{font_size}"/><w:szCs w:val="{font_size}"/>'
               f'</w:rPr>')
        ppr_rpr = (f'<w:rPr>'
                   f'<w:rFonts w:ascii="&#23435;&#20307;" w:eastAsia="&#23435;&#20307;" '
                   f'w:hAnsi="&#23435;&#20307;" w:cs="&#23435;&#20307;"/>'
                   f'<w:sz w:val="{font_size}"/><w:szCs w:val="{font_size}"/>'
                   f'</w:rPr>')
    else:
        rpr = ''
        ppr_rpr = ''
    ppr = f'<w:pPr><w:ind w:firstLineChars="200" w:firstLine="{indent}"/>{ppr_rpr}</w:pPr>'
    run = f'<w:r>{rpr}<w:t>{enc}</w:t></w:r>'
    return f'\n    <w:p>\n      {ppr}\n      {run}\n    </w:p>'

