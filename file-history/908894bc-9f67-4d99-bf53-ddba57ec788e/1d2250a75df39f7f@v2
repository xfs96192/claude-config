#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import pandas as pd
import os, shutil
from openpyxl import load_workbook
from openpyxl.styles import Alignment, PatternFill, Font, Border, Side
from openpyxl.utils import get_column_letter
from datetime import datetime

FOLDER = '/Users/fanshengxia/Desktop/季报汇总/季报20260331'
STRAT_COL = '投资策略和运作分析（2026年一季报）\n（段前空2个中文字符）'

# ============================================================
# 1. 重命名 (5).xlsx → 多资产投资部投资经理和投资策略部分-徐莹.xlsx
# ============================================================
old_name = os.path.join(FOLDER, '多资产投资部投资经理和投资策略部分 (5).xlsx')
new_name = os.path.join(FOLDER, '多资产投资部投资经理和投资策略部分-徐莹.xlsx')
if os.path.exists(old_name):
    shutil.copy2(old_name, new_name)
    print(f"已复制并重命名: {os.path.basename(new_name)}")
else:
    print("WARNING: 源文件不存在，直接使用新名称文件")

# ============================================================
# 2. 读取所有分文件，按产品代码合并策略文本
# ============================================================
source_files = {
    '徐莹/夏凡盛': '多资产投资部投资经理和投资策略部分-徐莹.xlsx',
    '李佳航/姜锡峰': '多资产投资部投资经理和投资策略部分 李佳航 姜锡峰.xlsx',
    '薛纪晔/黄亦尧': '多资产投资部投资经理和投资策略部分202601薛纪晔.xlsx',
    '高翰昆': '多资产投资部投资经理和投资策略部分-2026年一季度报-高翰昆.xlsx',
    '罗谨深': '多资产投资部投资经理和投资策略部分-2026一季度罗谨深.xlsx',
}

# 用徐莹文件作为基础模板（含完整产品列表+徐莹内容）
base_df = pd.read_excel(os.path.join(FOLDER, '多资产投资部投资经理和投资策略部分-徐莹.xlsx'), header=1)
base_df['产品代码'] = base_df['产品代码'].astype(str).str.strip()

# 合并：遍历各文件，将有内容的行填入 base_df
for label, fname in source_files.items():
    if '徐莹' in fname:
        continue  # 已经是基础，跳过
    path = os.path.join(FOLDER, fname)
    if not os.path.exists(path):
        print(f"WARNING: 文件不存在: {fname}")
        continue
    df = pd.read_excel(path, header=1)
    df['产品代码'] = df['产品代码'].astype(str).str.strip()
    # 只取有策略内容的行
    filled = df[df[STRAT_COL].notna()][['产品代码', STRAT_COL]]
    for _, row in filled.iterrows():
        code = row['产品代码']
        mask = base_df['产品代码'] == code
        if mask.any():
            # 只在原来为空时填入
            if pd.isna(base_df.loc[mask, STRAT_COL].values[0]):
                base_df.loc[mask, STRAT_COL] = row[STRAT_COL]
    print(f"[{label}] 已合并 {len(filled)} 条")

# ============================================================
# 3. 统计：哪些投资经理/产品已汇总、哪些遗漏
# ============================================================
total = len(base_df)
filled_mask = base_df[STRAT_COL].notna() & (base_df[STRAT_COL].astype(str).str.len() > 3)
filled_count = filled_mask.sum()
unfilled_count = total - filled_count

# 按投资经理统计完成情况
def normalize_manager(s):
    """拆分多投资经理，返回主要负责人"""
    return str(s).strip() if pd.notna(s) else '未知'

base_df['_manager'] = base_df['主投资经理/投资经理姓名'].apply(normalize_manager)

manager_stats = []
all_managers = set()
for m in base_df['_manager'].unique():
    rows = base_df[base_df['_manager'] == m]
    done = rows[filled_mask.reindex(rows.index, fill_value=False)].shape[0]
    total_m = len(rows)
    all_managers.add(m)
    manager_stats.append({'投资经理': m, '产品总数': total_m, '已汇总': done, '未汇总': total_m - done})

stats_df = pd.DataFrame(manager_stats).sort_values('投资经理')

# 找出未填充的产品
unfilled_df = base_df[~filled_mask][['产品代码','产品名称','主投资经理/投资经理姓名', STRAT_COL]]

# 提取"已提交策略文件"的老师
submitted_managers = set()
for label in source_files.keys():
    for m in label.split('/'):
        submitted_managers.add(m.strip())

# 提取"有遗漏"的主要老师（有产品但全部未填）
fully_missing = stats_df[stats_df['已汇总'] == 0]['投资经理'].tolist()
partially_missing = stats_df[(stats_df['已汇总'] > 0) & (stats_df['未汇总'] > 0)]['投资经理'].tolist()

print(f"\n总产品: {total}")
print(f"已汇总: {filled_count}")
print(f"未汇总: {unfilled_count}")

# ============================================================
# 4. 保存合并后的 Excel
# ============================================================
OUT_EXCEL = os.path.join(FOLDER, '多资产投资部投资经理和投资策略部分-全部汇总2026Q1.xlsx')

# 用 openpyxl 写入，保留格式
base_df_out = base_df.drop(columns=['_manager'])
with pd.ExcelWriter(OUT_EXCEL, engine='openpyxl') as writer:
    base_df_out.to_excel(writer, sheet_name='全部产品汇总', index=False, startrow=1)
    wb = writer.book
    ws = writer.sheets['全部产品汇总']

    # 写标题行
    ws['A1'] = '多资产投资部投资经理和投资策略部分 - 2026年一季报汇总'
    ws['A1'].font = Font(bold=True, size=13)
    ws.merge_cells('A1:I1')

    # 调整列宽
    ws.column_dimensions['A'].width = 14
    ws.column_dimensions['B'].width = 40
    ws.column_dimensions['C'].width = 18
    ws.column_dimensions['D'].width = 60
    for col in ['E','F','G','H','I']:
        ws.column_dimensions[col].width = 12

    # 颜色标记：策略为空的行标黄
    yellow = PatternFill("solid", fgColor="FFF2CC")
    green = PatternFill("solid", fgColor="E2EFDA")
    for row in ws.iter_rows(min_row=3, max_row=ws.max_row):
        strat_cell = row[3]  # D列 = 策略文本
        if not strat_cell.value or str(strat_cell.value).strip() == '' or str(strat_cell.value) == 'nan':
            for cell in row:
                cell.fill = yellow
        else:
            strat_cell.alignment = Alignment(wrap_text=True, vertical='top')

print(f"合并 Excel 已保存: {os.path.basename(OUT_EXCEL)}")

# ============================================================
# 5. 生成说明文档（Markdown）
# ============================================================
now = datetime.now().strftime('%Y-%m-%d %H:%M')
md_lines = [
    f'# 2026年一季报投资策略汇总说明',
    f'',
    f'**生成时间**: {now}  ',
    f'**文件路径**: `季报20260331/`  ',
    f'**总产品数**: {total}  |  **已汇总**: {filled_count}  |  **未汇总**: {unfilled_count}',
    f'',
    f'---',
    f'',
    f'## 一、已提交策略文件的老师',
    f'',
    f'| 文件 | 负责老师 | 已填产品数 |',
    f'|------|---------|-----------|',
]

file_summary = [
    ('多资产投资部投资经理和投资策略部分-徐莹.xlsx', '徐莹、夏凡盛', 32),
    ('多资产投资部投资经理和投资策略部分 李佳航 姜锡峰.xlsx', '姜锡峰、李佳航', 29),
    ('多资产投资部投资经理和投资策略部分202601薛纪晔.xlsx', '薛纪晔、黄亦尧', 29),
    ('多资产投资部投资经理和投资策略部分-2026年一季度报-高翰昆.xlsx', '高翰昆', 29),
    ('多资产投资部投资经理和投资策略部分-2026一季度罗谨深.xlsx', '罗谨深（仅1条）', 1),
]
for fname, managers, cnt in file_summary:
    md_lines.append(f'| `{fname}` | {managers} | {cnt} |')

md_lines += [
    f'',
    f'---',
    f'',
    f'## 二、各投资经理汇总状态',
    f'',
    f'| 投资经理 | 产品总数 | 已汇总 | 未汇总 | 状态 |',
    f'|---------|---------|-------|-------|------|',
]

for _, r in stats_df.sort_values(['未汇总','投资经理'], ascending=[False, True]).iterrows():
    mgr = r['投资经理']
    status = '✅ 完成' if r['未汇总'] == 0 else ('⚠️ 部分完成' if r['已汇总'] > 0 else '❌ 未提交')
    md_lines.append(f"| {mgr} | {r['产品总数']} | {r['已汇总']} | {r['未汇总']} | {status} |")

md_lines += [
    f'',
    f'---',
    f'',
    f'## 三、未汇总产品清单（共 {unfilled_count} 条）',
    f'',
    f'| 产品代码 | 产品名称 | 投资经理 |',
    f'|---------|---------|---------|',
]

for _, r in unfilled_df.iterrows():
    name = str(r['产品名称'])[:35] + ('...' if len(str(r['产品名称'])) > 35 else '')
    md_lines.append(f"| {r['产品代码']} | {name} | {r['主投资经理/投资经理姓名']} |")

md_lines += [
    f'',
    f'---',
    f'',
    f'## 四、待催促提交的老师',
    f'',
    f'以下老师**全部产品均未填写策略**，需优先催促提交：',
    f'',
]

# 未提交任何内容的老师（排除共管中已覆盖的情况）
# 简单判断：产品主责人完全未填
solo_unfilled = stats_df[(stats_df['已汇总'] == 0) & (stats_df['产品总数'] >= 3)]
for _, r in solo_unfilled.sort_values('产品总数', ascending=False).iterrows():
    md_lines.append(f"- **{r['投资经理']}**：共 {r['产品总数']} 个产品，全部未填")

md_lines += [
    f'',
    f'以下老师**部分提交**（共管产品有遗漏）：',
    f'',
]
partial = stats_df[(stats_df['已汇总'] > 0) & (stats_df['未汇总'] > 0)]
for _, r in partial.sort_values('未汇总', ascending=False).iterrows():
    md_lines.append(f"- **{r['投资经理']}**：{r['产品总数']} 个产品，已填 {r['已汇总']}，未填 {r['未汇总']}")

md_lines += [
    f'',
    f'---',
    f'',
    f'## 五、输出文件说明',
    f'',
    f'- `多资产投资部投资经理和投资策略部分-全部汇总2026Q1.xlsx` — 所有已提交策略合并版，**黄色行**为未填充产品',
    f'- `多资产投资部投资经理和投资策略部分-徐莹.xlsx` — 徐莹/夏凡盛负责产品（原文件重命名）',
    f'',
]

MD_PATH = os.path.join(FOLDER, '汇总说明_2026Q1.md')
with open(MD_PATH, 'w', encoding='utf-8') as f:
    f.write('\n'.join(md_lines))

print(f"说明文档已保存: {os.path.basename(MD_PATH)}")
print("\n=== 完成 ===")
