    results = {}
    failed = []

    # 逐个获取，避免多指标混合时解析困难
    for code, name in BOND_EDB_CODES.items():
        try:
            raw = c.edb(code, f"StartDate={start_date},EndDate={end_date},Ispandas=1")
            df = parse_edb_df(raw, code)
            if df is not None and not df.empty:
                latest_val, change, unit = calc_weekly_change(df, 'bp_change')
                sign = '+' if change >= 0 else ''
                print(f"  ✅ {name} ({code}): 最新={latest_val:.4f}%, 周变动={sign}{change}{unit}")
                results[code] = {'name': name, 'df': df, 'change': change, 'unit': unit}
            else:
                print(f"  ❌ {name} ({code}): 无数据返回")
                failed.append(code)
        except Exception as e:
            print(f"  ❌ {name} ({code}): 异常 - {e}")
            failed.append(code)

    print(f"\n债券: 成功 {len(results)}/{len(BOND_EDB_CODES)}, 失败 {len(failed)}")
    if failed:
        print(f"  失败代码: {failed}")
    return results


