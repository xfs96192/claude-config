HISTORY_SIZE = 20

# ── 格式化输出 ───────────────────────────────────────────────────────────────

def fmt_pct(val):
    """格式化涨跌幅"""
    if val is None:
        return "  N/A  "
    sign = "+" if val >= 0 else ""
    color = "\033[91m" if val >= 0 else "\033[92m"  # 红涨绿跌（A股习惯）
    return f"{color}{sign}{val:.2f}%\033[0m"

def fmt_vol(vol):
    """成交量/额 单位换算"""
    if vol is None:
        return "N/A"
    if vol >= 1e8:
        return f"{vol/1e8:.2f}亿"
    if vol >= 1e4:
        return f"{vol/1e4:.1f}万"
    return str(int(vol))

def print_bar(etf_id, bar):
    """打印单条分钟线"""
    name = ETF_NAME.get(etf_id, etf_id)
    ts   = bar.get("datetime", datetime.now()).strftime("%H:%M")
    o    = bar.get("open",  0)
    h    = bar.get("high",  0)
    lo   = bar.get("low",   0)
    c    = bar.get("close", 0)
    vol  = bar.get("volume", 0)
    amt  = bar.get("total_turnover", 0)
    chg  = (c - o) / o * 100 if o else None

    print(
        f"[{ts}] {name:14s} | "
        f"O:{o:.4f}  H:{h:.4f}  L:{lo:.4f}  C:{c:.4f} | "
        f"涨跌:{fmt_pct(chg)} | "
        f"量:{fmt_vol(vol):>8s}  额:{fmt_vol(amt):>8s}"
    )

def print_separator():
    print("-" * 90)

# ── 方案一：WebSocket 实时推送 ────────────────────────────────────────────────

def run_websocket_mode():
    """
    使用 LiveMarketDataClient 订阅 1 分钟 bar 推送。
    每根 K 线收盘时服务端主动推送，延迟极低。
    """
    print("\n=== 实时推送模式（WebSocket） ===")
    print(f"订阅标的：{', '.join(ETF_LIST)}")
    print("等待数据推送中...（Ctrl+C 退出）\n")
    print_separator()

    from rqdatac import LiveMarketDataClient
    client = LiveMarketDataClient()

    # 订阅每只ETF的1分钟bar
    for etf in ETF_LIST:
        client.subscribe(f"bar_{etf}")
        print(f"  已订阅: bar_{etf}")
    print()

    # 注册优雅退出
    def on_exit(sig, frame):
        print("\n正在取消订阅并退出...")
        for etf in ETF_LIST:
            client.unsubscribe(f"bar_{etf}")
        sys.exit(0)
    signal.signal(signal.SIGINT, on_exit)

    # 阻塞监听
    for market_data in client.listen():
        try:
            etf_id = market_data.get("order_book_id", "")
            if etf_id in ETF_LIST:
                print_bar(etf_id, market_data)
        except Exception as e:
            print(f"[错误] 处理数据异常: {e}")

# ── 方案二：轮询模式（备用） ──────────────────────────────────────────────────

def run_polling_mode(interval_seconds=60):
    """
    每隔 interval_seconds 秒轮询一次最新分钟线。
    适合网络不支持 WebSocket 长连接的环境。
    """
    print(f"\n=== 轮询模式（每 {interval_seconds}s 刷新） ===")
    print(f"监控标的：{', '.join(ETF_LIST)}")
    print("按 Ctrl+C 退出\n")
    print_separator()

    history = {etf: deque(maxlen=HISTORY_SIZE) for etf in ETF_LIST}

    def on_exit(sig, frame):
        print("\n已退出。")
        sys.exit(0)
    signal.signal(signal.SIGINT, on_exit)

    while True:
        now = datetime.now()
        print(f"\n[刷新时间] {now.strftime('%Y-%m-%d %H:%M:%S')}")
        print_separator()

        for etf in ETF_LIST:
            try:
                df = rqdatac.current_minute(etf)
                if df is None or df.empty:
                    print(f"  {ETF_NAME.get(etf, etf)}: 暂无数据（非交易时段）")
                    continue

                row = df.iloc[-1]
                bar = {
                    "datetime":       now,
                    "open":           row.get("open",  0),
                    "high":           row.get("high",  0),
                    "low":            row.get("low",   0),
                    "close":          row.get("close", 0),
                    "volume":         row.get("volume", 0),
                    "total_turnover": row.get("total_turnover", 0),
                }
                history[etf].append(bar)
                print_bar(etf, bar)

                # 打印简单统计（若有足够历史）
                if len(history[etf]) >= 2:
                    closes = [b["close"] for b in history[etf]]
                    pct = (closes[-1] - closes[0]) / closes[0] * 100 if closes[0] else 0
                    print(f"  └ 区间累计涨跌: {fmt_pct(pct)}  "
                          f"（近 {len(history[etf])} 根 bar，"
                          f"最高:{max(b['high'] for b in history[etf]):.4f}  "
                          f"最低:{min(b['low']  for b in history[etf]):.4f}）")

            except Exception as e:
                print(f"  {ETF_NAME.get(etf, etf)} 查询失败: {e}")

        print_separator()
        time.sleep(interval_seconds)

# ── 获取今日历史分钟线 ────────────────────────────────────────────────────────

def fetch_today_history():
    """获取今日已有的全部分钟 K 线（用于启动时回溯）"""
    today = datetime.now().strftime("%Y-%m-%d")
    print(f"\n=== 今日历史分钟线（{today}）===")

    for etf in ETF_LIST:
        try:
            df = rqdatac.get_price(
                etf,
                start_date=today,
                end_date=today,
                frequency="1m",
                adjust_type="none",
            )
            if df is None or df.empty:
                print(f"\n{ETF_NAME.get(etf, etf)}: 今日暂无分钟数据")
                continue

            print(f"\n{ETF_NAME.get(etf, etf)} ({etf}) - 共 {len(df)} 根分钟线")
            print(f"{'时间':>8} {'开盘':>8} {'最高':>8} {'最低':>8} {'收盘':>8} {'成交量':>10} {'成交额':>12}")
            print("-" * 70)

            for ts, row in df.iterrows():
                t = ts.strftime("%H:%M") if hasattr(ts, "strftime") else str(ts)
                print(
                    f"{t:>8} "
                    f"{row['open']:>8.4f} "
                    f"{row['high']:>8.4f} "
                    f"{row['low']:>8.4f} "
                    f"{row['close']:>8.4f} "
                    f"{fmt_vol(row.get('volume', 0)):>10} "
                    f"{fmt_vol(row.get('total_turnover', 0)):>12}"
                )

        except Exception as e:
            print(f"{ETF_NAME.get(etf, etf)} 获取失败: {e}")

