def test_csd(label, code, field="CLOSE", start=START_DATE_DAILY, end=END_DATE):
    """测试 CSD 行情数据"""
    try:
        data = c.csd(code, field, start, end, "Ispandas=1")
        if isinstance(data, pd.DataFrame) and not data.empty and 'CLOSE' in data.columns:
            last_val = pd.to_numeric(data['CLOSE'], errors='coerce').dropna()
            if len(last_val) > 0:
                print(f"  ✅ {label} ({code}): 最新值={last_val.iloc[-1]:.4f}, 数据点={len(last_val)}")
                passed.append(f"{label} ({code})")
                return data
        print(f"  ❌ {label} ({code}): 数据为空或格式错误. ErrorCode={getattr(data,'ErrorCode','N/A')}")
        failed.append(f"{label} ({code})")
    except Exception as e:
        print(f"  ❌ {label} ({code}): 异常 {e}")
        failed.append(f"{label} ({code})")
    return None

