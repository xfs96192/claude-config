#!/usr/bin/env python3
"""
update_db.py — 将最新国泰安数据底表导入 financial_data.db

默认策略（全量替换）：清空各表后从新数据目录重新导入。
可选增量覆写：仅删除与新数据主键重合的旧行，再插入新行。

用法：
  python3 update_db.py                          # 自动检测 '数据底表*' 目录，全量替换
  python3 update_db.py --data-dir <路径>        # 指定数据目录
  python3 update_db.py --table 利润表           # 仅更新指定表（可多次指定）
  python3 update_db.py --incremental            # 增量覆写（不清空全表）
  python3 update_db.py --dry-run                # 只显示操作计划，不修改数据库
"""
import argparse
import os
import re
import sqlite3
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple
import pandas as pd

# ── 路径配置 ───────────────────────────────────────────────────
BASE_DIR = Path(__file__).parent
DB_PATH = BASE_DIR / "financial_data.db"
CHUNK_ROWS = 20_000  # 每批读取行数

# ── 表定义：DB表名 → (Excel文件名, DES文件名, 主键列)  ──────────
TABLE_DEFS: Dict[str, Tuple[str, str, List[str]]] = {
    "资产负债表":           ("FS_Combas.xlsx",            "FS_Combas[DES][xlsx].txt",            ["Stkcd", "Accper", "Typrep"]),
    "利润表":               ("FS_Comins.xlsx",             "FS_Comins[DES][xlsx].txt",             ["Stkcd", "Accper", "Typrep"]),
    "现金流量表":           ("FS_Comscfd.xlsx",            "FS_Comscfd[DES][xlsx].txt",            ["Stkcd", "Accper", "Typrep"]),
    "现金流量表(间接法)":   ("FS_Comscfi.xlsx",            "FS_Comscfi[DES][xlsx].txt",            ["Stkcd", "Accper", "Typrep"]),
    "所有者权益表":         ("FN_FN046.xlsx",              "FN_FN046[DES][xlsx].txt",              ["Stkcd", "Accper", "Typrep"]),
    "上市公司基本信息年度表": ("STK_LISTEDCOINFOANL.xlsx", "STK_LISTEDCOINFOANL[DES][xlsx].txt",  ["Symbol", "EndDate"]),
}

# Excel 前几行为表头（代码行/中文名行/单位行），数据从第4行开始
EXCEL_HEADER_ROWS = 3


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="增量/全量更新 financial_data.db",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    p.add_argument("--data-dir", type=Path, default=None,
                   help="新数据根目录（默认自动检测最新 '数据底表*' 目录）")
    p.add_argument("--table", action="append", dest="tables", metavar="表名",
                   help="仅更新指定表（可多次使用）")
    p.add_argument("--incremental", action="store_true",
                   help="增量覆写模式：仅删除主键冲突的旧行再插入（默认为全量替换）")
    p.add_argument("--dry-run", action="store_true",
                   help="仅显示操作计划，不修改数据库")
    return p.parse_args()


def find_latest_data_dir(base: Path) -> Optional[Path]:
    """自动检测最新的 '数据底表*' 目录（按名称倒序取第一个）。"""
    candidates = sorted(base.glob("数据底表*"), key=lambda p: p.name, reverse=True)
    return candidates[0] if candidates else None


def parse_desc(des_path: Path) -> List[Dict]:
    """解析 [DES][xlsx].txt，返回列元数据列表 [{code, cn_name, desc}]。"""
    cols = []
    if not des_path.exists():
        return cols
    pat = re.compile(r"^(\S+)\s+\[([^\]]+)\]\s+-\s*(.*)$")
    with des_path.open("r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            m = pat.match(line)
            if m:
                code, cn_name, desc = m.groups()
                cols.append({"code": code, "cn_name": cn_name, "desc": desc})
    return cols


def find_file_recursive(data_dir: Path, filename: str) -> Optional[Path]:
    """在 data_dir 中递归查找指定文件名（精确匹配，不解释 glob 通配符）。"""
    for root, _dirs, files in os.walk(data_dir):
        if filename in files:
            return Path(root) / filename
    return None


def get_db_columns(conn: sqlite3.Connection, table: str) -> List[str]:
    cur = conn.execute(f'PRAGMA table_info("{table}")')
    return [row[1] for row in cur.fetchall()]


def table_exists(conn: sqlite3.Connection, table: str) -> bool:
    row = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (table,)
    ).fetchone()
    return row is not None


def ensure_table_schema(conn: sqlite3.Connection, table: str, col_defs: List[Dict]):
    """若表不存在则创建；若表存在则添加缺失列。"""
    if not table_exists(conn, table):
        cols_sql = ",\n  ".join(f'"{c["code"]}" NUMERIC' for c in col_defs)
        conn.execute(f'CREATE TABLE IF NOT EXISTS "{table}" (\n  {cols_sql}\n)')
        # 为标准主键创建索引
        codes = {c["code"] for c in col_defs}
        fin_keys = ["Stkcd", "Accper", "Typrep"]
        if all(k in codes for k in fin_keys):
            conn.execute(
                f'CREATE INDEX IF NOT EXISTS "idx_{table}_stkcd_accper_typrep" '
                f'ON "{table}" ("Stkcd","Accper","Typrep")'
            )
        conn.commit()
        print(f"    ✓ 新建表 {table}（{len(col_defs)} 列）")
    else:
        existing = set(get_db_columns(conn, table))
        new_cols = [c for c in col_defs if c["code"] not in existing]
        for c in new_cols:
            conn.execute(f'ALTER TABLE "{table}" ADD COLUMN "{c["code"]}" NUMERIC')
            print(f"    + 新增列 {table}.{c['code']}（{c['cn_name']}）")
        if new_cols:
            conn.commit()


def upsert_dictionary(conn: sqlite3.Connection, table: str, col_defs: List[Dict]):
    """更新数据字典表。"""
    conn.executemany(
        """INSERT INTO dictionary (table_name, column_code, column_name_cn, column_desc)
           VALUES (?, ?, ?, ?)
           ON CONFLICT(table_name, column_code)
           DO UPDATE SET column_name_cn=excluded.column_name_cn,
                         column_desc=excluded.column_desc""",
        [(table, c["code"], c["cn_name"], c["desc"]) for c in col_defs],
    )
    conn.commit()


def delete_by_keys(conn: sqlite3.Connection, table: str, keys: List[str], df: "pd.DataFrame"):
    """增量模式：删除与 df 中主键值相同的旧行（分批执行）。"""
    avail_keys = [k for k in keys if k in df.columns]
    if not avail_keys:
        return
    where = " AND ".join(f'"{k}"=?' for k in avail_keys)
    key_vals = df[avail_keys].drop_duplicates().values.tolist()
    for i in range(0, len(key_vals), 5000):
        batch = key_vals[i : i + 5000]
        for vals in batch:
            conn.execute(f'DELETE FROM "{table}" WHERE {where}', vals)


def import_table(
    conn: sqlite3.Connection,
    table: str,
    xlsx_path: Path,
    des_path: Path,
    keys: List[str],
    incremental: bool = False,
    dry_run: bool = False,
) -> int:
    """导入单张表。返回实际写入行数。"""
    col_defs = parse_desc(des_path)
    if not col_defs:
        print(f"    [跳过] 无法解析 DES 文件：{des_path.name}")
        return 0

    codes = [c["code"] for c in col_defs]
    strategy = "增量覆写" if incremental else "全量替换"

    if dry_run:
        print(f"    [dry-run] 策略={strategy}，来源={xlsx_path.name}，列数={len(codes)}")
        return 0

    ensure_table_schema(conn, table, col_defs)
    upsert_dictionary(conn, table, col_defs)

    # 全量替换：清空表
    if not incremental:
        count_before = conn.execute(f'SELECT COUNT(*) FROM "{table}"').fetchone()[0]
        conn.execute(f'DELETE FROM "{table}"')
        conn.commit()
        print(f"    已清空 {count_before:,} 行（全量替换）")

    db_cols = set(get_db_columns(conn, table))
    keep_codes = [c for c in codes if c in db_cols]

    total = 0
    start_row = EXCEL_HEADER_ROWS

    while True:
        try:
            df = pd.read_excel(
                xlsx_path,
                header=None,
                skiprows=start_row,
                nrows=CHUNK_ROWS,
                dtype=str,
                names=codes,
                usecols=list(range(len(codes))),
                engine="openpyxl",
            )
        except Exception as e:
            print(f"    [错误] 读取 Excel 失败 @row={start_row}: {e}")
            break

        if df.empty:
            break

        df = df[keep_codes].copy()
        df.dropna(how="all", inplace=True)

        if df.empty:
            start_row += CHUNK_ROWS
            continue

        # 增量模式：先删除主键冲突行
        if incremental:
            delete_by_keys(conn, table, keys, df)

        try:
            df.to_sql(table, conn, if_exists="append", index=False,
                      chunksize=5000, method=None)
        except Exception as e:
            print(f"    [错误] 写入失败（跳过本块）: {e}")
            start_row += CHUNK_ROWS
            continue

        n = len(df)
        total += n
        print(f"    {table}: +{n:,} 行（累计 {total:,}）")
        start_row += CHUNK_ROWS

    conn.commit()
    return total


def main():
    args = parse_args()

    # 确定数据目录
    data_dir = args.data_dir
    if data_dir is None:
        data_dir = find_latest_data_dir(BASE_DIR)
    if data_dir is None or not data_dir.is_dir():
        print("错误：未找到数据目录，请用 --data-dir 指定。")
        sys.exit(1)

    print(f"数据库：{DB_PATH}")
    print(f"数据目录：{data_dir.name}")
    print(f"策略：{'增量覆写' if args.incremental else '全量替换'}")
    if args.dry_run:
        print("模式：dry-run（不修改数据库）")
    print()

    # 确定要更新的表
    selected = set(args.tables) if args.tables else set(TABLE_DEFS.keys())

    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute("PRAGMA cache_size=-200000")
    conn.execute("PRAGMA temp_store=MEMORY")

    # 确保 dictionary 表存在
    conn.execute("""
        CREATE TABLE IF NOT EXISTS dictionary (
            table_name TEXT NOT NULL,
            column_code TEXT NOT NULL,
            column_name_cn TEXT,
            column_desc TEXT,
            PRIMARY KEY (table_name, column_code)
        )
    """)
    conn.commit()

    results = []
    for table, (xlsx_name, des_name, keys) in TABLE_DEFS.items():
        if table not in selected:
            continue

        xlsx_path = find_file_recursive(data_dir, xlsx_name)
        des_path = find_file_recursive(data_dir, des_name)

        if xlsx_path is None or des_path is None:
            print(f"[跳过] {table}：在 {data_dir.name} 中未找到 {xlsx_name}")
            results.append((table, 0, "未找到文件"))
            continue

        print(f"[处理] {table}")
        print(f"       来源：{xlsx_path.parent.name}/{xlsx_path.name}")

        n = import_table(
            conn, table, xlsx_path, des_path, keys,
            incremental=args.incremental,
            dry_run=args.dry_run,
        )
        results.append((table, n, "成功"))
        print()

    conn.close()

    # 汇总
    print("=" * 55)
    print(f"{'表名':<22} {'导入行数':>10}  状态")
    print("-" * 55)
    for table, n, status in results:
        print(f"  {table:<20} {n:>10,}  {status}")
    print("=" * 55)

    if not args.dry_run:
        print("\n提示：如需重建分析视图，请执行：bash apply_enhancements.sh")


if __name__ == "__main__":
    main()
