def generate_zhaoshang_report(ctx: ReportContext, writer: pd.ExcelWriter, Channel_df=None) -> dict:
    """第十二部分：招商产品分析 → 写入 '招商在售产品不达基准', '封闭及定开...'"""
    yunzuogailan_all = ctx.yunzuogailan_all

    print("\n[7] 生成报表: 招商在售产品不达基准...")

    zhaoshang_product_list = list(set(Channel_df[Channel_df['渠道名称'] == '招商银行股份有限公司'].index))
    zhaoshang_product_df = yunzuogailan_all.loc[zhaoshang_product_list]
    zhaoshang_product_df['业绩基准下限'] = zhaoshang_product_df['业绩基准'].map(get_yejijizhunxiaxian)
    zhaoshang_product_df['本期年化'] = zhaoshang_product_df['本期年化'].map(
        lambda x: float(x[:-1]) / 100 if isinstance(x, str) else x
    )
    zhaoshangfinal = zhaoshang_product_df[
        (zhaoshang_product_df['本期年化'] * 100 - zhaoshang_product_df['业绩基准下限'].map(
            lambda x: float(x[:-1]) if (x != "") & (not pd.isnull(x)) else -100
        )) < 0
    ]
    zhaoshang_scale = Channel_df[Channel_df['渠道名称'] == '招商银行股份有限公司']['保有规模'] / 100000000
    zhaoshangfinal['招商代销规模'] = [zhaoshang_scale[ind] for ind in zhaoshangfinal.index]
    zhaoshangfinal = zhaoshangfinal[zhaoshangfinal['运作天'] > 30]
    zhaoshangfinal = zhaoshangfinal[zhaoshangfinal['招商代销规模'] > 0.1]
    zhaoshangfinal.sort_values('剩余天', ascending=True, inplace=True)
    zhaoshangfinal.to_excel(writer, sheet_name='招商在售产品不达基准')

    # ------------------------------------------------------------------------------
    # 报表: 封闭及定开产品100日内不达业绩产品清单
    # ------------------------------------------------------------------------------
    print("[7.1] 生成报表: 封闭及定开产品100日内不达业绩产品清单...")

    yunzuogailan_all['业绩基准下限'] = yunzuogailan_all['业绩基准'].map(get_yejijizhunxiaxian)
    yunzuogailan_all['本期年化'] = yunzuogailan_all['本期年化'].map(
        lambda x: float(x[:-1]) / 100 if isinstance(x, str) else x
    )
    yunzuogailan_all = yunzuogailan_all[
        (yunzuogailan_all['本期年化'] * 100 - yunzuogailan_all['业绩基准下限'].map(
            lambda x: float(x[:-1]) if (x != "") & (not pd.isnull(x)) else -100
        )) < 0
    ]
    bdjz_100 = yunzuogailan_all[(yunzuogailan_all['形态'].isin(['封闭', '定开'])) & (yunzuogailan_all['剩余天'] < 100)]
    bdjz_100['本期年化-业绩基准下限（BP）'] = (bdjz_100['本期年化'] - (bdjz_100['业绩基准下限'].str[:-1]).astype(float) / 100) * 10000
    bdjz_100['本期年化-业绩基准下限（BP）'] = bdjz_100['本期年化-业绩基准下限（BP）'].astype(int)
    bdjz_100 = bdjz_100[bdjz_100['母分类'] != '外币低波']
    bdjz_100.to_excel(writer, sheet_name='封闭及定开产品100日内不大业绩产品清单')


    return {}


