def get_yunzuogailan(yunzuogailan_date: str, data_loader, Product_information_df_DAP, classification_df, classification_ye, Parent_sort) -> None:
    """
    生成并保存产品运作概览数据

    参数：
        yunzuogailan_date: 运作概览日期 (YYYYMMDD格式)
    """
    print(f"\n[5.0] 生成产品运作概览数据 - {yunzuogailan_date}")

    # 加载原始数据
    yunzuogailan_before = data_loader.load_yunzuogailan_raw()
    Baoyou_df = data_loader.load_baoyou_data()

    # 匹配理财产品的字母代码
    yunzuogailan_before['母产品代码'] = yunzuogailan_before['产品简称'].map(
        lambda x: yunzuogailan_before[yunzuogailan_before['产品简称'] == x.split('(子')[0]].index[0]
    )
    yunzuogailan_before = yunzuogailan_before[~(yunzuogailan_before['单位净值'].isnull())]

    # 获取美元产品清单
    Dollar_product_list = list(
        set(Product_information_df_DAP[Product_information_df_DAP['币种'] == '美元'].index).intersection(
            yunzuogailan_before.index
        )
    )
    yunzuogailan_before['净资产(亿)'] = yunzuogailan_before.apply(
        lambda x: Baoyou_df.loc[x.name]['保有规模'].sum() / 100000000 if x.name in Dollar_product_list else x['净资产(亿)'],
        axis=1
    )
    yunzuogailan_before = yunzuogailan_before.merge(
        Product_information_df_DAP[['币种']], left_index=True, right_index=True, how='left'
    )

    # 匹配品类
    yunzuogailan_before['多资产品类'] = yunzuogailan_before['母产品代码'].map(
        lambda x: classification_ye[x] if x in classification_ye.index else np.nan
    )
    yunzuogailan_before['产品部品类'] = yunzuogailan_before['母产品代码'].map(
        lambda x: classification_df['产品部品类'][x] if x in classification_ye.index else np.nan
    )

    # 匹配产品运作周期
    patern = pd.Series(Product_information_df_DAP.apply(map_product_xingtai, axis=1), name='形态')

    # 合并保有量数据
    Baoyou_df_merge = Baoyou_df.merge(yunzuogailan_before['母产品代码'], left_index=True, right_index=True, how='left')
    yunzuogailan_before = yunzuogailan_before.merge(patern, left_index=True, right_index=True, how='left')
    yunzuogailan_before = yunzuogailan_before.merge(
        Product_information_df_DAP[['周期天数', '产品模板中文名称']],
        left_index=True, right_index=True, how='left'
    )

    # 匹配招商标签
    Zhaoshang_label_df = pd.DataFrame(
        Baoyou_df_merge.groupby('母产品代码').apply(lambda x: get_zhaoshang_label(set(x['渠道名称']))),
        columns=['是否招商']
    )
    yunzuogailan_before = yunzuogailan_before.merge(Zhaoshang_label_df, left_on='母产品代码', right_index=True, how='left')

    # 匹配渠道明细
    Qudao_label_df = pd.DataFrame(
        Baoyou_df_merge.groupby('母产品代码').apply(lambda x: get_qudao_label_detail(set(x['渠道名称']))),
        columns=['渠道明细']
    )
    yunzuogailan_before = yunzuogailan_before.merge(Qudao_label_df, left_on='母产品代码', right_index=True, how='left')

    # 特殊日期处理
    if yunzuogailan_date in ['20231229', '20231231']:
        yunzuogailan_before['产品经理'] = yunzuogailan_before.apply(
            lambda x: Product_information_df_DAP.loc[x.name, '母产品投资经理'], axis=1
        )

    yunzuogailan_before.rename(columns={'组合久期(多资产)': '组合久期'}, inplace=True)
    yunzuogailan_before.rename(columns={'组合静态(多资产)': '组合静态'}, inplace=True)

    # 合并母子标志
    yunzuogailan_before_v2 = yunzuogailan_before.merge(
        Product_information_df_DAP[['母子标志']], left_index=True, right_index=True, how='left'
    )

    # 标记主要展示产品
    yunzuogailan_before_v2['主要展示'] = yunzuogailan_before_v2.apply(
        lambda x: '是' if ((x['母子标志'] == '非母子产品') or ('(子1)' in x['产品简称'])) else '否', axis=1
    )

    # 合并母分类
    Parent_sort_full = pd.read_excel(
        Config.get_base_data_file('底层数据汇总.xlsx'),
        sheet_name='销售战报系列分类',
        index_col=0
    )[['母分类']]
    Parent_sort_full = Parent_sort_full[~Parent_sort_full.index.duplicated(keep='first')]

    # 防御性处理
    if yunzuogailan_before_v2['多资产品类'].apply(lambda x: isinstance(x, pd.Series)).any():
        print("⚠️ 检测到 '多资产品类' 列中存在 Series 值，已自动修复")
        yunzuogailan_before_v2['多资产品类'] = yunzuogailan_before_v2['多资产品类'].apply(
            lambda s: s.dropna().iloc[0] if isinstance(s, pd.Series) and len(s.dropna()) > 0 else (
                np.nan if isinstance(s, pd.Series) else s
