def generate_summary_text(ctx: ReportContext, writer: pd.ExcelWriter, results: dict) -> dict:
    """第二十一部分：总结文字（AI生成） → 写入 '总结文字'"""
    print("\n[17] 生成报表: 总结文字（AI生成）...")

    result_9 = results['result_9']
    Channel_result1 = results['Channel_result1']
    Channel_df = results['Channel_df']
    result_3 = results['result_3']
    result_df_10_2 = results['result_df_10_2']

    # 中收：组装“月度计划 + 月度/年度实际”结构化数据
    result_9_sum = result_9.sum(axis=0)
    result_9_sum_num = pd.to_numeric(result_9_sum, errors='coerce').fillna(0)
    month_prefix = f"{yunzuogailan_date[:4]}-{yunzuogailan_date[4:6]}"
    year_prefix = yunzuogailan_date[:4]

    monthly_actual_total = _safe_float(result_9_sum_num.get(f"{month_prefix}中收", 0.0))
    monthly_actual_front = _safe_float(result_9_sum_num.get(f"{month_prefix}前端收费", 0.0))
    monthly_actual_excess = _safe_float(result_9_sum_num.get(f"{month_prefix}超额管理费", 0.0))
    monthly_actual_fee = monthly_actual_total - monthly_actual_front - monthly_actual_excess

    yearly_actual_total = _safe_float(result_9_sum_num.get(f"{year_prefix}中收", 0.0))
    yearly_actual_front = _safe_float(result_9_sum_num.get(f"{year_prefix}前端收费", 0.0))
    yearly_actual_excess = _safe_float(result_9_sum_num.get(f"{year_prefix}超额管理费", 0.0))
    yearly_actual_fee = yearly_actual_total - yearly_actual_front - yearly_actual_excess

    monthly_plan_data = load_monthly_income_plan_for_department('多资产投资部')
    actual_income_data = {
        "月度实际(亿元)": {
            "中收": _round_or_none(monthly_actual_total, 6),
            "费率中收(=中收-前端-超额)": _round_or_none(monthly_actual_fee, 6),
            "前端收费": _round_or_none(monthly_actual_front, 6),
            "超额管理费": _round_or_none(monthly_actual_excess, 6),
        },
        "年度实际(亿元)": {
            "中收": _round_or_none(yearly_actual_total, 6),
            "费率中收(=中收-前端-超额)": _round_or_none(yearly_actual_fee, 6),
            "前端收费": _round_or_none(yearly_actual_front, 6),
            "超额管理费": _round_or_none(yearly_actual_excess, 6),
        }
    }
    raw_income_data = {
        str(k): _round_or_none(v, 6) for k, v in result_9_sum_num.items()
    }

    # 规模：按“渠道明细-兴业银行”口径计算行内行外
    channel_calc_data = build_channel_scale_calc_data(Channel_df)
    channel_data_raw = {
        f"{k[0]}-{k[1]}" if isinstance(k, tuple) else str(k): _round_or_none(v, 4)
        for k, v in Channel_result1.sum(axis=0).items()
    }
    series_data_raw = {
        str(k): _round_or_none(v, 4)
        for k, v in result_3.astype(float).sum(axis=0).items()
    }

    # 使用config中的prompt模板生成总结文字
    prompt_zs = Config.PROMPT_ZHONGSHOU.format(
        date=yunzuogailan_date,
        plan_data=json.dumps(monthly_plan_data, ensure_ascii=False),
        actual_data=json.dumps(actual_income_data, ensure_ascii=False),
        data=json.dumps(raw_income_data, ensure_ascii=False)
    )

    prompt_gm = Config.PROMPT_GUIMO.format(
        date=yunzuogailan_date,
        channel_calc=json.dumps(channel_calc_data, ensure_ascii=False),
        channel_data=json.dumps(channel_data_raw, ensure_ascii=False),
        series_data=json.dumps(series_data_raw, ensure_ascii=False)
    )

    daoqi_summary = Config.PROMPT_DAOQI.format(
        total=result_df_10_2['净资产(亿)'].sum(),
        fengbi=result_df_10_2[result_df_10_2['形态'] == '封闭']['净资产(亿)'].sum(),
        dingkai=result_df_10_2[result_df_10_2['形态'] == '定开']['净资产(亿)'].sum()
    )

    guimo_summary = get_wenzi_result(prompt_gm)
    zhongshou_summary = get_wenzi_result(prompt_zs)

    wenzi = {'到期文字': daoqi_summary, '中收文字': zhongshou_summary, '规模文字': guimo_summary}
    wenzidf = pd.DataFrame([wenzi]).T.rename(columns={0: '文字'})
    wenzidf.to_excel(writer, sheet_name='总结文字')

    return {}


