    keep_cols = ['产品简称', '净资产(亿)', '形态', '母分类', '多资产品类', '单位净值', '本期年化', '业绩基准', '运作天', '剩余天', '产品经理', '起息日', '到期日']
    result_df_10_2 = yunzuogailan_here[
        (yunzuogailan_here['到期日'] <= closing_date_next_w) & (yunzuogailan_here['到期日'] >= begin_date_next_w)
    ][keep_cols]
