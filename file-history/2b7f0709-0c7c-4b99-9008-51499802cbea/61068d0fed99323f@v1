def generate_pojing_report(ctx: ReportContext, writer: pd.ExcelWriter) -> dict:
    """第二十部分：破净结果 → 写入 '破净结果'"""
    data_transposition = ctx.nav_pivot

    print("\n[16] 生成报表: 破净结果...")

    nav_date = yunzuogailan_date
    if not isinstance(data_transposition.index, pd.DatetimeIndex):
        data_transposition = data_transposition.copy()
        data_transposition.index = pd.to_datetime(data_transposition.index, errors='coerce')
        data_transposition = data_transposition[~data_transposition.index.isna()]
    if not data_transposition.index.is_monotonic_increasing:
        data_transposition = data_transposition.sort_index()

    nav_dt = pd.to_datetime(nav_date)
    week_dt = nav_dt - timedelta(days=7)
    prev_month_end_dt = nav_dt.replace(day=1) - timedelta(days=1)

    def _get_nav_value(product_code: str, target_dt: pd.Timestamp):
        if product_code not in data_transposition.columns:
            return np.nan
        asof_dt = data_transposition.index.asof(target_dt)
        if pd.isna(asof_dt):
            return np.nan
        return data_transposition.at[asof_dt, product_code]

    yunzuogailan_now = del_Innovation_department(pd.read_excel(Config.get_overview_parent_file(yunzuogailan_date), index_col=0))
    yunzuogailan_now['累积净值'] = [_get_nav_value(x, nav_dt) for x in yunzuogailan_now.index]
    yunzuogailan_now['累积净值-上周'] = [_get_nav_value(x, week_dt) for x in yunzuogailan_now.index]
    yunzuogailan_now['累积净值-上月末'] = [_get_nav_value(x, prev_month_end_dt) for x in yunzuogailan_now.index]
    pojing_df = yunzuogailan_now[yunzuogailan_now['累积净值'] < 1].copy()

    pojing_df['较上周净值变化'] = pojing_df['累积净值'] / pojing_df['累积净值-上周'] - 1
    pojing_df['较上月末净值变化'] = pojing_df['累积净值'] / pojing_df['累积净值-上月末'] - 1
    pojing_df['检测时点'] = nav_date
    pojing_df['产品份额（亿份）'] = pojing_df['净资产(亿)'] / pojing_df['单位净值']
    pojing_df = pojing_df.reset_index()
    pojing_df_final = pojing_df[
        ['检测时点', '产品简称', '产品代码', '产品经理', '产品份额（亿份）', '到期日', '累积净值', '较上周净值变化', '较上月末净值变化']
    ]
    quant = ['王浩', '张雅婕', '孙新华']


    def manager_in_or_not_count(s: str, y: list):
        sum_here = 0
        for mid_y in y:
            if mid_y in s:
                sum_here += 1
        return 1 if sum_here > 0 else 0


    pojing_df_final = pojing_df_final[pojing_df_final['产品经理'].map(lambda x: manager_in_or_not_count(x, quant)) == 0]
    pojing_df_final.to_excel(writer, sheet_name='破净结果')


    return {}


