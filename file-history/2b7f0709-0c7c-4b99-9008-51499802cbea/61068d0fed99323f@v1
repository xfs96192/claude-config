    date_here = zhoubao_date[:4] + '-' + zhoubao_date[4:6] + '-' + zhoubao_date[6:]
    product_tosale_df_final = product_tosale_df_new[product_tosale_df_new['成立日'] > date_here]
    product_tosale_df_final.drop_duplicates(inplace=True)
    keep_columns = ['母子产品标识', '产品简称', '产品开放形式', '募集期(起)', '募集期(止)', '成立日', '到期日', '规模上限(亿)', '销售币种']
    product_tosale_df_final_v1 = product_tosale_df_final[keep_columns]
    
    # Simplify filtering: Remove '母产品' if they are present
    # The original logic seemed to intend to remove Mother products.
    # We will use a safer filtering approach.
    product_tosale_df_final_v2 = product_tosale_df_final_v1[product_tosale_df_final_v1['母子产品标识'] != '母产品'].copy()

    product_tosale_df_final_v2.sort_values(by='成立日', ascending=True, inplace=True)
    product_tosale_df_final_v2.to_excel(writer, sheet_name='待售产品')

    # ------------------------------------------------------------------------------
    # 报表: 新产品及分类（待售子产品 + 品类分类信息）
    # ------------------------------------------------------------------------------
    print("[3.3] 生成报表: 新产品及分类...")

    classification_df = ctx.classification_df
    Parent_sort = ctx.parent_sort

    # 以母产品代码为桥梁关联品类分类
    # product_tosale_df_final_v2 的 index 是子产品代码
    # 先取母产品代码字段（来源：product_tosale_df 原始merge中含 母产品代码，需从 Product_information_df_DAP 辅助）
    new_product_df = product_tosale_df_final_v2.copy()

    # 尝试从 DAP 产品信息表取母产品代码字段（含 '母产品代码' 列）
    dap_cols = Product_information_df_DAP.columns.tolist()
    if '母产品代码' in dap_cols:
        new_product_df = new_product_df.merge(
            Product_information_df_DAP[['母产品代码']],
            left_index=True, right_index=True, how='left'
        )
        mother_code_col = '母产品代码'
    else:
        # 若没有母产品代码列，用自身 index 作为母产品代码（适用于非子产品情况）
        new_product_df['母产品代码'] = new_product_df.index
        mother_code_col = '母产品代码'

    # 关联多资产品类 & 产品部品类（classification_df 以母产品代码为 index）
    cls_cols = [c for c in ['多资产品类', '产品部品类'] if c in classification_df.columns]
    if cls_cols:
        new_product_df = new_product_df.merge(
            classification_df[cls_cols],
            left_on=mother_code_col, right_index=True, how='left'
        )

    # 关联母分类 & 总分类（Parent_sort 以多资产品类为 index）
    if '多资产品类' in new_product_df.columns:
        ps_cols = [c for c in ['母分类', '总分类'] if c in Parent_sort.columns]
        if ps_cols:
            new_product_df = new_product_df.merge(
                Parent_sort[ps_cols],
                left_on='多资产品类', right_index=True, how='left'
            )

    # 整理列顺序：基础信息在前，分类信息紧随其后
    base_cols = ['产品简称', '产品开放形式', '募集期(起)', '募集期(止)', '成立日', '到期日', '规模上限(亿)', '销售币种']
    class_cols = ['多资产品类', '产品部品类', '母分类', '总分类']
    extra_cols = [c for c in new_product_df.columns if c not in base_cols + class_cols + ['母子产品标识', mother_code_col]]
    ordered_cols = (
        [c for c in base_cols if c in new_product_df.columns]
        + [c for c in class_cols if c in new_product_df.columns]
        + [c for c in extra_cols if c not in ['母子产品标识', mother_code_col]]
    )
    new_product_df = new_product_df[ordered_cols]
    new_product_df.sort_values(by='成立日', ascending=True, inplace=True)
    new_product_df.to_excel(writer, sheet_name='新产品及分类')
    print(f"   ✅ 新产品及分类已写入，共 {len(new_product_df)} 条记录")

    return {}


