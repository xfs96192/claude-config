# ==============================================================================

def generate_holdings_report(ctx: ReportContext, writer: pd.ExcelWriter, Chicang_df=None) -> dict:
    """第十六部分：持仓明细 → 写入 '11.×10+'"""
    Parent_sort = ctx.parent_sort
    rank_here = ctx.rank_here

    print("\n[11] 生成报表: 11.持仓明细...")

    date = zhoubao_date
    Chicang_df = ctx.data_loader.load_chicang_data(date)
    Weiwai_df = Chicang_df[Chicang_df['新版资产大类'] == '委外投资'].copy()

    # 加载运作概览数据
    yunzuogailan_now = del_Innovation_department(pd.read_excel(Config.get_overview_parent_file(date), index_col=0))

    # 11.1 兴合产品持仓明细
    print("[11.1] 生成报表: 11.兴合产品持仓明细...")
    xinghe_list = Config.XINGHE_PRODUCTS
    concat_xinghe_series = []
    for i in range(len(xinghe_list)):
        ww_asset = '兴业期货-' + xinghe_list[i] + '集合资产管理计划'
        concat_xinghe_series.append(pd.Series(
            Weiwai_df[Weiwai_df['债券简称'] == ww_asset].groupby('产品代码')['日终市值(元)-产品法估值'].sum() / 100000000,
            name=xinghe_list[i] + '-金额'
        ))

    concat_xinghe_df = pd.concat(concat_xinghe_series, axis=1)
    concat_xinghe_df = concat_xinghe_df.merge(
        yunzuogailan_now[['产品简称', '产品经理', '净资产(亿)', '多资产品类']],
        left_index=True, right_index=True, how='left'
    )
    concat_xinghe_pct_df = concat_xinghe_df[[x + '-金额' for x in xinghe_list]].div(concat_xinghe_df['净资产(亿)'], axis=0)
    concat_xinghe_pct_df.columns = [x + '-占比' for x in xinghe_list]
    result_df_11_1 = pd.concat([
        concat_xinghe_df[[x + '-金额' for x in xinghe_list] + ['产品简称', '产品经理', '多资产品类']],
        concat_xinghe_pct_df
    ], axis=1)
    result_df_11_1.to_excel(writer, sheet_name='11.兴合产品持仓明细')

    # 11.1.1 可转债专户持仓明细
    print("[11.1.1] 生成报表: 11.1 可转债专户持仓明细...")
    concat_zhuanzhai_series = []
    zhuanzhai_dict = Config.CONVERTIBLE_BOND_ACCOUNTS
    zhuanzhai_list = []
    for shortname in zhuanzhai_dict.keys():
        concat_zhuanzhai_series.append(pd.Series(
            Weiwai_df[Weiwai_df['债券简称'] == zhuanzhai_dict[shortname]].groupby('产品代码')['日终市值(元)-产品法估值'].sum() / 100000000,
            name=shortname + '-金额'
        ))
        zhuanzhai_list += [shortname]

    ETF_bond_list = Config.CONVERTIBLE_BOND_ETF
    concat_zhuanzhai_series.append(pd.Series(
        Chicang_df[Chicang_df['债券简称'].apply(lambda x: x in ETF_bond_list)].groupby('产品代码')['日终市值(元)-产品法估值'].sum() / 100000000,
        name='可转债ETF-金额'
    ))
    zhuanzhai_list += ['可转债ETF']

    concat_zhuanzhai_df = pd.concat(concat_zhuanzhai_series, axis=1)
    concat_zhuanzhai_df = concat_zhuanzhai_df.merge(
        yunzuogailan_now[['产品简称', '产品经理', '净资产(亿)', '多资产品类']],
        left_index=True, right_index=True, how='left'
    )
    concat_zhuanzhai_pct_df = concat_zhuanzhai_df[[x + '-金额' for x in zhuanzhai_list]].div(
        concat_zhuanzhai_df['净资产(亿)'], axis=0
    )
    concat_zhuanzhai_pct_df.columns = [x + '-占比' for x in zhuanzhai_list]
    result_df_11_1_1 = pd.concat([
        concat_zhuanzhai_df[[x + '-金额' for x in zhuanzhai_list] + ['产品简称', '产品经理', '多资产品类']],
        concat_zhuanzhai_pct_df
    ], axis=1)
