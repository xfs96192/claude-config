def generate_fee_report(ctx: ReportContext, writer: pd.ExcelWriter) -> dict:
    """第十四部分：中收监控 → 写入 '9.中收监控'"""
    classification_df = ctx.classification_df
    Parent_sort = ctx.parent_sort
    rank_here = ctx.rank_here

    print("\n[9] 生成报表: 9.中收监控...")

    date = zhoubao_date
    zhongshou_m, zhongshou_y = ctx.data_loader.load_zhongshou_data(date)


    def zhongshou_df_processing_v2(df_here, period_here: str):
        """处理中收数据"""
        fixed_cols = ['产品简称', '产品经理', '投资团队', '团队划分', '产品线']
        df_here.columns = fixed_cols + list(df_here.columns[5:])
        df_here = df_here[df_here['团队划分'] == '5.多资产投资部']
        df_here.columns = [''.join(x.split('\n')) for x in df_here.columns]
        zhongshou_cols = ['销售管理费（扣减代销）', '投资管理费', '超额管理费（代客系统）', '中收（扣减代销）', '当年行内前端销售管理费']
        df_here = df_here[fixed_cols + zhongshou_cols]
        df_here = df_here[df_here['中收（扣减代销）'].map(lambda x: x > 0.00001)]
        df_here = df_here.merge(classification_df[['多资产品类']], left_index=True, right_index=True, how='left')
        df_here = del_Innovation_department(df_here)
        df_here = df_here.merge(Parent_sort, left_on='多资产品类', right_index=True, how='left')
        mid_result = df_here.groupby(['总分类', '母分类']).sum()[
            ['中收（扣减代销）', '销售管理费（扣减代销）', '投资管理费', '超额管理费（代客系统）', '当年行内前端销售管理费']
        ]
        mid_cols = [period_here + x for x in ['中收', '销售管理费', '投资管理费(含超额)', '超额管理费', '前端收费']]
        mid_result.columns = mid_cols
        return mid_result


    result_9 = pd.concat([
        zhongshou_df_processing_v2(zhongshou_m, '-'.join([date[:4], date[4:6]])),
        zhongshou_df_processing_v2(zhongshou_y, date[:4])
    ], axis=1)
    result_9 = rank_by_sort(result_9, rank_here)
    result_9.to_excel(writer, sheet_name='9.中收监控')


    return {'result_9': result_9}


