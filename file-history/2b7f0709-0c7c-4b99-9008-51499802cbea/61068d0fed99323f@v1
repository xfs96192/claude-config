def get_wenzi_result(prompt: str, max_retries: int = 3, retry_delay: float = 5.0) -> str:
    """调用DeepSeek API生成文字，失败时自动重试"""
    client = OpenAI(api_key=Config.DEEPSEEK_API_KEY, base_url=Config.DEEPSEEK_BASE_URL)
    last_exc = None
    for attempt in range(1, max_retries + 1):
        try:
            response = client.chat.completions.create(
                model=Config.DEEPSEEK_MODEL,
                messages=[
                    {"role": "system", "content": "You are a helpful assistant"},
                    {"role": "user", "content": prompt},
                ],
                stream=False
            )
            return response.choices[0].message.content
        except Exception as exc:
            last_exc = exc
            print(f"⚠️ DeepSeek API 调用失败 (第{attempt}/{max_retries}次): {type(exc).__name__}: {exc}")
            if attempt < max_retries:
                print(f"   {retry_delay:.0f} 秒后重试...")
                time.sleep(retry_delay)
    raise last_exc


def rank_by_sort(my_df: pd.DataFrame, rank_def: list) -> pd.DataFrame:
    """按指定顺序对DataFrame索引排序"""
    my_df = my_df.copy()
    actual = list(my_df.index)
    new_order = [x for x in rank_def if x in actual] + [x for x in actual if x not in rank_def]
    order_map = {val: i for i, val in enumerate(new_order)}
    my_df['__order__'] = my_df.index.map(order_map).fillna(len(new_order))
    my_df = my_df.sort_values('__order__').drop(columns='__order__')
    return my_df


def full_category_or_not(df_def: pd.DataFrame, rank_def: list) -> pd.DataFrame:
    """判断品类Index是否齐全，补充缺失的品类"""
    df_def = df_def.copy()
    for x in rank_def:
        if x not in df_def.index:
            df_def.loc[x, :] = None
    return df_def


def _safe_float(value, default=0.0) -> float:
    """将值安全转换为float"""
    v = pd.to_numeric(value, errors='coerce')
    return default if pd.isna(v) else float(v)


def _round_or_none(value, digits=2):
    """数值四舍五入，NaN返回None（便于JSON输出）"""
    if pd.isna(value):
        return None
    return round(float(value), digits)


def load_monthly_income_plan_for_department(department_name: str = '多资产投资部') -> dict:
    """从月度中收计划文件读取指定部门计划值"""
    plan_file = Config.get_latest_monthly_income_plan_file()
    default_result = {
        "计划文件": None,
        "部门": department_name,
        "计划月份": None,
        "月度中收计划(亿元)": None,
        "月度费率中收计划(亿元)": None,
        "月度前端收费计划(亿元)": None,
        "月度超额管理费计划(亿元)": None,
    }

    if not plan_file:
        default_result["备注"] = "未找到月度中收计划文件"
        return default_result

    try:
        raw_df = pd.read_excel(plan_file, sheet_name=0, header=None)
    except Exception as e:
        default_result["计划文件"] = os.path.basename(plan_file)
        default_result["备注"] = f"读取月度中收计划文件失败: {e}"
        return default_result

    row_mask = raw_df.apply(
        lambda row: row.astype(str).str.contains(department_name, na=False).any(),
        axis=1
    )
    if not row_mask.any():
        default_result["计划文件"] = os.path.basename(plan_file)
        default_result["备注"] = f"未找到部门: {department_name}"
        return default_result

    row = raw_df[row_mask].iloc[0]
    header_text = str(raw_df.iloc[0, 1]) if raw_df.shape[1] > 1 else ""
    month_match = re.search(r'(\d+月)', header_text)
    month_label = month_match.group(1) if month_match else header_text

    plan_total = _safe_float(row.iloc[3], default=np.nan) if len(row) > 3 else np.nan
    plan_fee = _safe_float(row.iloc[4], default=np.nan) if len(row) > 4 else np.nan
    plan_front = _safe_float(row.iloc[5], default=0.0) if len(row) > 5 else 0.0
    plan_excess = _safe_float(row.iloc[6], default=0.0) if len(row) > 6 else 0.0

    if pd.isna(plan_fee):
        plan_fee = plan_total - plan_front - plan_excess

    return {
        "计划文件": os.path.basename(plan_file),
        "部门": department_name,
        "计划月份": month_label,
        "月度中收计划(亿元)": _round_or_none(plan_total, 6),
        "月度费率中收计划(亿元)": _round_or_none(plan_fee, 6),
        "月度前端收费计划(亿元)": _round_or_none(plan_front, 6),
        "月度超额管理费计划(亿元)": _round_or_none(plan_excess, 6),
    }


def build_channel_scale_calc_data(channel_df: pd.DataFrame) -> dict:
    """基于渠道明细口径，计算行内/行外/总规模当前值与对比值"""
    if channel_df is None or channel_df.empty:
        return {"备注": "缺少渠道数据，无法计算行内行外口径"}

    df = channel_df.copy()
    if '渠道名称' not in df.columns or '保有规模' not in df.columns:
        return {"备注": "渠道数据缺少必要字段: 渠道名称/保有规模"}

    df = df[df['渠道名称'] != '-']
    now_series = df.groupby('渠道名称')['保有规模'].sum() / 100000000

    inner_now = _safe_float(now_series.get('兴业银行', np.nan), default=np.nan)
    total_now = _safe_float(now_series.sum(), default=np.nan)
    outer_now = total_now - inner_now if not pd.isna(total_now) and not pd.isna(inner_now) else np.nan

    lastm_s = read_comparison_channel_data(Config.get_output_result_file(lastm))
    lasty_s = read_comparison_channel_data(Config.get_output_result_file(lasty))

    inner_lastm = _safe_float(lastm_s.get('兴业银行', np.nan), default=np.nan) if len(lastm_s) else np.nan
    total_lastm = _safe_float(lastm_s.sum(), default=np.nan) if len(lastm_s) else np.nan
    outer_lastm = total_lastm - inner_lastm if not pd.isna(total_lastm) and not pd.isna(inner_lastm) else np.nan

    inner_lasty = _safe_float(lasty_s.get('兴业银行', np.nan), default=np.nan) if len(lasty_s) else np.nan
    total_lasty = _safe_float(lasty_s.sum(), default=np.nan) if len(lasty_s) else np.nan
    outer_lasty = total_lasty - inner_lasty if not pd.isna(total_lasty) and not pd.isna(inner_lasty) else np.nan

    total_change_lastm = total_now - total_lastm if not pd.isna(total_now) and not pd.isna(total_lastm) else np.nan
    inner_change_lastm = inner_now - inner_lastm if not pd.isna(inner_now) and not pd.isna(inner_lastm) else np.nan
    outer_change_lastm = outer_now - outer_lastm if not pd.isna(outer_now) and not pd.isna(outer_lastm) else np.nan

    total_change_lasty = total_now - total_lasty if not pd.isna(total_now) and not pd.isna(total_lasty) else np.nan
    inner_change_lasty = inner_now - inner_lasty if not pd.isna(inner_now) and not pd.isna(inner_lasty) else np.nan
    outer_change_lasty = outer_now - outer_lasty if not pd.isna(outer_now) and not pd.isna(outer_lasty) else np.nan

    return {
        "口径说明": [
            "行内=兴业银行渠道余额",
            "行外=总规模-行内",
            "上月底余额=当前余额-较上月底变化",
            "行外较上月底变化=总规模较上月底变化-行内较上月底变化",
            "当前/上月底/去年底均要求行内+行外=总规模"
        ],
        "总规模(亿元)": {
            "当前余额": _round_or_none(total_now, 2),
            "上月底余额": _round_or_none(total_lastm, 2),
            "较上月底变化": _round_or_none(total_change_lastm, 2),
            "去年底余额": _round_or_none(total_lasty, 2),
            "较去年底变化": _round_or_none(total_change_lasty, 2),
        },
        "行内(亿元)": {
            "当前余额": _round_or_none(inner_now, 2),
            "上月底余额": _round_or_none(inner_lastm, 2),
            "较上月底变化": _round_or_none(inner_change_lastm, 2),
            "去年底余额": _round_or_none(inner_lasty, 2),
            "较去年底变化": _round_or_none(inner_change_lasty, 2),
        },
        "行外(亿元)": {
            "当前余额": _round_or_none(outer_now, 2),
            "上月底余额": _round_or_none(outer_lastm, 2),
            "较上月底变化": _round_or_none(outer_change_lastm, 2),
            "去年底余额": _round_or_none(outer_lasty, 2),
            "较去年底变化": _round_or_none(outer_change_lasty, 2),
        },
    }


def manager_in_or_not(s: str, y: list) -> bool:
    """判断投资经理是否在指定列表中"""
    if pd.isnull(s):
        return False
    for mid_y in y:
        if mid_y in s:
            return True
    return False


def clear_manager_name(s: str) -> str:
    """清理投资经理名称，只保留部门内经理"""
    first = ['徐莹', '胡艳婷', '姜锡峰', '朱轶伦', '李佳航', "苏文津", "夏凡盛", "黄亦尧"]
    second = ['严泓', '高翰昆', '薛纪晔', '任雁', '周仕盈', "罗谨深"]
    third = ['杨漠', '余洁雅', '张玉杰', '廖炯臣']
    merge_s = []
    for mid_s in s.split(','):
        if mid_s in first + second + third:
            merge_s.append(mid_s)
    return ','.join(merge_s)


def adjust_manager_aum(mid_data: pd.DataFrame) -> pd.DataFrame:
    """调整多投资经理共管产品的规模分配"""
    final_mid_data = mid_data.copy()
    final_mid_data['双挂调整后规模'] = final_mid_data['净资产(亿)']
    final_mid_data['双挂调整后产品只数'] = 1

    new_rows = []
    for indx in mid_data.index:
        mng_list = mid_data.loc[indx, '产品经理'].split(',')
        if len(mng_list) > 1:
            i = 0
            for mng in mng_list:
                if i == 0:
                    final_mid_data.loc[indx, '产品经理'] = mng
                    final_mid_data.loc[indx, '双挂调整后规模'] = final_mid_data.loc[indx, '双挂调整后规模'] / 2
                    final_mid_data.loc[indx, '双挂调整后产品只数'] = 1 / len(mng_list)
                    i += 1
                else:
                    mid_series = final_mid_data.loc[indx].copy()
                    mid_series['产品经理'] = mng
                    new_rows.append(pd.DataFrame(mid_series).T)

    if new_rows:
        final_mid_data = pd.concat([final_mid_data] + new_rows, ignore_index=False)

    return final_mid_data


def get_scaleandnum_by_sort_manager(my_df: pd.DataFrame, data_loader=None) -> pd.DataFrame:
