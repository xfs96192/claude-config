    Parent_sort = ctx.parent_sort
    rank_here = ctx.rank_here

    print("\n[10] 生成报表: 10.产品到期情况...")

    date = zhoubao_date
    yunzuogailan_now = del_Innovation_department(pd.read_excel(Config.get_overview_parent_file(date), index_col=0))
    yunzuogailan_now['到期月份'] = yunzuogailan_now['到期日'].map(lambda x: x[:-3])
    yunzuogailan_here = yunzuogailan_now.merge(Parent_sort[['总分类']], left_on='多资产品类', right_index=True, how='left')
    yunzuogailan_here = yunzuogailan_here[yunzuogailan_here['到期日'] >= begin_date_next_w]

    yunzuogailan_here_fengbi = yunzuogailan_here[yunzuogailan_here['形态'] == '封闭']
    yunzuogailan_here_dingkai = yunzuogailan_here[yunzuogailan_here['形态'] == '定开']
    output_sheetname = ['10.未来全年产品到期情况', '10.未来全年产品到期情况-定开']

    k = 0
    for yunzuogailan_here_to_cal in [yunzuogailan_here_fengbi, yunzuogailan_here_dingkai]:
