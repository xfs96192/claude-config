def generate_asset_table(ctx: ReportContext, writer: pd.ExcelWriter) -> dict:
    """第十三部分：资产大表 → 写入 '8.资产大表'"""
    Parent_sort = ctx.parent_sort

    print("\n[8] 生成报表: 8.资产大表...")

    date = zhoubao_date
    date_lastw = lastw
    date_lastm = lastm
    date_lasty = lasty

    yunzuogailan_all = pd.read_excel(Config.get_overview_history_file(date), index_col=0)
    Chicang_df = ctx.data_loader.load_chicang_data(date)
    Chicang_df = Chicang_df.merge(yunzuogailan_all['币种'], left_on='产品代码', right_index=True, how='left')

    # 美元产品转换汇率
    EXchange_rate = ctx.market_data.get_exchange_rate('USDCNY', Config.EXCHANGE_RATE_DATE)
    if EXchange_rate is None:
        # iChoice无USDCNY.IB权限时用备用兑率
        fallback = getattr(Config, 'FALLBACK_EXCHANGE_RATE', 7.19)
        print(f"  ⚠️  汇率获取失败！使用config中的备用兑率: {fallback}")
        print(f"      请在 config.py 中确认 FALLBACK_EXCHANGE_RATE 值与市场相符!")
        print(f"      当前iChoice账户对 USDCNY.IB CLOSE字段无数据权限，请联系iChoice开通")
        EXchange_rate = fallback
    Chicang_df['日终市值(元)-产品法估值'] = Chicang_df.apply(
        lambda x: x['日终市值(元)-产品法估值'] * EXchange_rate if x['币种'] == '美元' else x['日终市值(元)-产品法估值'],
        axis=1
    )

    # 处理特殊基金类型
    to_fill_indx = Chicang_df[Chicang_df['日终市值(元)-产品法估值'] == 0].index
    Chicang_df.loc[to_fill_indx, '日终市值(元)-产品法估值'] = Chicang_df.loc[to_fill_indx, '持仓成本(元)'] + Chicang_df.loc[to_fill_indx, '持有期收益']
    Chicang_df['日终市值(元)-产品法估值'] = Chicang_df['日终市值(元)-产品法估值'].fillna(0)

    # 加载资产分类数据
    asset_classification_joint_df = ctx.data_loader.load_asset_classification()
    insurance_pdct_df = ctx.data_loader.load_insurance_products()

    # 匹配资产小类和勾稽关系
    Chicang_df = Chicang_df.merge(
        asset_classification_joint_df[['编号', '三级分类']], left_on='新版资产小类', right_index=True, how='left'
    )

    # 标记保险资管资产
    mid_df = Chicang_df[Chicang_df['新版资产小类'] == '委外现金管理投资']
    insurance_pdct_name_list = list(insurance_pdct_df.index) + ['英大资产-聚鑫22号', '大家资管稳健精选15号']
    insurance_pdct_indx = mid_df[mid_df['债券简称'].map(lambda x: x in insurance_pdct_name_list)].index
    Chicang_df.loc[insurance_pdct_indx, '编号'] = '1.2'
    Chicang_df.loc[insurance_pdct_indx, '三级分类'] = '1.2 保险协议存款'

    # 细化城投和永续债分类
    bond_set_df = pd.DataFrame(list(set(Chicang_df[Chicang_df['编号'] == '3.4-3.5']['外部代码'])), columns=['外部代码'])
    bond_code_list = list(bond_set_df['外部代码'].values)
    wind_result = ctx.market_data.get_bond_attributes(bond_code_list)
    bond_set_df[['是否城投', '是否永续']] = wind_result.values

    to_merge_df = pd.DataFrame([
        ['是', '否', '3.4.1 非永续城投债'], ['是', '是', '3.4.2 永续城投债'],
        ['否', '否', '3.5.1 非永续产业债'], ['否', '是', '3.5.2 永续产业债']
    ], columns=['是否城投', '是否永续', '三级分类'])
    bond_set_df = bond_set_df.merge(to_merge_df, left_on=['是否城投', '是否永续'], right_on=['是否城投', '是否永续'], how='left')

    Chicang_df['三级分类-new'] = Chicang_df.apply(
        lambda x: bond_set_df.set_index('外部代码').loc[x['外部代码'], '三级分类'] if x['编号'] == '3.4-3.5' else x['三级分类'],
        axis=1
    )

    # 匹配多资产品类
    yunzuogailan_now = pd.read_excel(Config.get_overview_parent_file(date), index_col=0)
    Chicang_df2 = Chicang_df.merge(yunzuogailan_now[['多资产品类', '产品经理']], left_on='产品代码', right_index=True, how='left')
    Chicang_df2 = Chicang_df2[Chicang_df2.apply(lambda x: not pd.isnull(x['产品经理']), axis=1)]
    Chicang_df2 = del_Innovation_department(Chicang_df2)
    Chicang_df2 = Chicang_df2.merge(Parent_sort, left_on='多资产品类', right_index=True, how='left')

    result_df_8_initial = pd.pivot_table(
        Chicang_df2, index=['三级分类-new'], columns=['总分类', '母分类'],
        values=['日终市值(元)-产品法估值'], aggfunc=np.sum
    ) / 100000000

    # 细化委外债券投资子项
    Outsourced_bond_asset_df = Chicang_df2[Chicang_df2['三级分类'] == '7.2 委外债券投资']
    public_account_tag_df = ctx.data_loader.load_public_account_tag()
    Outsourced_bond_asset_df_new = Outsourced_bond_asset_df.merge(public_account_tag_df, left_on='债券简称', right_index=True, how='left')

    Outsourced_bond_tag = {
        '收盘价法': '7.2.1 收盘价专户', '利率债收盘价': '7.2.2 利率债收盘价专户',
        '模型法': '7.2.3 模型法专户', '可转债': '7.2.4 可转债专户',
        '恒定久期': '7.2.5 恒定久期专户', '固收+委外': '7.2.6 固收+委外专户',
        'W专户': '7.2.7 W专户', '绿色债': '7.2.8 绿色债专户', '外币专户': '7.2.9 外币专户',
    }
    Outsourced_bond_asset_df_new['四级分类'] = Outsourced_bond_asset_df_new['标签'].map(
        lambda x: Outsourced_bond_tag[x] if x in Outsourced_bond_tag.keys() else '7.2.10 其他'
    )
    Outsourced_bond_asset_result = pd.pivot_table(
        Outsourced_bond_asset_df_new, index=['四级分类'], columns=['总分类', '母分类'],
        values=['日终市值(元)-产品法估值'], aggfunc=np.sum
    ) / 100000000

    result_df_8 = pd.concat([result_df_8_initial.rename_axis(''), Outsourced_bond_asset_result.rename_axis('')])
    result_df_8.to_excel(Config.get_asset_table_file(date))

    # 计算同比环比变化
    result_df_lastw = pd.read_excel(Config.get_asset_table_file(date_lastw), index_col=0, header=[0, 1, 2])
    result_df_lastm = pd.read_excel(Config.get_asset_table_file(lastm), index_col=0, header=[0, 1, 2])
    result_df_lasty = pd.read_excel(Config.get_asset_table_file(lasty), index_col=0, header=[0, 1, 2])

    result_df_8_final = pd.concat([
        result_df_8, result_df_8.sum(axis=1) - result_df_lastw.sum(axis=1),
        result_df_8.sum(axis=1) - result_df_lastm.sum(axis=1),
        result_df_8.sum(axis=1) - result_df_lasty.sum(axis=1)
    ], axis=1)

    # 补充本币的相比变化
    foreign_currency_products_cols = [
        ('日终市值(元)-产品法估值', '外币产品', '外币低波'),
        ('日终市值(元)-产品法估值', '外币产品', '外币市值')
    ]
    all_columns_8 = list(result_df_8.columns)
    domestic_columns_8 = [col for col in all_columns_8 if col not in foreign_currency_products_cols]
    all_columns_lastw = list(result_df_lastw.columns)
    domestic_columns_lastw = [col for col in all_columns_lastw if col not in foreign_currency_products_cols]
    all_columns_lastm = list(result_df_lastm.columns)
    domestic_columns_lastm = [col for col in all_columns_lastm if col not in foreign_currency_products_cols]
    all_columns_lasty = list(result_df_lasty.columns)
    domestic_columns_lasty = [col for col in all_columns_lasty if col not in foreign_currency_products_cols]

    result_df_8_domestic_currency = result_df_8[domestic_columns_8].sum(axis=1)
    result_df_lastw_domestic_currency = result_df_lastw[domestic_columns_lastw].sum(axis=1)
    result_df_lastm_domestic_currency = result_df_lastm[domestic_columns_lastm].sum(axis=1)
    result_df_lasty_domestic_currency = result_df_lasty[domestic_columns_lasty].sum(axis=1)

    result_df_8_final = pd.concat([
        result_df_8_final,
        result_df_8_domestic_currency - result_df_lastw_domestic_currency,
        result_df_8_domestic_currency - result_df_lastm_domestic_currency,
        result_df_8_domestic_currency - result_df_lasty_domestic_currency
    ], axis=1)

    result_df_8_final.columns = pd.MultiIndex.from_tuples(
        tuple(result_df_8.columns) + (
            ("", "", '相比上周'), ("", "", '相比上月'), ("", "", '相比上年'),
            ("", "", '相比上周-不含外币产品'), ("", "", '相比上月-不含外币产品'), ("", "", '相比上年-不含外币产品')
        )
    )
    result_df_8_final.to_excel(writer, sheet_name='8.资产大表')


    return {'Chicang_df': Chicang_df}


