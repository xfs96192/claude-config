def get_zhouqi_scale(x: int) -> str:
    """根据周期天数返回周期区间标签"""
    if x < 30 * 7:
        return '<6M'
    elif (x >= 30 * 7) and (x < 13 * 30):
        return '6M-1Y'
    elif x >= 13 * 30:
        return '>1Y'
    else:
        return 'error'


def get_zhouqi_scale_v2(x: int) -> str:
    """根据周期天数返回周期区间标签（详细版）"""
    if x == 1:
        return '日盈'
    elif x < 30:
        return '<1M'
    elif x < 31 * 3:
        return '1M-3M'
    elif x < 31 * 6:
        return '3M-6M'
    elif x < 12 * 31:
        return '6M-1Y'
    elif x >= 12 * 31:
        return '>1Y'
    else:
        return 'error'


def safe_read_excel(file_path: str, **kwargs) -> pd.DataFrame:
    """
    安全读取Excel文件，如果文件不存在或为空则返回空DataFrame
    """
    try:
        if not os.path.exists(file_path):
            print(f"⚠️ 文件不存在: {file_path}")
            return pd.DataFrame()
        
        # 检查文件大小
        if os.path.getsize(file_path) == 0:
            print(f"⚠️ 文件为空: {file_path}")
            return pd.DataFrame()
            
        return pd.read_excel(file_path, **kwargs)
    except Exception as e:
        print(f"⚠️ 读取文件出错: {file_path}, 错误: {e}")
        return pd.DataFrame()

