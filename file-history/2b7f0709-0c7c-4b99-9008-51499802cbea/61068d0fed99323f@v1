def generate_volatility_report(ctx: ReportContext, writer: pd.ExcelWriter) -> dict:
    """第十七部分：周净值高波动 → 写入 '12.周净值高波动产品清单'"""
    data_transposition = ctx.nav_pivot

    print("\n[12] 生成报表: 12.周净值高波动产品清单...")

    date = zhoubao_date
    yunzuogailan_now = del_Innovation_department(pd.read_excel(Config.get_overview_parent_file(date), index_col=0))
    part_nav_df = data_transposition.loc[:, yunzuogailan_now.index].tail(7 + 1)
    rweek = pd.DataFrame(
        (part_nav_df.tail(1).values / part_nav_df.head(1).values - 1) * 10000,
        columns=part_nav_df.columns, index=['周净值变化bp']
    ).T
    rweek_average = ((part_nav_df / part_nav_df.shift(1) - 1) * 10000).mean(axis=0)
    nav_change_df = pd.concat([rweek, rweek_average], axis=1)
    nav_change_df.columns = ['周净值变化bp', '周内日均净值变化bp']
    nav_change_df_keep = nav_change_df[
        (abs(nav_change_df['周净值变化bp']) >= 20) | (abs(nav_change_df['周内日均净值变化bp']) >= 3)
    ]

    result_df_12 = nav_change_df_keep.merge(
        yunzuogailan_now[['产品简称', '净资产(亿)', '形态', '多资产品类', '单位净值', '累计年化', '杠杆',
                          '组合久期', '组合静态', '权益仓位', '本期年化', '业绩基准', '运作天', '剩余天',
                          '产品经理', '起息日', '到期日']],
        left_index=True, right_index=True, how='left'
    )
    result_df_12.sort_values('周内日均净值变化bp', ascending=True, inplace=True)
    result_df_12.to_excel(writer, sheet_name='12.周净值高波动产品清单')


    return {}


