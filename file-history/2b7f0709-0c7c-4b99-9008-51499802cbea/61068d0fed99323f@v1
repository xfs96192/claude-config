    result_df_10_2.to_excel(writer, sheet_name='10.下周到期产品清单')

    print('   下周合计到期规模{:.2f}亿元'.format(result_df_10_2['净资产(亿)'].sum()))
    print('   封闭合计到期规模{:.2f}亿元'.format(result_df_10_2[result_df_10_2['形态'] == '封闭']['净资产(亿)'].sum()))
    print('   定开合计到期规模{:.2f}亿元'.format(result_df_10_2[result_df_10_2['形态'] == '定开']['净资产(亿)'].sum()))


    return {'result_df_10_2': result_df_10_2}


