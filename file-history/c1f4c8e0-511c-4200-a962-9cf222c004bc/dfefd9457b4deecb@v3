def fetch_convertible_metric(code, candidates, start, end):
    """按候选字段依次尝试获取中证转债相关指标"""
    for field, label in candidates:
        try:
            d = c.csd(code, field, start, end, "Ispandas=1")
            if isinstance(d, pd.DataFrame) and field in d.columns:
                s = parse_csd_to_series(d, code, col=field)
                if len(s.dropna()) > 0:
                    print(f"  ✅ {label}({field}): {len(s.dropna())} 个数据点")
                    return s.resample('W').last()
        except Exception:
            pass
    return pd.Series(dtype=float)


# ==================== 计算函数 ====================

def calc_equity_bond_ratio(pe, bond_yield_pct):
    if pd.isna(pe) or pe <= 0 or pd.isna(bond_yield_pct):
        return np.nan
    return (1 / pe) - (bond_yield_pct / 100)


def calc_credit_spread(credit_yield, treasury_yield):
    if pd.isna(credit_yield) or pd.isna(treasury_yield):
        return np.nan
    return (credit_yield - treasury_yield) * 100


def calc_term_spread(long_yield, short_yield):
    if pd.isna(long_yield) or pd.isna(short_yield):
        return np.nan
    return (long_yield - short_yield) * 100


def calc_china_us_spread(cn_yield, us_yield):
    return calc_credit_spread(cn_yield, us_yield)


def calc_fx_hedging_cost(swap_points, cnh_rate):
    if pd.isna(swap_points) or pd.isna(cnh_rate) or cnh_rate == 0:
        return np.nan
    return -swap_points / 10000 / cnh_rate


def fetch_swap_1y_proxy(bond_yields, weekly_data):
    """
    用利率平价公式构建 1Y USD/CNY 掉期点代理历史序列：
        proxy_pips = (CN_1Y - US_1Y) / 100 × CNH_spot × 10000
    再用 AKShare fx_swap_quote() 获取今天实际值，按比例缩放校正。
    """
    if bond_yields is None or weekly_data is None:
        return pd.Series(name="掉期点1Y", dtype=float)

    cn_1y = bond_yields.get('中债国开债1年', pd.Series(dtype=float))
    us_1y = bond_yields.get('美国1年国债', pd.Series(dtype=float))
    cnh = weekly_data['离岸人民币CNH'] if '离岸人民币CNH' in weekly_data.columns else pd.Series(dtype=float)

    combined = pd.concat([cn_1y.rename('cn'), us_1y.rename('us'), cnh.rename('cnh')], axis=1).dropna()
    if combined.empty:
        print("  ⚠️  掉期点1Y代理: 缺少基础数据，跳过")
        return pd.Series(name="掉期点1Y", dtype=float)

    proxy = (combined['cn'] - combined['us']) / 100 * combined['cnh'] * 10000

    # 用 AKShare 获取今天实际中间价，缩放校正
    try:
        import akshare as ak
        df_quote = ak.fx_swap_quote()
        row = df_quote[df_quote['货币对'] == 'USD/CNY'].iloc[0]
        bid_str, ask_str = str(row['1年']).split('/')
        actual_today = (float(bid_str) + float(ask_str)) / 2

        proxy_latest = proxy.iloc[-1]
        if proxy_latest != 0:
            scale = actual_today / proxy_latest
            proxy_scaled = proxy * scale
            print(f"  掉期点1Y(AKShare): 实际={actual_today:.0f}pips, 代理={proxy_latest:.0f}pips, 缩放={scale:.3f}")
        else:
            proxy_scaled = proxy
            print(f"  掉期点1Y(AKShare): 实际={actual_today:.0f}pips, 代理为0，不缩放")
        proxy_scaled.name = "掉期点1Y"
        return proxy_scaled
    except Exception as e:
        print(f"  ⚠️  AKShare获取掉期点失败: {e}，使用未校正代理值")
        proxy.name = "掉期点1Y"
        return proxy


def calc_gold_price_diff(shfe_gold, comex_gold_usd, usdcny):
    """沪金内外盘价差: 沪金(元/克) - COMEX(USD/oz)*USDCNY/31.1035"""
    if pd.isna(shfe_gold) or pd.isna(comex_gold_usd) or pd.isna(usdcny) or usdcny == 0:
        return np.nan
    return shfe_gold - comex_gold_usd * usdcny / 31.1035


def calc_rebar_coil_spread(coil, rebar):
    if pd.isna(coil) or pd.isna(rebar):
        return np.nan
    return coil - rebar


def calc_wti_brent_spread(wti, brent):
    if pd.isna(wti) or pd.isna(brent):
        return np.nan
    return wti - brent


def calc_futures_spot_spread(futures, spot):
    if pd.isna(futures) or pd.isna(spot):
        return np.nan
    return futures - spot


def calc_percentile(series, value, reverse=False):
    if pd.isna(value):
        return np.nan
    valid = series.dropna()
    if len(valid) == 0:
        return np.nan
    pct = (valid < value).sum() / len(valid)
    return 1 - pct if reverse else pct


