            combined = df[[cnh_col]].join(rate_df, how='left').ffill()
            # 利率平价代理掉期点
            proxy_pips = (combined['中国国债收益率2年'] - combined['美国国债收益率2年']) / 100 * combined[cnh_col] * 10000

            # 用 AKShare 实际值缩放
            quote_df = ak.fx_swap_quote()
            row_q = quote_df[quote_df['货币对'] == 'USD/CNY'].iloc[0]
            bid_s, ask_s = str(row_q['1年']).split('/')
            actual_today = (float(bid_s) + float(ask_s)) / 2

            proxy_latest = proxy_pips.dropna().iloc[-1] if len(proxy_pips.dropna()) > 0 else 0
            scale = actual_today / proxy_latest if proxy_latest != 0 else 1.0
            scaled_pips = proxy_pips * scale

            # 锁汇成本 = -掉期点 / 10000 / CNH
            df['锁汇成本'] = (-scaled_pips / 10000 / combined[cnh_col]).where(combined[cnh_col].notna())
            valid_count = df['锁汇成本'].notna().sum()
            print(f"  ✅ 锁汇成本: {valid_count} 个数据点（缩放系数={scale:.3f}）")
        else:
            print("  ⚠️  CNH 数据不可用，跳过锁汇成本")
    except Exception as e:
        print(f"  ⚠️  锁汇成本计算失败: {e}")

    # 保存
    output_path = os.path.join(OUTPUT_DIR, filename)
    df.to_excel(output_path)
    format_excel(output_path, is_indicators=False)

    print(f"✅ 已生成: {output_path}")
    print(f"   - 交易日数: {len(df)}, 资产数: {len(df.columns)}")
    return True


