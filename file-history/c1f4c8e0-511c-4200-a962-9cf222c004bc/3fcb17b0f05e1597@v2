<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fanshengxia.market-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fanshengxia/.claude/skills/market-review/scripts/run_market_review.sh</string>
    </array>

    <!-- 每周五 18:00 运行 (Weekday: 1=Mon ... 5=Fri) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 日志路径 -->
    <key>StandardOutPath</key>
    <string>/Users/fanshengxia/Library/Logs/market-review.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fanshengxia/Library/Logs/market-review.error.log</string>

    <!-- 环境变量（确保 Python / Node / Homebrew 可找到） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/fanshengxia</string>
    </dict>
</dict>
</plist>
