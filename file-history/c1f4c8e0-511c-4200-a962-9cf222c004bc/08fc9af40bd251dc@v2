const puppeteer = require('puppeteer');
(async () => {
    const browser = await puppeteer.launch({
        headless: 'new',
        args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage', '--disable-gpu']
    });
    const page = await browser.newPage();
    await page.setViewport({ width: 1920, height: 1080 });
    try {
        await page.goto('http://192.168.8.144:5173/', { waitUntil: 'domcontentloaded', timeout: 60000 });
    } catch(e) { console.log('goto:', e.message); }
    await new Promise(resolve => setTimeout(resolve, 15000));

    // 获取汇率分析板块的位置
    const forexSection = await page.$('.space-y-4 > div:last-child, section, [class*="forex"]');

    // 直接截取全页后用 clip 裁剪汇率部分（底部右侧区域）
    await page.screenshot({
        path: '/Users/fanshengxia/Desktop/市场观点美化/forex_section_check.png',
        clip: { x: 700, y: 2000, width: 750, height: 600 }
    });

    await browser.close();
    console.log('Screenshot saved!');
})();
