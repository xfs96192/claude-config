<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>行业生命周期分析</title>
<script src="/static/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:       #0b0e13;
    --surface:  #12161e;
    --border:   #1e2535;
    --border2:  #2a3348;
    --gold:     #c9a84c;
    --gold-dim: #7a6128;
    --amber:    #e8b96a;
    --text:     #d4d8e0;
    --text-dim: #6b7590;
    --text-mid: #9aa3b8;
    --green:    #4caf7d;
    --red:      #e05c5c;
    --blue:     #5b8dee;
    --font-mono: 'JetBrains Mono', monospace;
    --font-sans: 'Noto Sans SC', sans-serif;
    --font-serif: 'Noto Serif SC', serif;
    --sidebar-w: 280px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    overflow: hidden;
  }

  /* ─── LAYOUT ─────────────────────────────────────────────── */
  .shell {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* ─── SIDEBAR ─────────────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    min-width: var(--sidebar-w);
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-head {
    padding: 18px 16px 14px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .sidebar-head h2 {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: .04em;
  }

  .sidebar-head p {
    font-size: 10px;
    color: var(--text-dim);
    margin-top: 3px;
    font-family: var(--font-mono);
  }

  .search-box {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .search-box input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border2);
    border-radius: 4px;
    padding: 6px 10px;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 12px;
    outline: none;
    transition: border-color .15s;
  }

  .search-box input::placeholder { color: var(--text-dim); }
  .search-box input:focus { border-color: var(--gold-dim); }

  .tree-container {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0 12px;
  }

  .tree-container::-webkit-scrollbar { width: 4px; }
  .tree-container::-webkit-scrollbar-track { background: transparent; }
  .tree-container::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

  /* L1 node */
  .l1-node { margin-bottom: 1px; }

  .l1-header {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px 7px 12px;
    cursor: pointer;
    user-select: none;
    transition: background .1s;
    border-left: 2px solid transparent;
  }

  .l1-header:hover { background: rgba(201,168,76,.06); }
  .l1-header.open { border-left-color: var(--gold-dim); }

  .l1-caret {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    fill: var(--text-dim);
    transition: transform .18s;
  }

  .l1-header.open .l1-caret { transform: rotate(90deg); }

  .l1-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-mid);
    flex: 1;
  }

  .l1-header.open .l1-label { color: var(--amber); }

  .l1-count {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    background: var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .l1-children { display: none; padding-left: 10px; }
  .l1-children.open { display: block; }

  /* L2 node */
  .l2-node { margin-bottom: 1px; }

  .l2-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px 5px 10px;
    cursor: pointer;
    user-select: none;
    border-radius: 3px;
    transition: background .1s;
  }

  .l2-header:hover { background: rgba(255,255,255,.04); }

  .l2-caret {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    fill: var(--text-dim);
    transition: transform .15s;
  }

  .l2-header.open .l2-caret { transform: rotate(90deg); }

  .l2-label {
    font-size: 11.5px;
    color: var(--text-dim);
    flex: 1;
  }

  .l2-header.open .l2-label { color: var(--text-mid); }

  .l2-children { display: none; padding-left: 14px; padding-bottom: 2px; }
  .l2-children.open { display: block; }

  /* L3 leaf */
  .l3-item {
    padding: 4px 8px 4px 6px;
    cursor: pointer;
    border-radius: 3px;
    font-size: 11.5px;
    color: var(--text-dim);
    transition: all .1s;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .l3-item::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border2);
    flex-shrink: 0;
    transition: background .1s;
  }

  .l3-item:hover { background: rgba(255,255,255,.05); color: var(--text); }
  .l3-item:hover::before { background: var(--gold-dim); }

  .l3-item.active {
    background: rgba(201,168,76,.12);
    color: var(--amber);
    font-weight: 500;
  }

  .l3-item.active::before { background: var(--gold); }

  .l3-item.hidden { display: none; }

  /* ─── MAIN ─────────────────────────────────────────────────── */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
  }

  /* top bar */
  .topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 24px;
    height: 52px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .topbar-title {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: .06em;
    white-space: nowrap;
  }

  .topbar-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    flex: 1;
    overflow: hidden;
  }

  .bc-sep { color: var(--border2); }
  .bc-l1 { color: var(--text-dim); }
  .bc-l2 { color: var(--text-mid); }
  .bc-l3 { color: var(--amber); font-weight: 500; }

  .topbar-time {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    white-space: nowrap;
  }

  /* content area */
  .content {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px 24px;
  }

  .content::-webkit-scrollbar { width: 5px; }
  .content::-webkit-scrollbar-track { background: transparent; }
  .content::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

  /* placeholder */
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 16px;
    opacity: .4;
  }

  .placeholder-icon {
    width: 64px;
    height: 64px;
    fill: var(--gold-dim);
  }

  .placeholder h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--text-mid);
  }

  .placeholder p {
    font-size: 12px;
    color: var(--text-dim);
    text-align: center;
    max-width: 260px;
    line-height: 1.7;
  }

  /* summary strip */
  .summary-strip {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin-bottom: 18px;
  }

  .metric-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-label {
    font-size: 10px;
    color: var(--text-dim);
    line-height: 1.3;
    font-family: var(--font-mono);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .metric-value.pos { color: var(--green); }
  .metric-value.neg { color: var(--red); }
  .metric-value.gold { color: var(--amber); }
  .metric-value.na { color: var(--text-dim); font-size: 12px; }

  .metric-hint {
    font-size: 9px;
    font-family: var(--font-mono);
    color: var(--text-dim);
    margin-top: 1px;
  }

  /* charts grid */
  .charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
  }

  .chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 18px;
  }

  .chart-card.wide { grid-column: 1 / -1; }

  .chart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .chart-title {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .chart-subtitle {
    font-size: 10px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    margin-top: 3px;
  }

  .chart-legend {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chart-wrapper {
    position: relative;
    height: 320px;
  }

  /* spinner */
  .spinner-wrap {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    background: rgba(11,14,19,.7);
    border-radius: 8px;
    z-index: 10;
  }

  .spinner-wrap.show { display: flex; }

  .spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--border2);
    border-top-color: var(--gold);
    border-radius: 50%;
    animation: spin .8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* error toast */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #2a1515;
    border: 1px solid var(--red);
    border-radius: 6px;
    padding: 12px 16px;
    color: var(--red);
    font-size: 12px;
    max-width: 320px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .2s, transform .2s;
    pointer-events: none;
    z-index: 100;
  }

  .toast.show { opacity: 1; transform: none; }

  /* time legend bar */
  .time-legend {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .gradient-bar {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(to right, #4a90e2, #20c997, #f59e0b);
  }

  /* ─── CHARACTERISTICS FILTER (sidebar, always visible) ── */
  .filter-panel {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    padding: 10px 12px 12px;
  }

  .filter-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .filter-title-text {
    font-size: 10.5px;
    font-weight: 500;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .filter-active-badge {
    background: var(--gold-dim);
    color: var(--bg);
    border-radius: 10px;
    padding: 1px 6px;
    font-size: 9px;
    font-family: var(--font-mono);
    display: none;
  }

  .filter-active-badge.show { display: inline-block; }

  .filter-row {
    margin-bottom: 9px;
  }

  .filter-row:last-of-type { margin-bottom: 0; }

  .filter-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
  }

  .filter-name {
    font-size: 10px;
    color: var(--text-mid);
  }

  .filter-val {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--gold-dim);
  }

  .filter-range {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 3px;
    border-radius: 2px;
    background: var(--border2);
    outline: none;
    cursor: pointer;
  }

  .filter-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--gold-dim);
    cursor: pointer;
    transition: background .12s;
  }

  .filter-range::-webkit-slider-thumb:hover { background: var(--amber); }

  .filter-reset {
    margin-top: 8px;
    width: 100%;
    padding: 4px 0;
    background: transparent;
    border: 1px solid var(--border2);
    border-radius: 4px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    cursor: pointer;
    transition: border-color .12s, color .12s;
  }

  .filter-reset:hover { border-color: var(--gold-dim); color: var(--amber); }

  /* ─── CHARACTERISTICS STRIP (below summary) ─────────── */
  .char-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    margin-bottom: 16px;
  }

  .char-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    position: relative;
    overflow: hidden;
  }

  .char-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    height: 2px;
    background: var(--gold-dim);
    width: var(--pct-fill, 0%);
    transition: width .4s ease;
    border-radius: 0 0 3px 3px;
  }

  .char-label {
    font-size: 9.5px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    line-height: 1.3;
  }

  .char-value {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }

  .char-pct {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--gold-dim);
  }

  /* filter-hidden hides non-matching L3 items (and empty L1/L2 nodes) */
  .l3-item.filter-hidden { display: none; }
  .l2-node.filter-hidden { display: none; }
  .l1-node.filter-hidden { display: none; }

  /* ─── HELP BUTTON ────────────────────────────────────── */
  .help-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    background: transparent;
    border: 1px solid var(--border2);
    border-radius: 5px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color .15s, color .15s, background .15s;
    flex-shrink: 0;
  }

  .help-btn:hover {
    border-color: var(--gold-dim);
    color: var(--amber);
    background: rgba(201,168,76,.05);
  }

  .help-btn svg { flex-shrink: 0; }

  /* ─── MODAL OVERLAY ──────────────────────────────────── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.65);
    z-index: 200;
    align-items: flex-start;
    justify-content: center;
    padding: 32px 16px;
    overflow-y: auto;
  }

  .modal-overlay.open { display: flex; }

  .modal-box {
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: 10px;
    width: 100%;
    max-width: 760px;
    padding: 0;
    position: relative;
    box-shadow: 0 24px 64px rgba(0,0,0,.6);
    animation: modal-in .2s ease;
  }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 1; transform: none; }
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 16px;
    border-bottom: 1px solid var(--border);
  }

  .modal-header h2 {
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: .04em;
  }

  .modal-close {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border2);
    border-radius: 5px;
    cursor: pointer;
    color: var(--text-dim);
    transition: border-color .15s, color .15s;
    flex-shrink: 0;
  }

  .modal-close:hover { border-color: var(--red); color: var(--red); }

  .modal-body {
    padding: 24px;
    max-height: 75vh;
    overflow-y: auto;
  }

  .modal-body::-webkit-scrollbar { width: 4px; }
  .modal-body::-webkit-scrollbar-track { background: transparent; }
  .modal-body::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

  /* sections */
  .modal-section {
    margin-bottom: 28px;
  }

  .modal-section:last-child { margin-bottom: 0; }

  .modal-section-title {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--amber);
    margin-bottom: 14px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--border);
    letter-spacing: .03em;
  }

  .modal-section p {
    font-size: 12.5px;
    color: var(--text-mid);
    line-height: 1.8;
    margin-bottom: 10px;
  }

  .modal-section p:last-child { margin-bottom: 0; }

  /* stage grid */
  .stage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin: 12px 0;
  }

  .stage-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
  }

  .stage-num {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--gold-dim);
    margin-bottom: 3px;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .stage-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--amber);
    margin-bottom: 4px;
  }

  .stage-desc {
    font-size: 11px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* clearance types */
  .clearance-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 12px 0;
  }

  .clearance-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
  }

  .clearance-type {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 3px;
  }

  .clearance-eg {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--gold-dim);
    margin-bottom: 5px;
  }

  .clearance-desc {
    font-size: 11px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* chart guides */
  .chart-guide {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .chart-guide:last-child { margin-bottom: 0; }

  .chart-guide-title {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--amber);
    margin-bottom: 8px;
    font-weight: 500;
  }

  .chart-guide ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chart-guide li {
    font-size: 11.5px;
    color: var(--text-mid);
    line-height: 1.7;
    padding-left: 12px;
    position: relative;
  }

  .chart-guide li::before {
    content: '·';
    position: absolute;
    left: 2px;
    color: var(--gold-dim);
  }

  .tag {
    display: inline-block;
    background: rgba(201,168,76,.12);
    color: var(--amber);
    border-radius: 3px;
    padding: 0 5px;
    font-family: var(--font-mono);
    font-size: 10px;
  }
</style>
</head>
<body>

<div class="shell">
  <!-- ── SIDEBAR ── -->
  <aside class="sidebar">
    <div class="sidebar-head">
      <h2>行业生命周期</h2>
      <p>SW 三级行业 · 2010–2025Q3</p>
    </div>

    <div class="search-box">
      <input type="text" id="searchInput" placeholder="搜索行业名称…" autocomplete="off">
    </div>

