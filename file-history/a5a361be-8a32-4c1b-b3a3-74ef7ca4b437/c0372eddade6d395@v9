// ── Characteristics filter ────────────────────────
const CHAR_META = [
  { key: 'entry_exit_rate',  pct: 'entry_exit_pct',       label: '公司进出率',    fmt: v => v.toFixed(2) + ' 家/期',  tip: '高=公司进出频繁，低=成员稳定' },
  { key: 'struct_change',    pct: 'struct_change_pct',    label: '结构变化度',    fmt: v => (v * 100).toFixed(2) + '%', tip: '前10公司权重向量的余弦距离均值，高=结构多变' },
  { key: 'leader_turnover',  pct: 'leader_turnover_pct',  label: '龙头换手率',    fmt: v => (v * 100).toFixed(1) + '%', tip: '行业龙头（营收最大）更替期数比例' },
  { key: 'leader_rev_share', pct: 'leader_rev_share_pct', label: '龙头营收占比',  fmt: v => (v * 100).toFixed(1) + '%', tip: '最新期龙头营收 / 行业合计' },
  { key: 'cr3',              pct: 'cr3_pct',              label: 'CR3 集中度',    fmt: v => (v * 100).toFixed(1) + '%', tip: '最新期前三营收 / 行业合计' },
  { key: 'cr5',              pct: 'cr5_pct',              label: 'CR5 集中度',    fmt: v => (v * 100).toFixed(1) + '%', tip: '最新期前五营收 / 行业合计' },
];

let charData = {};       // { IndustryName -> {key: value, ...} }
let filterThresholds = {}; // { pct_key -> min_value (1-100) }

// Initialise filter thresholds to 0 (no filter)
CHAR_META.forEach(m => { filterThresholds[m.pct] = 0; });

async function loadCharacteristics() {
  try {
    const res = await fetch(`${API}/characteristics`);
    const data = await res.json();
    if (data.status !== 'success') return;
    data.industries.forEach(rec => { charData[rec.IndustryName] = rec; });
    buildFilterUI();
  } catch (_) {}
}

function buildFilterUI() {
  const panel = document.getElementById('filterPanel');
  // Remove existing filter rows (keep title div)
  panel.querySelectorAll('.filter-row, .filter-reset').forEach(el => el.remove());

  CHAR_META.forEach(m => {
    const row = document.createElement('div');
    row.className = 'filter-row';
    row.innerHTML = `
      <div class="filter-label-row">
        <span class="filter-name" title="${m.tip}">${m.label}</span>
        <span class="filter-val" id="fval_${m.pct}">≥ 0</span>
      </div>
      <input class="filter-range" type="range" min="0" max="100" step="1"
             value="0" id="fslider_${m.pct}" title="${m.tip}">`;
    panel.appendChild(row);

    row.querySelector(`#fslider_${m.pct}`).addEventListener('input', function() {
      filterThresholds[m.pct] = parseInt(this.value);
      row.querySelector(`#fval_${m.pct}`).textContent = `≥ ${this.value}`;
      applyFilter();
    });
  });

  const resetBtn = document.createElement('button');
  resetBtn.className = 'filter-reset';
  resetBtn.textContent = '重置全部条件';
  resetBtn.addEventListener('click', resetFilter);
  panel.appendChild(resetBtn);
}

function resetFilter() {
  CHAR_META.forEach(m => {
    filterThresholds[m.pct] = 0;
    const slider = document.getElementById(`fslider_${m.pct}`);
    const val    = document.getElementById(`fval_${m.pct}`);
    if (slider) slider.value = 0;
    if (val)    val.textContent = '≥ 0';
  });
  applyFilter();
}

function isFilterActive() {
  return CHAR_META.some(m => filterThresholds[m.pct] > 0);
}

function industryMatchesFilter(name) {
  const rec = charData[name];
  if (!rec) return false;
  return CHAR_META.every(m => {
    const min = filterThresholds[m.pct];
    if (min <= 0) return true;
    const v = rec[m.pct];
    return v != null && v >= min;
  });
}

function applyFilter() {
  const active = isFilterActive();
  document.getElementById('filterBadge').classList.toggle('show', active);

  if (!active) {
    // Show everything
    document.querySelectorAll('.l3-item, .l2-node, .l1-node').forEach(el => {
      el.classList.remove('filter-hidden');
    });
    return;
  }

  // Hide/show L3 items based on filter
  document.querySelectorAll('.l3-item').forEach(el => {
    const match = industryMatchesFilter(el.dataset.l3 || '');
    el.classList.toggle('filter-hidden', !match);
  });

  // Hide L2 nodes that have no visible L3 children
  document.querySelectorAll('.l2-node').forEach(l2 => {
    const hasVisible = l2.querySelector('.l3-item:not(.filter-hidden)');
    l2.classList.toggle('filter-hidden', !hasVisible);
    // Auto-expand L2 that has matches
    if (hasVisible) {
      l2.querySelector('.l2-children')?.classList.add('open');
      l2.querySelector('.l2-header')?.classList.add('open');
    }
  });

  // Hide L1 nodes that have no visible L2 children
  document.querySelectorAll('.l1-node').forEach(l1 => {
    const hasVisible = l1.querySelector('.l2-node:not(.filter-hidden)');
    l1.classList.toggle('filter-hidden', !hasVisible);
    // Auto-expand L1 that has matches
    if (hasVisible) {
      l1.querySelector('.l1-children')?.classList.add('open');
      l1.querySelector('.l1-header')?.classList.add('open');
    }
  });
}

// Render characteristics strip
function renderCharStrip(chars) {
  const strip = document.getElementById('charStrip');
  if (!chars || Object.keys(chars).length === 0) {
    strip.style.display = 'none';
    return;
  }
  strip.style.display = 'grid';
  strip.innerHTML = CHAR_META.map(m => {
    const raw = chars[m.key];
    const pct = chars[m.pct];
    const rawTxt = raw != null ? m.fmt(raw) : '—';
    const pctTxt = pct != null ? `第 ${pct} 分位` : '—';
    const fill   = pct != null ? pct : 0;
    return `<div class="char-card" style="--pct-fill:${fill}%;" title="${m.tip}">
      <div class="char-label">${m.label}</div>
      <div class="char-value">${rawTxt}</div>
      <div class="char-pct">${pctTxt}</div>
    </div>`;
  }).join('');
}

// ── Help Modal ────────────────────────────────────
(function() {
  const overlay = document.getElementById('helpModal');
  const openBtn = document.getElementById('helpBtn');
  const closeBtn = document.getElementById('helpClose');

  openBtn.addEventListener('click', () => overlay.classList.add('open'));
  closeBtn.addEventListener('click', () => overlay.classList.remove('open'));
  overlay.addEventListener('click', e => {
    if (e.target === overlay) overlay.classList.remove('open');
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') overlay.classList.remove('open');
  });
})();

