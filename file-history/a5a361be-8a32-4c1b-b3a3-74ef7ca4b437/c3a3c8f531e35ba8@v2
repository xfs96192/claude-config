def build_reverse_map() -> dict[str, tuple[str, str]]:
    """返回 {L3名称: (L1名称, L2名称)} 反查字典。"""
    reverse: dict[str, tuple[str, str]] = {}
    for l1, l2_map in SW_TREE.items():
        for l2, l3_list in l2_map.items():
            for l3 in l3_list:
                if l3 in reverse:
                    pass  # 重复映射时保留首次出现
                else:
                    reverse[l3] = (l1, l2)
    return reverse


L3_TO_L1L2 = build_reverse_map()
