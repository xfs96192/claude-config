#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
产业生命周期分类器

为 industry_metrics.csv 中的每个行业 × 每个季度，打上 1-6 的生命周期阶段标签。

六阶段定义（基于 RCM 研究框架）：
  S1·成长赛道  : 高增速 + 高资本开支 + 利润率稳定/改善，新兴赛道规模扩张
  S2·洗牌前期  : 高资本开支 + 增速边际放缓 + 利润率开始下行，竞争格局恶化前兆
  S3·行业洗牌  : 增速低位 + 资本开支仍高（产能过剩），行业格局重构阶段
  S4·出清末期  : 增速低位 + 资本开支收缩 + 盈利恶化，弱势企业加速退出
  S5·龙头进阶  : 增速回升 + 资本开支低位 + 利润率修复，寡头格局确立
  S6·稳态成熟  : 中低增速 + 低资本开支 + 盈利稳定，成熟行业低波动

分类信号说明
┌──────────────────────────────────────────────────────────────────────────────┐
│ 主要信号（time-series，来自 industry_metrics.csv）                           │
│  R_pct  = rev_growth_percentile   营收三年复合增速的跨行业分位（0-1）        │
│  C_pct  = capex_cagr_percentile   资本开支三年复合增速的跨行业分位（0-1）    │
│  ΔM     = gross_margin_3y_diff    三年毛利率变化（正值=改善）                │
│  ROIC   = roic                    增量 ROIC（(营收变化) / (投入资本变化)）   │
│  CDA    = capex_da_ratio          Capex / 折旧摊销，仅Q2/Q4有值              │
│  NM     = net_margin              净利率（归母）                              │
│  OCF    = ocf_to_rev              经营现金流 / 营收                          │
│                                                                              │
│ 派生时序信号（按行业顺序滚动计算）                                            │
│  capex_low_dur   : 当前及之前连续低位资本开支（C_pct < 0.40）的期数          │
│  went_thru_s4    : 过去 20 期（≈5年）内是否出现过 S4 阶段                   │
└──────────────────────────────────────────────────────────────────────────────┘

分类矩阵（R × C 象限 × 利润率方向）：
             C_pct ≥ 0.55          C_pct < 0.40
R_pct ≥ 0.55  S1（无出清）         S5（有出清）/ S6（无出清）
              S5（有出清）
              S2（ΔM < -1pp）
R_pct < 0.40  S3                   S4（主导）/ S5（ΔM 改善+有出清）

优先级规则（P1 > P6）：
  P1  强出清信号 → 强制 S4
  P2  高R + 高C 象限
  P3  低R + 高C 象限 → S3
  P4  低R + 低C 象限
  P5  高R + 低C 象限 → S5/S6
  P6  中间过渡区 → 依近邻象限
"""
from __future__ import annotations

import argparse
import numpy as np
import pandas as pd
from pathlib import Path

# ── 阶段元数据 ────────────────────────────────────────────────────────────────

STAGE_LABELS: dict[int, str] = {
    0: "未分类",
    1: "S1·成长赛道",
    2: "S2·洗牌前期",
    3: "S3·行业洗牌",
    4: "S4·出清末期",
    5: "S5·龙头进阶",
    6: "S6·稳态成熟",
}

STAGE_COLORS: dict[int, str] = {
    0: "#6b7590",
    1: "#4caf7d",   # 绿
    2: "#c9a84c",   # 黄
    3: "#e08c3c",   # 橙
    4: "#e05c5c",   # 红
    5: "#5c9de0",   # 蓝
    6: "#9c7adb",   # 紫
}

STAGE_DESCRIPTIONS: dict[int, str] = {
    0: "数据不足，无法分类",
    1: "新兴赛道高速扩张，投资与营收双高，利润率稳定或改善",
    2: "营收高位但资本开支仍扩张，利润率开始承压，洗牌前兆",
    3: "产能过剩下行业仍大量投资，营收增速回落，格局重构",
    4: "营收与投资双双萎缩，盈利恶化，弱势企业加速出清",
    5: "出清后龙头份额提升，营收回升而资本开支保持低位，盈利修复",
    6: "增速平稳、投资轻资产化，竞争格局稳定，高盈利持续性",
}

# ── 分类阈值 ──────────────────────────────────────────────────────────────────

R_HIGH = 0.55     # 营收增速高分位阈值
R_LOW  = 0.40     # 营收增速低分位阈值
C_HIGH = 0.55     # 资本开支高分位阈值
C_LOW  = 0.40     # 资本开支低分位阈值

DM_IMPROVING = 0.01    # 利润率改善阈值（+1pp）
DM_DECLINING = -0.01   # 利润率下行阈值（-1pp）
DM_SHARP_DEC = -0.03   # 利润率明显恶化阈值（-3pp）

CAPEX_DA_BOTTOM   = 1.0   # Capex/DA 出清见底信号
CAPEX_DA_CONTRACT = 1.5   # Capex/DA 投资收缩区间上限

S4_LOOKBACK_PERIODS = 20  # 判断 went_thru_s4 的回看期数（约5年）


# ── 单期分类核心函数 ──────────────────────────────────────────────────────────

def classify_one(
    R: float, C: float,
    dM: float, roic: float,
    capex_da: float, net_m: float, ocf: float,
    capex_low_dur: int,
    went_thru_s4: bool,
) -> int:
    """
    给定当期所有信号，返回阶段编号 1-6（0=数据不足/未分类）。
    所有输入允许 NaN。
    """
    if pd.isna(R) or pd.isna(C):
        return 0

    # ── P1: 强信号出清末期 ────────────────────────────────────────────────
    # 增量 ROIC 严重为负 + 资本开支低位 + 营收低位（三者同步）
    if (not np.isnan(roic) and roic < -0.20) and C < C_HIGH and R < R_LOW:
        return 4
    # Capex/DA 跌破 1.0：新增资本开支连折旧都不够，且营收不在高位
    # (若营收处于高分位，capex_da < 1 可能是轻资产化/S5-S6 特征，不强制 S4)
    if (not np.isnan(capex_da) and capex_da < CAPEX_DA_BOTTOM) \
            and C < C_HIGH and R < R_HIGH:
        return 4
    # 持续6期（≈18个月）C 低位 + 营收萎缩 + 利润率恶化
    if (capex_low_dur >= 6
            and R < R_LOW
            and (np.isnan(dM) or dM < DM_DECLINING)):
        return 4

    # ── P2: 高R + 高C 象限 ──────────────────────────────────────────────
    if R >= R_HIGH and C >= C_HIGH:
        # 利润率稳定或改善
        if np.isnan(dM) or dM >= DM_DECLINING:
            return 5 if went_thru_s4 else 1
        else:
            # 利润率开始下行 → 洗牌前期
            return 2

    # ── P3: 低R + 高C 象限 → 行业洗牌 ───────────────────────────────────
    if R < R_LOW and C >= C_HIGH:
        return 3

    # ── P4: 低R + 低C 象限 ──────────────────────────────────────────────
    if R < R_LOW and C < C_LOW:
        # 盈利回升 + Capex/DA 恢复 + 有出清历史 → S5 萌芽
        improving_profit = (not np.isnan(dM) and dM > DM_IMPROVING) and \
                           (not np.isnan(net_m) and net_m > 0.03)
        capex_recovering = np.isnan(capex_da) or capex_da > CAPEX_DA_CONTRACT
        if improving_profit and capex_recovering:
            if went_thru_s4:
                return 5
            # 无出清历史、利润稳定 → 成熟低增长
            return 6
        # 盈利恶化 / 长期低资本 → 出清未结束
        if (not np.isnan(roic) and roic < 0) \
                or (not np.isnan(dM) and dM < DM_SHARP_DEC) \
                or capex_low_dur >= 4:
            return 4
        # 有出清历史 + 净利润轻微转正 → 初步进入 S5
        if went_thru_s4 and not np.isnan(net_m) and net_m > 0:
            return 5
        return 4

    # ── P5: 高R + 低C 象限 ──────────────────────────────────────────────
    if R >= R_HIGH and C < C_LOW:
        if went_thru_s4:
            return 5
        if np.isnan(dM) or dM >= DM_DECLINING:
            return 6
        return 5

    # ── P6: 中间过渡区 (R 或 C 落在 [LOW, HIGH]) ────────────────────────
    DM_STRESS = -0.07  # 利润率压力阈值：3年内 -7pp 为明显恶化

    # 中R + 高C
    if C >= C_HIGH:
        if np.isnan(dM) or dM >= DM_DECLINING:
            return 1 if not went_thru_s4 else 5
        return 2
    # 中R + 低C
    if C < C_LOW:
        # 利润率严重恶化（3年下行 > 7pp）→ 出清
        if not np.isnan(dM) and dM < DM_STRESS:
            return 4
        if went_thru_s4 or (not np.isnan(dM) and dM > DM_IMPROVING):
            return 5
        return 6
    # 中R + 中C
    if R >= 0.50 and C >= 0.50:
        if np.isnan(dM) or dM >= DM_DECLINING:
            return 1 if not went_thru_s4 else 5
        return 2
    if R < 0.50 and C >= 0.50:
        return 3
    if R < 0.50 and C < 0.50:
        if not np.isnan(dM) and dM < DM_STRESS:
            return 4
        if (not np.isnan(dM) and dM < 0):
            return 4
        return 5 if went_thru_s4 else 6
    # R >= 0.50, C < 0.50
    if not np.isnan(dM) and dM < DM_STRESS:
        return 4
    return 5 if went_thru_s4 else 6


# ── 行业时序处理 ──────────────────────────────────────────────────────────────

def classify_industry(grp: pd.DataFrame) -> pd.DataFrame:
    """对单个行业按时间顺序逐期分类，维护跨期状态。"""
    grp = grp.sort_values("Accper").copy()
    stages: list[int] = []

    c_pct_vals = grp["capex_cagr_percentile"].tolist()
    accper_list = grp["Accper"].tolist()

    for pos, (_, row) in enumerate(grp.iterrows()):
        # capex_low_dur：向前数连续低位期数
        capex_low_dur = 0
        for j in range(pos, -1, -1):
            v = c_pct_vals[j]
            if not (np.isnan(v) if isinstance(v, float) else False) and v < C_LOW:
                capex_low_dur += 1
            else:
                break

        # went_thru_s4：近 20 期是否经历过 S4
        start = max(0, len(stages) - S4_LOOKBACK_PERIODS)
        went_thru_s4 = 4 in stages[start:]

        def _f(key: str) -> float:
            v = row.get(key, np.nan)
            return float(v) if pd.notna(v) else np.nan

        stage = classify_one(
            R=_f("rev_growth_percentile"),
            C=_f("capex_cagr_percentile"),
            dM=_f("gross_margin_3y_diff"),
            roic=_f("roic"),
            capex_da=_f("capex_da_ratio"),
            net_m=_f("net_margin"),
            ocf=_f("ocf_to_rev"),
            capex_low_dur=capex_low_dur,
            went_thru_s4=went_thru_s4,
        )
        stages.append(stage)

    grp["lifecycle_stage"] = stages
    grp["lifecycle_label"] = grp["lifecycle_stage"].map(STAGE_LABELS)
    return grp


# ── CLI ───────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="Classify industry lifecycle stages")
    parser.add_argument(
        "--input", type=Path, default=Path("industry_metrics.csv"),
        help="Path to industry_metrics.csv (default: ./industry_metrics.csv)",
    )
    parser.add_argument(
        "--output", type=Path, default=None,
        help="Output path (default: overwrite input file)",
    )
    args = parser.parse_args()

    print(f"Reading {args.input} …")
    df = pd.read_csv(args.input)
    df["Accper"] = pd.to_datetime(df["Accper"])

    # Drop existing columns if re-running
    for col in ("lifecycle_stage", "lifecycle_label"):
        if col in df.columns:
            df = df.drop(columns=[col])

    print(f"Classifying {df['IndustryName'].nunique()} industries …")
    parts: list[pd.DataFrame] = []
    for ind_name, grp in df.groupby("IndustryName"):
        parts.append(classify_industry(grp))

    result = (
        pd.concat(parts)
        .sort_values(["IndustryName", "Accper"])
        .reset_index(drop=True)
    )

    out_path = args.output or args.input
    result.to_csv(out_path, index=False)
    print(f"Saved → {out_path}")

    # ── Stats: latest representative quarter ─────────────────────────────
    # Use last Q4 or Q3 as representative (avoid early-reporter bias)
    q_order = ["12-31", "09-30", "06-30", "03-31"]
    latest_periods = sorted(result["Accper"].unique(), reverse=True)
    rep_q = None
    for q in latest_periods:
        suffix = f"{q.month:02d}-{q.day:02d}"
        if suffix in q_order[:2]:   # prefer Q4/Q3
            # use the most recent Q4 or Q3 that has ≥ 50 industries
            n = (result["Accper"] == q).sum()
            if n >= 50:
                rep_q = q
                break
    if rep_q is None:
        rep_q = result["Accper"].max()

    latest = result[result["Accper"] == rep_q]
    print(f"\n代表性最新期 ({pd.Timestamp(rep_q).strftime('%Y-%m-%d')}) 各阶段行业数：")
    for stage in range(1, 7):
        n = (latest["lifecycle_stage"] == stage).sum()
        print(f"  {STAGE_LABELS[stage]:12s}: {n:3d} 个")
    unk = (latest["lifecycle_stage"] == 0).sum()
    if unk:
        print(f"  {'未分类':12s}: {unk:3d} 个")

    print("\n示例行业（最新期，每阶段各取3个）：")
    sample = (
        latest[["IndustryName", "lifecycle_stage", "lifecycle_label",
                "rev_growth_percentile", "capex_cagr_percentile",
                "gross_margin_3y_diff"]]
        .sort_values("lifecycle_stage")
        .groupby("lifecycle_stage", sort=True)
        .head(3)
    )
    print(sample.drop(columns="lifecycle_stage").to_string(index=False))


if __name__ == "__main__":
    main()
