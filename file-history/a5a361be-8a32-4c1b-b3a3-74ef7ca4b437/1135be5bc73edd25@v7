@app.route("/api/analyze/<industry_name>")
def analyze_industry(industry_name: str):
    try:
        metrics = repo.load()
        df = metrics.dataframe
        industry_df = df[df["IndustryName"] == industry_name].copy()
        if industry_df.empty:
            return jsonify({"status": "error", "error": f"未找到行业: {industry_name}"}), 404

        chart1 = _build_chart_points(
            industry_df, x_col="capex_cagr_3y", y_col="gross_margin_3y_diff",
            size_col="roic", percent_cols=PERCENT_COLUMNS, percentile_cols=PERCENTILE_COLUMNS,
        )
        chart2 = _build_chart_points(
            industry_df, x_col="capex_cagr_percentile", y_col="rev_growth_percentile",
            percent_cols=PERCENT_COLUMNS, percentile_cols=PERCENTILE_COLUMNS,
        )
        chart3 = _build_chart_points(
            industry_df, x_col="rev_growth_3y", y_col="gross_margin_geom3y",
            size_col="leader_advantage", percent_cols=PERCENT_COLUMNS, percentile_cols=PERCENTILE_COLUMNS,
        )

        # 行业层级信息
        l1, l2 = L3_TO_L1L2.get(industry_name, ("—", "—"))

        # Industry characteristics
        chars_df = char_repo.load()
        chars_row = chars_df[chars_df["IndustryName"] == industry_name]
        characteristics: Dict = {}
        if not chars_row.empty:
            row = chars_row.iloc[0]
            for col in CHAR_COLUMNS:
                v = row.get(col)
                if v is not None and not (isinstance(v, float) and not math.isfinite(v)):
                    characteristics[col] = round(float(v), 4)
                else:
                    characteristics[col] = None

        lifecycle = _get_representative_stage(industry_df)

        result = {
            "status": "success",
            "industry": industry_name,
            "l1": l1,
            "l2": l2,
            "chart1": chart1,
            "chart2": chart2,
            "chart3": chart3,
            "summary": _build_summary(industry_df),
            "characteristics": characteristics,
            "lifecycle": lifecycle,
            "timestamp": datetime.now().isoformat(),
        }
        return jsonify(_sanitize_json(result))
    except Exception as exc:
        logger.exception("Failed to analyze industry")
        return jsonify({"status": "error", "error": str(exc)}), 500


@app.route("/api/characteristics")
def get_characteristics():
    """返回所有行业的静态特征指标及当前生命周期阶段（用于前端筛选）。"""
    try:
        df = char_repo.load()
        metrics = repo.load()
        metrics_df = metrics.dataframe

        # Build a lookup: industry → current representative lifecycle stage
        lifecycle_map: Dict[str, Dict] = {}
        for ind_name, grp in metrics_df.groupby("IndustryName"):
            lifecycle_map[ind_name] = _get_representative_stage(grp)

        records = []
        for _, row in df.iterrows():
            rec: Dict = {"IndustryName": row["IndustryName"]}
            for col in CHAR_COLUMNS:
                v = row.get(col)
                rec[col] = None if (v is None or (isinstance(v, float) and not math.isfinite(v))) else round(float(v), 4)
            # Attach lifecycle info
            lc = lifecycle_map.get(row["IndustryName"], {"stage": 0, "label": "未分类", "color": "#6b7590", "quarter": ""})
            rec["lifecycle_stage"] = lc["stage"]
            rec["lifecycle_label"] = lc["label"]
            rec["lifecycle_color"] = lc["color"]
            rec["lifecycle_quarter"] = lc["quarter"]
            records.append(rec)
        return jsonify(_sanitize_json({
            "status": "success",
            "labels": CHAR_LABELS,
            "lifecycle_labels": LIFECYCLE_LABELS,
            "lifecycle_colors": LIFECYCLE_COLORS,
            "industries": records,
        }))
    except Exception as exc:
        logger.exception("Failed to load characteristics")
        return jsonify({"status": "error", "error": str(exc)}), 500


