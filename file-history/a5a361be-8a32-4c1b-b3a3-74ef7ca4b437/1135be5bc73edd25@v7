@app.route("/api/industries/tree")
def get_industry_tree():
    """返回 SW 三级行业树，过滤仅保留 CSV 中存在的三级行业。"""
    try:
        metrics = repo.load()
        available_l3 = set(metrics.dataframe["IndustryName"].dropna().unique())

        tree = []
        for l1_name, l2_map in SW_TREE.items():
            l2_nodes = []
            for l2_name, l3_list in l2_map.items():
                l3_available = [l3 for l3 in l3_list if l3 in available_l3]
                if l3_available:
                    l2_nodes.append({"name": l2_name, "children": l3_available})
            if l2_nodes:
                tree.append({"name": l1_name, "children": l2_nodes})

        return jsonify(_sanitize_json({"status": "success", "tree": tree}))
    except Exception as exc:
        logger.exception("Failed to build industry tree")
        return jsonify({"status": "error", "error": str(exc)}), 500


