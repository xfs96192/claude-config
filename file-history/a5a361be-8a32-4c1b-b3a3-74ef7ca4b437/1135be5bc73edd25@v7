class CharacteristicsRepository:
    def __init__(self, csv_path: Path):
        self.csv_path = csv_path
        self._cache: pd.DataFrame | None = None
        self._last_mtime: float | None = None

    def load(self) -> pd.DataFrame:
        if not self.csv_path.exists():
            logger.warning("Characteristics file not found: %s", self.csv_path)
            return pd.DataFrame(columns=["IndustryName"] + CHAR_COLUMNS)
        current_mtime = self.csv_path.stat().st_mtime
        if self._cache is None or self._last_mtime != current_mtime:
            df = pd.read_csv(self.csv_path)
            for col in CHAR_COLUMNS:
                if col in df.columns:
                    df[col] = pd.to_numeric(df[col], errors="coerce")
            self._cache = df
            self._last_mtime = current_mtime
            logger.info("Loaded characteristics from %s (rows=%d)", self.csv_path, len(df))
        return self._cache


