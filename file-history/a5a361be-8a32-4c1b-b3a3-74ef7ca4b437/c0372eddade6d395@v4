<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>行业生命周期分析</title>
<script src="/static/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:       #0b0e13;
    --surface:  #12161e;
    --border:   #1e2535;
    --border2:  #2a3348;
    --gold:     #c9a84c;
    --gold-dim: #7a6128;
    --amber:    #e8b96a;
    --text:     #d4d8e0;
    --text-dim: #6b7590;
    --text-mid: #9aa3b8;
    --green:    #4caf7d;
    --red:      #e05c5c;
    --blue:     #5b8dee;
    --font-mono: 'JetBrains Mono', monospace;
    --font-sans: 'Noto Sans SC', sans-serif;
    --font-serif: 'Noto Serif SC', serif;
    --sidebar-w: 260px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    overflow: hidden;
  }

  /* ─── LAYOUT ─────────────────────────────────────────────── */
  .shell {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* ─── SIDEBAR ─────────────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    min-width: var(--sidebar-w);
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-head {
    padding: 18px 16px 14px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .sidebar-head h2 {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: .04em;
  }

  .sidebar-head p {
    font-size: 10px;
    color: var(--text-dim);
    margin-top: 3px;
    font-family: var(--font-mono);
  }

  .search-box {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .search-box input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border2);
    border-radius: 4px;
    padding: 6px 10px;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 12px;
    outline: none;
    transition: border-color .15s;
  }

  .search-box input::placeholder { color: var(--text-dim); }
  .search-box input:focus { border-color: var(--gold-dim); }

  .tree-container {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0 12px;
  }

  .tree-container::-webkit-scrollbar { width: 4px; }
  .tree-container::-webkit-scrollbar-track { background: transparent; }
  .tree-container::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

  /* L1 node */
  .l1-node { margin-bottom: 1px; }

  .l1-header {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px 7px 12px;
    cursor: pointer;
    user-select: none;
    transition: background .1s;
    border-left: 2px solid transparent;
  }

  .l1-header:hover { background: rgba(201,168,76,.06); }
  .l1-header.open { border-left-color: var(--gold-dim); }

  .l1-caret {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    fill: var(--text-dim);
    transition: transform .18s;
  }

  .l1-header.open .l1-caret { transform: rotate(90deg); }

  .l1-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-mid);
    flex: 1;
  }

  .l1-header.open .l1-label { color: var(--amber); }

  .l1-count {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    background: var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .l1-children { display: none; padding-left: 10px; }
  .l1-children.open { display: block; }

  /* L2 node */
  .l2-node { margin-bottom: 1px; }

  .l2-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px 5px 10px;
    cursor: pointer;
    user-select: none;
    border-radius: 3px;
    transition: background .1s;
  }

  .l2-header:hover { background: rgba(255,255,255,.04); }

  .l2-caret {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    fill: var(--text-dim);
    transition: transform .15s;
  }

  .l2-header.open .l2-caret { transform: rotate(90deg); }

  .l2-label {
    font-size: 11.5px;
    color: var(--text-dim);
    flex: 1;
  }

  .l2-header.open .l2-label { color: var(--text-mid); }

  .l2-children { display: none; padding-left: 14px; padding-bottom: 2px; }
  .l2-children.open { display: block; }

  /* L3 leaf */
  .l3-item {
    padding: 4px 8px 4px 6px;
    cursor: pointer;
    border-radius: 3px;
    font-size: 11.5px;
    color: var(--text-dim);
    transition: all .1s;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .l3-item::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border2);
    flex-shrink: 0;
    transition: background .1s;
  }

  .l3-item:hover { background: rgba(255,255,255,.05); color: var(--text); }
  .l3-item:hover::before { background: var(--gold-dim); }

  .l3-item.active {
    background: rgba(201,168,76,.12);
    color: var(--amber);
    font-weight: 500;
  }

  .l3-item.active::before { background: var(--gold); }

  .l3-item.hidden { display: none; }

  /* ─── MAIN ─────────────────────────────────────────────────── */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
  }

  /* top bar */
  .topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 24px;
    height: 52px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .topbar-title {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: .06em;
    white-space: nowrap;
  }

  .topbar-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    flex: 1;
    overflow: hidden;
  }

  .bc-sep { color: var(--border2); }
  .bc-l1 { color: var(--text-dim); }
  .bc-l2 { color: var(--text-mid); }
  .bc-l3 { color: var(--amber); font-weight: 500; }

  .topbar-time {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    white-space: nowrap;
  }

  /* content area */
  .content {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px 24px;
  }

  .content::-webkit-scrollbar { width: 5px; }
  .content::-webkit-scrollbar-track { background: transparent; }
  .content::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

  /* placeholder */
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 16px;
    opacity: .4;
  }

  .placeholder-icon {
    width: 64px;
    height: 64px;
    fill: var(--gold-dim);
  }

  .placeholder h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--text-mid);
  }

  .placeholder p {
    font-size: 12px;
    color: var(--text-dim);
    text-align: center;
    max-width: 260px;
    line-height: 1.7;
  }

  /* summary strip */
  .summary-strip {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin-bottom: 18px;
  }

  .metric-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-label {
    font-size: 10px;
    color: var(--text-dim);
    line-height: 1.3;
    font-family: var(--font-mono);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .metric-value.pos { color: var(--green); }
  .metric-value.neg { color: var(--red); }
  .metric-value.gold { color: var(--amber); }
  .metric-value.na { color: var(--text-dim); font-size: 12px; }

  /* charts grid */
  .charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
  }

  .chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 18px;
  }

  .chart-card.wide { grid-column: 1 / -1; }

  .chart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .chart-title {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .chart-subtitle {
    font-size: 10px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    margin-top: 3px;
  }

  .chart-legend {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chart-wrapper {
    position: relative;
    height: 320px;
  }

  /* spinner */
  .spinner-wrap {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    background: rgba(11,14,19,.7);
    border-radius: 8px;
    z-index: 10;
  }

  .spinner-wrap.show { display: flex; }

  .spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--border2);
    border-top-color: var(--gold);
    border-radius: 50%;
    animation: spin .8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* error toast */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #2a1515;
    border: 1px solid var(--red);
    border-radius: 6px;
    padding: 12px 16px;
    color: var(--red);
    font-size: 12px;
    max-width: 320px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .2s, transform .2s;
    pointer-events: none;
    z-index: 100;
  }

  .toast.show { opacity: 1; transform: none; }

  /* time legend bar */
  .time-legend {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .gradient-bar {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(to right, #1a2040, var(--amber));
  }
</style>
</head>
<body>

<div class="shell">
  <!-- ── SIDEBAR ── -->
  <aside class="sidebar">
    <div class="sidebar-head">
      <h2>行业生命周期</h2>
      <p>SW 三级行业 · 2010–2025Q3</p>
    </div>

    <div class="search-box">
      <input type="text" id="searchInput" placeholder="搜索行业名称…" autocomplete="off">
    </div>

    <div class="tree-container" id="treeContainer">
      <div style="padding:20px;color:var(--text-dim);font-size:11px;text-align:center;">加载中…</div>
    </div>
  </aside>

  <!-- ── MAIN ── -->
  <main class="main">
    <div class="topbar">
      <span class="topbar-title">行业生命周期分析</span>
      <div class="topbar-breadcrumb" id="breadcrumb">
        <span style="color:var(--text-dim)">← 从左侧选择三级行业</span>
      </div>
      <span class="topbar-time" id="topbarTime"></span>
    </div>

    <div class="content" id="mainContent">
      <div class="placeholder" id="placeholder">
        <svg class="placeholder-icon" viewBox="0 0 64 64">
          <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="1.5" fill="none" opacity=".3"/>
          <circle cx="22" cy="38" r="5" fill="currentColor" opacity=".4"/>
          <circle cx="38" cy="26" r="7" fill="currentColor" opacity=".6"/>
          <circle cx="50" cy="36" r="4" fill="currentColor" opacity=".3"/>
          <polyline points="22,38 38,26 50,36" stroke="currentColor" stroke-width="1" fill="none" stroke-dasharray="3 2" opacity=".4"/>
        </svg>
        <h3>选择行业开始分析</h3>
        <p>在左侧展开申万一级行业<br>点击三级行业名称查看生命周期图表</p>
      </div>

      <div id="dashboardArea" style="display:none;">
        <!-- summary -->
        <div class="summary-strip" id="summaryStrip"></div>

        <!-- charts -->
        <div class="charts-grid">
          <div class="chart-card wide" id="card1">
            <div class="chart-header">
              <div>
                <div class="chart-title">毛利率三年差分 × Capex 三年复合增速</div>
                <div class="chart-subtitle">气泡大小 = ROIC（绝对值越大气泡越大）</div>
              </div>
              <div class="chart-legend" id="legend1"></div>
            </div>
            <div class="chart-wrapper">
              <canvas id="chart1"></canvas>
              <div class="spinner-wrap" id="spin1"><div class="spinner"></div></div>
            </div>
            <div class="time-legend">
              <span>早期</span>
              <div class="gradient-bar"></div>
              <span>近期</span>
            </div>
          </div>

          <div class="chart-card" id="card2">
            <div class="chart-header">
              <div>
                <div class="chart-title">营收增速分位 × Capex 增速分位</div>
                <div class="chart-subtitle">截面百分位排名（0–100）</div>
              </div>
            </div>
            <div class="chart-wrapper">
              <canvas id="chart2"></canvas>
              <div class="spinner-wrap" id="spin2"><div class="spinner"></div></div>
            </div>
            <div class="time-legend">
              <span>早期</span>
              <div class="gradient-bar"></div>
              <span>近期</span>
            </div>
          </div>

          <div class="chart-card" id="card3">
            <div class="chart-header">
              <div>
                <div class="chart-title">三年毛利率均值 × 三年营收增速</div>
                <div class="chart-subtitle">气泡大小 = 龙头毛利率优势</div>
              </div>
            </div>
            <div class="chart-wrapper">
              <canvas id="chart3"></canvas>
              <div class="spinner-wrap" id="spin3"><div class="spinner"></div></div>
            </div>
            <div class="time-legend">
              <span>早期</span>
              <div class="gradient-bar"></div>
              <span>近期</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<div class="toast" id="toast"></div>

<script>
const API = 'http://localhost:8080/api';
let charts = {};
let currentIndustry = null;

// ── 时间轴颜色插值（深蓝→琥珀） ──────────────────
function timeColor(ratio) {
  // ratio: 0(早)→1(近)
  const r0 = [26, 32, 64],    r1 = [232, 185, 106];
  const r = r0.map((v, i) => Math.round(v + (r1[i] - v) * ratio));
  return `rgb(${r[0]},${r[1]},${r[2]})`;
}

function pointColors(n) {
  return Array.from({length: n}, (_, i) => timeColor(n <= 1 ? 1 : i / (n - 1)));
}

// ── 格式工具 ──────────────────────────────────────
function fmtPct(v, digits = 1) {
  if (v == null) return '—';
  return (v >= 0 ? '+' : '') + v.toFixed(digits) + '%';
}

function metricCard(label, value, type = '') {
  const cls = type || (value == null ? 'na' : value > 0 ? 'pos' : value < 0 ? 'neg' : '');
  const txt = value == null ? 'N/A' : (type === 'gold' ? value.toFixed(1) + '%' : fmtPct(value));
  return `<div class="metric-card">
    <div class="metric-label">${label}</div>
    <div class="metric-value ${cls}">${txt}</div>
  </div>`;
}

// ── Toast ──────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

// ── 行业树 ────────────────────────────────────────
async function loadTree() {
  try {
    const res = await fetch(`${API}/industries/tree`);
    const data = await res.json();
    if (data.status !== 'success') throw new Error(data.error);
    renderTree(data.tree);
  } catch (e) {
    showToast('行业树加载失败：' + e.message);
  }
}

function renderTree(tree) {
  const container = document.getElementById('treeContainer');
  container.innerHTML = '';
  tree.forEach(l1 => {
    const l1Total = l1.children.reduce((s, l2) => s + l2.children.length, 0);
    const l1El = document.createElement('div');
    l1El.className = 'l1-node';

    const l1Header = document.createElement('div');
    l1Header.className = 'l1-header';
    l1Header.innerHTML = `
      <svg class="l1-caret" viewBox="0 0 12 12">
        <path d="M4 2 L9 6 L4 10" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="l1-label">${l1.name}</span>
      <span class="l1-count">${l1Total}</span>`;

    const l1Children = document.createElement('div');
    l1Children.className = 'l1-children';

    l1Header.addEventListener('click', () => {
      const open = l1Children.classList.toggle('open');
      l1Header.classList.toggle('open', open);
    });

    l1.children.forEach(l2 => {
      const l2El = document.createElement('div');
      l2El.className = 'l2-node';

      const l2Header = document.createElement('div');
      l2Header.className = 'l2-header';
      l2Header.innerHTML = `
        <svg class="l2-caret" viewBox="0 0 10 10">
          <path d="M3 1.5 L7.5 5 L3 8.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="l2-label">${l2.name}</span>`;

      const l2Children = document.createElement('div');
      l2Children.className = 'l2-children';

      l2Header.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = l2Children.classList.toggle('open');
        l2Header.classList.toggle('open', open);
      });

      l2.children.forEach(l3 => {
        const l3El = document.createElement('div');
        l3El.className = 'l3-item';
        l3El.textContent = l3;
        l3El.dataset.l3 = l3;
        l3El.addEventListener('click', (e) => {
          e.stopPropagation();
          selectIndustry(l3, l1.name, l2.name, l3El);
        });
        l2Children.appendChild(l3El);
      });

      l2El.appendChild(l2Header);
      l2El.appendChild(l2Children);
      l1Children.appendChild(l2El);
    });

    l1El.appendChild(l1Header);
    l1El.appendChild(l1Children);
    container.appendChild(l1El);
  });
}

// ── 搜索 ──────────────────────────────────────────
document.getElementById('searchInput').addEventListener('input', function() {
  const q = this.value.trim().toLowerCase();
  document.querySelectorAll('.l3-item').forEach(el => {
    const match = !q || el.textContent.includes(q);
    el.classList.toggle('hidden', !match);
  });
  // 自动展开含有匹配项的 l1/l2
  if (q) {
    document.querySelectorAll('.l2-children').forEach(el => {
      const hasVisible = el.querySelector('.l3-item:not(.hidden)');
      if (hasVisible) {
        el.classList.add('open');
        el.previousElementSibling.classList.add('open');
        el.closest('.l1-children').classList.add('open');
        el.closest('.l1-children').previousElementSibling.classList.add('open');
      }
    });
  }
});

// ── 选择行业 ──────────────────────────────────────
function selectIndustry(l3, l1, l2, el) {
  document.querySelectorAll('.l3-item.active').forEach(e => e.classList.remove('active'));
  el.classList.add('active');

  currentIndustry = l3;
  updateBreadcrumb(l1, l2, l3);
  document.getElementById('placeholder').style.display = 'none';
  document.getElementById('dashboardArea').style.display = 'block';
  loadIndustry(l3);
}

function updateBreadcrumb(l1, l2, l3) {
  document.getElementById('breadcrumb').innerHTML = `
    <span class="bc-l1">${l1}</span>
    <span class="bc-sep">›</span>
    <span class="bc-l2">${l2}</span>
    <span class="bc-sep">›</span>
    <span class="bc-l3">${l3}</span>`;
}

// ── 加载行业数据 ──────────────────────────────────
async function loadIndustry(name) {
  ['spin1','spin2','spin3'].forEach(id => document.getElementById(id).classList.add('show'));

  try {
    const res = await fetch(`${API}/analyze/${encodeURIComponent(name)}`);
    const data = await res.json();
    if (data.status !== 'success') throw new Error(data.error);

    renderSummary(data.summary, data.industry);
    renderChart1(data.chart1, data.industry);
    renderChart2(data.chart2, data.industry);
    renderChart3(data.chart3, data.industry);

    document.getElementById('topbarTime').textContent =
      data.summary?.latest_quarter ? `最新数据：${data.summary.latest_quarter}` : '';
  } catch (e) {
    showToast('数据获取失败：' + e.message);
  } finally {
    ['spin1','spin2','spin3'].forEach(id => document.getElementById(id).classList.remove('show'));
  }
}

// ── Summary ───────────────────────────────────────
function renderSummary(s, name) {
  if (!s) return;
  document.getElementById('summaryStrip').innerHTML =
    metricCard('毛利率', s.gross_margin, 'gold') +
    metricCard('毛利率3年差分', s.gross_margin_3y_diff) +
    metricCard('3年毛利率均值', s.gross_margin_geom3y, 'gold') +
    metricCard('Capex 3年CAGR', s.capex_cagr_3y) +
    metricCard('营收3年增速', s.rev_growth_3y) +
    metricCard('ROIC(简化)', s.roic) +
    metricCard('龙头优势', s.leader_advantage);
}

// ── 图表公共选项 ──────────────────────────────────
const AXIS_STYLE = {
  color: '#6b7590',
  font: { family: "'JetBrains Mono', monospace", size: 10 },
  grid: { color: 'rgba(255,255,255,.04)' },
  border: { color: 'rgba(255,255,255,.08)' },
};

const TOOLTIP_STYLE = {
  backgroundColor: '#12161e',
  borderColor: '#2a3348',
  borderWidth: 1,
  titleColor: '#c9a84c',
  bodyColor: '#9aa3b8',
  titleFont: { family: "'JetBrains Mono', monospace", size: 11 },
  bodyFont:  { family: "'JetBrains Mono', monospace", size: 11 },
  padding: 10,
  cornerRadius: 4,
};

function baseOptions(xLabel, yLabel) {
  return {
    responsive: true,
    maintainAspectRatio: false,
    animation: { duration: 400 },
    plugins: {
      legend: { display: false },
      datalabels: { display: false },
    },
    scales: {
      x: {
        title: { display: true, text: xLabel, color: '#6b7590',
                 font: { family: "'JetBrains Mono', monospace", size: 10 } },
        ...AXIS_STYLE,
      },
      y: {
        title: { display: true, text: yLabel, color: '#6b7590',
                 font: { family: "'JetBrains Mono', monospace", size: 10 } },
        ...AXIS_STYLE,
      },
    },
  };
}

function buildDataset(points, label, defaultR = 4) {
  const colors = pointColors(points.length);
  return {
    label,
    data: points,
    showLine: true,
    tension: 0.3,
    pointRadius: ctx => ctx.raw?.radius ?? defaultR,
    pointHoverRadius: ctx => (ctx.raw?.radius ?? defaultR) + 3,
    pointBackgroundColor: ctx => {
      const c = colors[ctx.dataIndex] ?? '#888';
      // 转成 rgba，80% 不透明，让重叠点可以透视
      return c.replace('rgb(', 'rgba(').replace(')', ',.82)');
    },
    pointBorderColor: ctx => {
      const c = colors[ctx.dataIndex] ?? '#888';
      return c.replace('rgb(', 'rgba(').replace(')', ',.4)');
    },
    pointBorderWidth: 0.8,
    borderColor: 'transparent',
    backgroundColor: 'transparent',
    borderWidth: 0,
    borderDash: [3, 4],
    segment: {
      borderColor: ctx => {
        const r = ctx.p1DataIndex / Math.max(points.length - 1, 1);
        return timeColor(r).replace('rgb', 'rgba').replace(')', ',.3)');
      },
      borderWidth: () => 1,
      borderDash: () => [3, 4],
    },
  };
}

// ── Chart 1 ───────────────────────────────────────
function renderChart1(points, name) {
  const ctx = document.getElementById('chart1').getContext('2d');
  if (charts.c1) charts.c1.destroy();
  const opts = baseOptions('Capex 三年复合增速 (%)', '毛利率三年差分 (%)');
  opts.plugins.tooltip = {
    ...TOOLTIP_STYLE,
    callbacks: {
      title: ctx => [`${name}  ${ctx[0].raw.quarter}`],
      label: ctx => {
        const p = ctx.raw;
        const rows = [
          `Capex CAGR : ${p.x?.toFixed(2) ?? '—'}%`,
          `毛利率差分  : ${p.y?.toFixed(2) ?? '—'}%`,
        ];
        if (p.value != null) rows.push(`ROIC       : ${p.value.toFixed(2)}%`);
        return rows;
      },
    },
  };
  charts.c1 = new Chart(ctx, {
    type: 'scatter',
    data: { datasets: [buildDataset(points, name)] },
    options: opts,
  });
}

// ── Chart 2 ───────────────────────────────────────
function renderChart2(points, name) {
  const ctx = document.getElementById('chart2').getContext('2d');
  if (charts.c2) charts.c2.destroy();
  const opts = baseOptions('Capex 增速分位', '营收增速分位');
  opts.scales.x.min = 0; opts.scales.x.max = 100;
  opts.scales.y.min = 0; opts.scales.y.max = 100;
  // 四象限参考线
  opts.plugins.annotation = undefined;
  opts.plugins.tooltip = {
    ...TOOLTIP_STYLE,
    callbacks: {
      title: ctx => [`${name}  ${ctx[0].raw.quarter}`],
      label: ctx => {
        const p = ctx.raw;
        return [
          `Capex分位  : ${p.x?.toFixed(0) ?? '—'}`,
          `营收分位   : ${p.y?.toFixed(0) ?? '—'}`,
        ];
      },
    },
  };
  charts.c2 = new Chart(ctx, {
    type: 'scatter',
    data: { datasets: [buildDataset(points, name, 5)] },
    options: opts,
  });
}

// ── Chart 3 ───────────────────────────────────────
function renderChart3(points, name) {
  const ctx = document.getElementById('chart3').getContext('2d');
  if (charts.c3) charts.c3.destroy();
  const opts = baseOptions('三年复合营收增速 (%)', '毛利率三年几何均值 (%)');
  opts.plugins.tooltip = {
    ...TOOLTIP_STYLE,
    callbacks: {
      title: ctx => [`${name}  ${ctx[0].raw.quarter}`],
      label: ctx => {
        const p = ctx.raw;
        const rows = [
          `营收增速   : ${p.x?.toFixed(2) ?? '—'}%`,
          `毛利率均值 : ${p.y?.toFixed(2) ?? '—'}%`,
        ];
        if (p.value != null) rows.push(`龙头优势   : ${p.value.toFixed(2)}%`);
        return rows;
      },
    },
  };
  charts.c3 = new Chart(ctx, {
    type: 'scatter',
    data: { datasets: [buildDataset(points, name)] },
    options: opts,
  });
}

// ── Init ──────────────────────────────────────────
loadTree();
