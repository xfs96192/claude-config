#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""行业生命周期分析系统（网站展示层）

该服务仅负责读取预先计算好的行业指标数据并为前端提供接口，不再连接 Wind
或执行指标计算逻辑。指标数据由 `industry_metrics.py` 生成并写入 CSV。
"""

from __future__ import annotations

import logging
import math
import os
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Dict, List

import numpy as np
import pandas as pd
from flask import Flask, jsonify

try:  # optional dependency; fallback to no-CORS mode if missing locally
    from flask_cors import CORS  # type: ignore
except ImportError:  # pragma: no cover - fallback only hits in minimal envs
    CORS = None  # placeholder, patched to no-op after logger is configured

# -----------------------------------------------------------------------------
# 配置
# -----------------------------------------------------------------------------
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

if CORS is None:  # provide no-op implementation while提醒使用者安装依赖
    def _noop_cors(app):  # type: ignore
        logger.warning("flask_cors 未安装，跨域支持已禁用。请运行 `pip install Flask-CORS` 以启用。")
        return app

    CORS = _noop_cors  # type: ignore

BASE_DIR = Path(__file__).resolve().parent
DEFAULT_CSV_PATH = BASE_DIR / "industry_metrics.csv"
METRICS_CSV = Path(os.environ.get("INDUSTRY_METRICS_CSV", DEFAULT_CSV_PATH))

# 指标列配置：用于统一转为 float 并指定百分比转换
NUMERIC_COLUMNS: List[str] = [
    "gross_margin",
    "gross_margin_3y_diff",
    "capex_cagr_3y",
    "roic",
    "rev_growth_3y",
    "rev_growth_percentile",
    "capex_cagr_percentile",
    "gross_margin_geom3y",
    "leader_margin",
    "leader_advantage",
    "revenue_sum",
    "capex_sum",
    "equity_sum",
    "debt_sum",
]

PERCENT_COLUMNS = {
    "gross_margin_3y_diff",
    "capex_cagr_3y",
    "roic",
    "rev_growth_3y",
    "gross_margin_geom3y",
    "leader_margin",
    "leader_advantage",
}

PERCENTILE_COLUMNS = {
    "rev_growth_percentile",
    "capex_cagr_percentile",
}


@dataclass
class IndustryMetrics:
    dataframe: pd.DataFrame
    loaded_at: datetime


class MetricsRepository:
    """简单的 CSV 数据仓库，支持按文件修改时间自动刷新缓存。"""

    def __init__(self, csv_path: Path):
        self.csv_path = csv_path
        self._cache: IndustryMetrics | None = None
        self._last_mtime: float | None = None

    def load(self) -> IndustryMetrics:
        if not self.csv_path.exists():
            raise FileNotFoundError(f"指标数据文件不存在: {self.csv_path}")

        current_mtime = self.csv_path.stat().st_mtime
        if self._cache is None or self._last_mtime != current_mtime:
            df = pd.read_csv(self.csv_path)
            df = self._prepare_dataframe(df)
            self._cache = IndustryMetrics(df, datetime.now())
            self._last_mtime = current_mtime
            logger.info("Loaded metrics from %s (rows=%d)", self.csv_path, len(df))
        return self._cache

    @staticmethod
    def _prepare_dataframe(df: pd.DataFrame) -> pd.DataFrame:
        df = df.copy()
        df["Accper"] = pd.to_datetime(df["Accper"], errors="coerce")
        df = df.dropna(subset=["IndustryName", "Accper"])
        for col in NUMERIC_COLUMNS:
            if col in df.columns:
                df[col] = pd.to_numeric(df[col], errors="coerce")
        df = df.sort_values(["IndustryName", "Accper"]).reset_index(drop=True)
        df["quarter_label"] = df["Accper"].dt.to_period("Q").astype(str)
        return df


repo = MetricsRepository(METRICS_CSV)
app = Flask(__name__, static_folder="static", static_url_path="/static")
CORS(app)


def _sanitize_json(obj):
    """递归将 NaN / Inf 替换为 None，确保输出合法 JSON。"""
    if isinstance(obj, float):
        return None if not math.isfinite(obj) else obj
    if isinstance(obj, dict):
        return {k: _sanitize_json(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_sanitize_json(v) for v in obj]
    return obj


def _scale_series(series: pd.Series, multiplier: float) -> pd.Series:
    return (series.astype(float) * multiplier).round(4)


def _to_grayscale_palette(count: int) -> List[str]:
    if count <= 1:
        return ["#000000"]
    palette = []
    for idx in range(count):
        ratio = idx / (count - 1)
        value = int(round(255 * (1 - ratio)))
        palette.append(f"#{value:02x}{value:02x}{value:02x}")
    return palette


def _build_chart_points(
    industry_df: pd.DataFrame,
    x_col: str,
    y_col: str,
    size_col: str | None = None,
    percent_cols: set[str] | None = None,
    percentile_cols: set[str] | None = None,
) -> List[Dict[str, float]]:
    percent_cols = percent_cols or set()
    percentile_cols = percentile_cols or set()

    cols = [c for c in {x_col, y_col, size_col} if c]
    data = industry_df.dropna(subset=cols).copy()
    if data.empty:
        return []

    if x_col in percent_cols:
        data[x_col] = _scale_series(data[x_col], 100)
    elif x_col in percentile_cols:
        data[x_col] = _scale_series(data[x_col], 100)

    if y_col in percent_cols:
        data[y_col] = _scale_series(data[y_col], 100)
    elif y_col in percentile_cols:
        data[y_col] = _scale_series(data[y_col], 100)

    if size_col:
        if size_col in percent_cols:
            data[size_col] = _scale_series(data[size_col], 100)
        else:
            data[size_col] = data[size_col].astype(float)

    colors = _to_grayscale_palette(len(data))
    points: List[Dict[str, float]] = []
    for idx, (_, row) in enumerate(data.iterrows()):
        point = {
            "x": float(row[x_col]),
            "y": float(row[y_col]),
            "quarter": row["quarter_label"],
            "color": colors[idx],
        }
        if size_col:
            value = float(row[size_col])
            if size_col == "roic":
                value = float(np.clip(value, -500, 500))
            elif size_col == "leader_advantage":
                value = float(np.clip(value, -100, 100))
            point["value"] = round(value, 2)
            # 以平方根缩放点大小，限制在3-14之间，避免极端值
            radius = max(3.0, min(14.0, np.sqrt(abs(value)) * 1.5))
            point["radius"] = round(radius, 2)
        points.append(point)
    return points


def _build_summary(industry_df: pd.DataFrame) -> Dict[str, float]:
    latest = industry_df.iloc[-1]
    summary = {
        "latest_quarter": latest["quarter_label"],
        "gross_margin": float(latest.get("gross_margin", np.nan)),
        "gross_margin_3y_diff": float(latest.get("gross_margin_3y_diff", np.nan)),
        "capex_cagr_3y": float(latest.get("capex_cagr_3y", np.nan)),
        "roic": float(latest.get("roic", np.nan)),
        "rev_growth_3y": float(latest.get("rev_growth_3y", np.nan)),
        "gross_margin_geom3y": float(latest.get("gross_margin_geom3y", np.nan)),
        "leader_advantage": float(latest.get("leader_advantage", np.nan)),
    }
    for key in {
        "gross_margin_3y_diff",
        "capex_cagr_3y",
        "roic",
        "rev_growth_3y",
        "gross_margin_geom3y",
        "leader_advantage",
    }:
        if not np.isnan(summary[key]):
            summary[key] = round(summary[key] * 100, 2)
    if not np.isnan(summary["gross_margin"]):
        summary["gross_margin"] = round(summary["gross_margin"] * 100, 2)
    return summary


@app.route("/")
def index():
    return app.send_static_file("index.html")


@app.route("/api/industries")
def get_industries():
    try:
        metrics = repo.load()
        industries = metrics.dataframe["IndustryName"].dropna().unique()
        industries = sorted(industries.tolist())
        return jsonify({
            "status": "success",
            "industries": industries,
            "timestamp": metrics.loaded_at.isoformat(),
            "source": str(METRICS_CSV),
        })
    except Exception as exc:
        logger.exception("Failed to load industries")
        return jsonify({
            "status": "error",
            "error": str(exc),
        }), 500


@app.route("/api/analyze/<industry_name>")
def analyze_industry(industry_name: str):
    try:
        metrics = repo.load()
        df = metrics.dataframe
        industry_df = df[df["IndustryName"] == industry_name].copy()
        if industry_df.empty:
            return jsonify({
                "status": "error",
                "error": f"未找到行业: {industry_name}",
            }), 404

        chart1 = _build_chart_points(
            industry_df,
            x_col="capex_cagr_3y",
            y_col="gross_margin_3y_diff",
            size_col="roic",
            percent_cols=PERCENT_COLUMNS,
            percentile_cols=PERCENTILE_COLUMNS,
        )
        chart2 = _build_chart_points(
            industry_df,
            x_col="capex_cagr_percentile",
            y_col="rev_growth_percentile",
            percent_cols=PERCENT_COLUMNS,
            percentile_cols=PERCENTILE_COLUMNS,
        )
        chart3 = _build_chart_points(
            industry_df,
            x_col="rev_growth_3y",
            y_col="gross_margin_geom3y",
            size_col="leader_advantage",
            percent_cols=PERCENT_COLUMNS,
            percentile_cols=PERCENTILE_COLUMNS,
        )

        result = {
            "status": "success",
            "industry": industry_name,
            "chart1": chart1,
            "chart2": chart2,
            "chart3": chart3,
            "summary": _build_summary(industry_df),
            "timestamp": datetime.now().isoformat(),
        }
        return jsonify(_sanitize_json(result))
    except Exception as exc:
        logger.exception("Failed to analyze industry")
        return jsonify({
            "status": "error",
            "error": str(exc),
        }), 500


@app.route("/api/health")
def health():
    try:
        metrics = repo.load()
        df = metrics.dataframe
        return jsonify({
            "status": "healthy",
            "industries": int(df["IndustryName"].nunique()),
            "observations": int(len(df)),
            "last_quarter": df["quarter_label"].max(),
            "loaded_at": metrics.loaded_at.isoformat(),
            "source": str(METRICS_CSV),
        })
    except FileNotFoundError as exc:
        return jsonify({
            "status": "unavailable",
            "error": str(exc),
        }), 503
    except Exception as exc:
        logger.exception("Health check failed")
        return jsonify({
            "status": "error",
            "error": str(exc),
        }), 500


if __name__ == "__main__":
    app.run(debug=True, host="0.0.0.0", port=8080)
