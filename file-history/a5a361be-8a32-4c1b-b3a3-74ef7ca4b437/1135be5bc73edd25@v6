def _sanitize_json(obj):
    """递归将 NaN / Inf 替换为 None，确保输出合法 JSON。"""
    if isinstance(obj, float):
        return None if not math.isfinite(obj) else obj
    if isinstance(obj, dict):
        return {k: _sanitize_json(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_sanitize_json(v) for v in obj]
    return obj


def _scale_series(series: pd.Series, multiplier: float) -> pd.Series:
    return (series.astype(float) * multiplier).round(4)


def _compute_radii(values: pd.Series) -> pd.Series:
    """将 size 列的绝对值按分位数归一化到 [RADIUS_MIN, RADIUS_MAX]。
    使用第5和第95百分位裁剪极端值，确保气泡大小差异清晰可见。
    """
    abs_vals = values.abs()
    lo = abs_vals.quantile(0.05)
    hi = abs_vals.quantile(0.95)
    if hi <= lo:
        return pd.Series([float((RADIUS_MIN + RADIUS_MAX) / 2)] * len(values), index=values.index)
    clipped = abs_vals.clip(lo, hi)
    normalized = (clipped - lo) / (hi - lo)  # 0~1
    return normalized * (RADIUS_MAX - RADIUS_MIN) + RADIUS_MIN


def _build_chart_points(
    industry_df: pd.DataFrame,
    x_col: str,
    y_col: str,
    size_col: str | None = None,
    percent_cols: set[str] | None = None,
    percentile_cols: set[str] | None = None,
) -> List[Dict]:
    percent_cols = percent_cols or set()
    percentile_cols = percentile_cols or set()

    # 对于有 size_col 的图，x/y 允许 size=NaN（仍展示点，但不显示气泡大小）
    required_cols = [c for c in [x_col, y_col] if c]
    data = industry_df.dropna(subset=required_cols).copy()
    if data.empty:
        return []

    # 缩放 x / y
    for col in [x_col, y_col]:
        if col in percent_cols:
            data[col] = _scale_series(data[col], 100)
        elif col in percentile_cols:
            data[col] = _scale_series(data[col], 100)

    # 缩放并归一化 size
    radii: pd.Series | None = None
    if size_col:
        if size_col in percent_cols:
            data[size_col] = _scale_series(data[size_col], 100)
        size_valid = data[size_col].dropna()
        if len(size_valid) > 1:
            radii = _compute_radii(data[size_col])
        else:
            radii = pd.Series([(RADIUS_MIN + RADIUS_MAX) / 2] * len(data), index=data.index)

    points: List[Dict] = []
    for _, row in data.iterrows():
        point: Dict = {
            "x": float(row[x_col]),
            "y": float(row[y_col]),
            "quarter": row["quarter_label"],
        }
        if size_col and radii is not None:
            raw_val = row[size_col]
            point["value"] = None if (isinstance(raw_val, float) and not math.isfinite(raw_val)) else round(float(raw_val), 2)
            r = radii.loc[row.name]
            point["radius"] = round(float(r) if math.isfinite(float(r)) else float((RADIUS_MIN + RADIUS_MAX) / 2), 2)
        points.append(point)
    return points


def _build_summary(industry_df: pd.DataFrame) -> Dict:
    latest = industry_df.iloc[-1]

    def pct(key: str) -> float | None:
        v = latest.get(key)
        if v is None or (isinstance(v, float) and not math.isfinite(v)):
            return None
        return round(float(v) * 100, 2)

    def raw(key: str) -> float | None:
        v = latest.get(key)
        if v is None or (isinstance(v, float) and not math.isfinite(v)):
            return None
        return round(float(v) * 100, 2)

    def ratio(key: str) -> float | None:
        """Return a raw ratio value (not ×100), rounded to 4 dp."""
        v = latest.get(key)
        if v is None or (isinstance(v, float) and not math.isfinite(v)):
            return None
        return round(float(v), 4)

    return {
        "latest_quarter": latest["quarter_label"],
        "gross_margin": raw("gross_margin"),
        "gross_margin_3y_diff": pct("gross_margin_3y_diff"),
        "capex_cagr_3y": pct("capex_cagr_3y"),
        "roic": pct("roic"),
        "rev_growth_3y": pct("rev_growth_3y"),
        "gross_margin_geom3y": pct("gross_margin_geom3y"),
        "leader_advantage": pct("leader_advantage"),
        # New metrics
        "capex_da_ratio": ratio("capex_da_ratio"),
        "ocf_to_rev": pct("ocf_to_rev"),
        "net_margin": pct("net_margin"),
        "fixed_asset_ratio": pct("fixed_asset_ratio"),
    }


