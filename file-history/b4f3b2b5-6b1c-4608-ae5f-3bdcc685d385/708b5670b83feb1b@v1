        '基金申购', '否', '', '', '基金池', '', '', '', '', '', '', ''
      ]);
    } else if (t.tradeType === '赎回') {
      const shares = parseFloat((t.amount * 10000 / t.nav).toFixed(2));
      rows.push([
        t.dateSerial, t.productCode, '', '', t.code, '赎回', '外部', '',
        '', '份额投资', shares, '', '', '', '',
