// ─── Generate both ───────────────────────────────────────────────────────────
function generateBoth() {
  const otcTx = transactions.filter(t => t.isOTC);
  const exTx = transactions.filter(t => t.isExchange);
  const missingNav = otcTx.filter(t => t.tradeType === '赎回' && !t.nav);

  if (missingNav.length > 0) {
    showMsg('generateMsg', `⚠️ 以下赎回订单尚未填写净值：<br>• ${missingNav.map(t=>t.assetName+'('+t.code+')').join('<br>• ')}`, 'error');
    return;
  }

  let msgs = [];
  if (otcTx.length > 0) { generateOTC_silent(otcTx, msgs); }
  if (exTx.length > 0) { generateExchange_silent(exTx, msgs); }

  if (msgs.length > 0) {
    showMsg('generateMsg', '✅ 文件生成成功：<br>' + msgs.join('<br>'), 'success');
  } else {
    showMsg('generateMsg', '当前数据中没有可生成的交易', 'warn');
  }
}

