<body>

<div class="header">
  <div class="logo">📊</div>
  <div>
    <h1>基金下单工具</h1>
    <div class="subtitle">场外基金 · 交易所证券 · 自动分类下单</div>
  </div>
</div>

<div class="main">

  <!-- Step 1: Paste Data -->
  <div class="card">
    <div class="card-title"><span class="step-label">1</span>粘贴交易数据</div>
    <textarea id="inputData" placeholder="请从交易表格中复制数据并粘贴到此处（支持从Excel直接粘贴，列与列之间用Tab分隔）

格式：日期 [Tab] 产品名称 [Tab] 交易类型 [Tab] 基金代码 [Tab] 基金名称 [Tab] 金额 [Tab] 万 [Tab] 产品代码 [Tab] 持仓变动(可选)

示例：
2026/3/17	逸动3个月最短持有期增强型	申购	016841.OF	博道惠泰优选C	35	万	9K706130	1200
2026/3/17	逸动6个月最短持有期增强型	赎回	015364.OF	汇丰晋信价值先锋C	50	万	9K706130	-1600
2026/3/17	丰利逸动1个月最短持有期日开1号增强型	卖出	513010.SH	易方达恒生科技ETF	80	万	9K717810	-6700"></textarea>
    <div class="hint">
      ⓘ <b>.OF</b> 结尾 → 场外基金（申购/赎回） &nbsp;|&nbsp; <b>.SH/.SZ</b> 结尾 → 场内交易所（买入/卖出）<br>
      &nbsp;&nbsp; 赎回订单需在下方填写基金净值，系统将自动计算赎回份额
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="parseBtn" onclick="parseData()">🔍 解析交易数据</button>
      <button class="btn btn-gray" onclick="clearAll()">🗑 清空</button>
    </div>
    <div id="parseError"></div>
  </div>

  <!-- Step 2: Preview & NAV Input -->
  <div class="card" id="previewCard" style="display:none">
    <div class="card-title"><span class="step-label">2</span>交易预览 &amp; 净值填写</div>
    <div id="statsRow" class="stats-row"></div>
    <div id="navWarning" class="warning-box" style="display:none">
      ⚠️ 以下赎回订单需要填写基金净值（NAV），系统将自动计算赎回份额 = 金额 ÷ 净值
    </div>
    <div class="table-wrap">
      <table id="previewTable">
        <thead>
          <tr>
            <th>#</th>
            <th>日期</th>
            <th>产品名称</th>
            <th>产品代码</th>
            <th>交易类型</th>
            <th>基金/资产代码</th>
            <th>基金/资产名称</th>
            <th>金额（万元）</th>
            <th>渠道</th>
            <th>基金净值 (NAV)</th>
            <th>赎回份额</th>
          </tr>
        </thead>
        <tbody id="previewBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Step 3: Generate -->
  <div class="card" id="generateCard" style="display:none">
    <div class="card-title"><span class="step-label">3</span>生成下单文件</div>

    <!-- 推荐方式：Python后端（格式完全一致） -->
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:14px 16px;margin-bottom:14px">
      <div style="font-weight:600;color:#166534;margin-bottom:6px">⭐ 推荐方式：格式 100% 与模版一致（.xls）</div>
      <div style="font-size:13px;color:#166534;line-height:1.7">
        1. 点击「<b>导出交易数据JSON</b>」，将文件保存到 <code style="background:#dcfce7;padding:1px 5px;border-radius:3px">基金下单</code> 文件夹<br>
        2. 告诉 Claude「请帮我生成下单Excel」<br>
        3. Claude 将自动运行 Python 脚本，直接在文件夹生成格式完全一致的 <b>.xls</b> 文件
      </div>
    </div>
    <div class="btn-row" style="margin-bottom:16px">
      <button class="btn btn-success" onclick="exportJSON()">
        📄 导出交易数据JSON（推荐）
      </button>
    </div>

    <div style="border-top:1px solid #e5e7eb;margin:16px 0;padding-top:14px">
      <div style="font-size:12px;color:#94a3b8;margin-bottom:10px">备用方式：直接在浏览器下载 .xlsx（表头文字与模版一致，颜色为默认格式）</div>
      <div class="btn-row">
        <button class="btn btn-orange" onclick="generateOTC()">⬇ 场外基金下单 (.xlsx)</button>
        <button class="btn btn-gray" onclick="generateExchange()">⬇ 交易所证券投资委托 (.xlsx)</button>
      </div>
    </div>
    <div id="generateMsg"></div>
  </div>

</div>

<script>
// ─── Global state ───────────────────────────────────────────────────────────
let transactions = [];

// ─── Date utilities ─────────────────────────────────────────────────────────
function dateToSerial(str) {
  str = str.trim();
  if (!str) return 0;
  // Try common date formats
  let m;
  if (m = str.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/)) {
    const d = new Date(+m[1], +m[2]-1, +m[3]);
    return Math.round((d - new Date(1899, 11, 30)) / 86400000);
  }
  // Excel serial number
  const n = parseFloat(str);
  if (!isNaN(n) && n > 30000) return n;
  return 0;
}

function serialToDateStr(serial) {
  if (!serial) return '';
  const d = new Date(Math.round((serial - 25569) * 86400 * 1000));
  // Adjust for timezone
  const utc = new Date(d.getTime() + d.getTimezoneOffset() * 60000);
  return `${utc.getFullYear()}/${utc.getMonth()+1}/${utc.getDate()}`;
}

function parseInputDateStr(str) {
  str = str.trim();
  let m;
  if (m = str.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/)) {
    return `${m[1]}/${m[2]}/${m[3]}`;
  }
  const n = parseFloat(str);
  if (!isNaN(n) && n > 30000) return serialToDateStr(n);
  return str;
}

// ─── Parse pasted data ───────────────────────────────────────────────────────
function parseData() {
  const raw = document.getElementById('inputData').value.trim();
  document.getElementById('parseError').innerHTML = '';

  if (!raw) {
    showError('parseError', '请先粘贴交易数据');
    return;
  }

  const lines = raw.split('\n').map(l => l.trim()).filter(l => l);
  const results = [];
  const errors = [];

  lines.forEach((line, idx) => {
    // Split by tab; fallback to multiple spaces
    let cols = line.split('\t');
    if (cols.length < 8) {
      // Try splitting on multiple spaces (≥2)
      cols = line.split(/\s{2,}/);
    }
    // Remove empty trailing cols
    while (cols.length > 0 && cols[cols.length-1].trim() === '') cols.pop();

    if (cols.length < 8) {
      errors.push(`第${idx+1}行数据不完整（期望至少8列，实际${cols.length}列）：${line.substring(0,60)}`);
      return;
    }

    const dateRaw = cols[0].trim();
    const productName = cols[1].trim();
    const tradeType = cols[2].trim();
    const code = cols[3].trim();
    const assetName = cols[4].trim();
    // Amount: remove non-breaking space, regular space, and "万" if included
    let amountRaw = cols[5].trim().replace(/\xa0/g, '').replace(/万/g,'').trim();
    // cols[6] might be "万" unit (skip it)
    const productCode = cols[7].trim();

    const amount = parseFloat(amountRaw);
    if (isNaN(amount)) {
      errors.push(`第${idx+1}行金额无法解析："${cols[5]}"`);
      return;
    }

    const valid = ['申购','赎回','买入','卖出'];
    if (!valid.includes(tradeType)) {
      errors.push(`第${idx+1}行交易类型未识别："${tradeType}"，支持：申购/赎回/买入/卖出`);
      return;
    }

    const codeUpper = code.toUpperCase();
    const isOTC = codeUpper.endsWith('.OF');
    const isExchange = codeUpper.endsWith('.SH') || codeUpper.endsWith('.SZ');

    if (!isOTC && !isExchange) {
      errors.push(`第${idx+1}行基金代码无法识别（应以.OF/.SH/.SZ结尾）："${code}"`);
      return;
    }

    // Validate logic
    if (isOTC && tradeType === '卖出') {
      errors.push(`第${idx+1}行：场外基金(.OF)不能使用"卖出"，应使用"赎回"`);
      return;
    }
    if (isExchange && tradeType === '赎回') {
      errors.push(`第${idx+1}行：场内基金(.SH/.SZ)不能使用"赎回"，应使用"卖出"`);
      return;
    }
    if (isExchange && tradeType === '申购') {
      errors.push(`第${idx+1}行：场内基金(.SH/.SZ)不能使用"申购"，应使用"买入"`);
      return;
    }

    results.push({
      id: idx + 1,
      dateRaw,
      dateStr: parseInputDateStr(dateRaw),
      dateSerial: dateToSerial(dateRaw),
      productName,
      productCode,
      tradeType,
      code,
      assetName,
      amount,       // in 万
      isOTC,
      isExchange,
      nav: null,    // filled by user for 赎回
      navInputId: `nav_${idx}`
    });
  });

  if (results.length === 0) {
    let msg = '未能解析任何有效交易数据。';
    if (errors.length > 0) msg += `<br><br>错误详情：<br>• ${errors.join('<br>• ')}`;
    showError('parseError', msg);
    return;
  }

  transactions = results;
  renderPreview();

  if (errors.length > 0) {
    showError('parseError', `⚠️ 以下${errors.length}行解析失败：<br>• ${errors.join('<br>• ')}`);
  }
}

// ─── Render preview table ────────────────────────────────────────────────────
function renderPreview() {
  const tbody = document.getElementById('previewBody');
  tbody.innerHTML = '';

  const otcCount = transactions.filter(t => t.isOTC).length;
  const exCount = transactions.filter(t => t.isExchange).length;
  const redeemCount = transactions.filter(t => t.tradeType === '赎回').length;

  // Stats
  document.getElementById('statsRow').innerHTML = `
    <div class="stat-box"><div class="num">${transactions.length}</div><div class="label">总笔数</div></div>
    <div class="stat-box"><div class="num" style="color:#16a34a">${otcCount}</div><div class="label">场外基金(.OF)</div></div>
    <div class="stat-box"><div class="num" style="color:#ea580c">${exCount}</div><div class="label">场内证券(.SH/.SZ)</div></div>
    <div class="stat-box"><div class="num" style="color:#9333ea">${redeemCount}</div><div class="label">需填净值(赎回)</div></div>
  `;

  document.getElementById('navWarning').style.display = redeemCount > 0 ? '' : 'none';

  transactions.forEach(t => {
    const tr = document.createElement('tr');

    const typeBadge = {
      '申购': '<span class="badge badge-green">申购</span>',
      '赎回': '<span class="badge badge-red">赎回</span>',
      '卖出': '<span class="badge badge-orange">卖出</span>',
      '买入': '<span class="badge badge-blue">买入</span>',
    }[t.tradeType] || t.tradeType;

    const channelBadge = t.isOTC
      ? '<span class="badge badge-blue">场外</span>'
      : '<span class="badge badge-orange">场内</span>';

    const isRedeem = t.tradeType === '赎回';
    const navCell = isRedeem
      ? `<div><input class="nav-input" id="${t.navInputId}" type="number" step="0.0001" min="0.0001"
              placeholder="输入净值" oninput="updateShares('${t.navInputId}', ${t.id})"></div>
         <div class="nav-tip">Wind获取后填入</div>`
      : '<span style="color:#cbd5e1">—</span>';

    const sharesCell = isRedeem
      ? `<div id="shares_${t.id}" style="color:#94a3b8;font-size:12px">待填净值</div>`
      : '<span style="color:#cbd5e1">—</span>';

    tr.innerHTML = `
      <td style="color:#94a3b8">${t.id}</td>
      <td>${t.dateStr}</td>
      <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${t.productName}">${t.productName}</td>
      <td class="code-cell">${t.productCode}</td>
      <td>${typeBadge}</td>
      <td class="code-cell">${t.code}</td>
      <td>${t.assetName}</td>
      <td class="amount-display">${t.amount.toLocaleString()} 万</td>
      <td>${channelBadge}</td>
      <td>${navCell}</td>
      <td>${sharesCell}</td>
    `;
    tbody.appendChild(tr);
  });

  document.getElementById('previewCard').style.display = '';
  document.getElementById('generateCard').style.display = '';
}

// ─── Update share preview on NAV input ──────────────────────────────────────
function updateShares(inputId, txId) {
  const input = document.getElementById(inputId);
  const sharesDiv = document.getElementById(`shares_${txId}`);
  const nav = parseFloat(input.value);
  const tx = transactions.find(t => t.id === txId);
  if (!tx) return;

  if (isNaN(nav) || nav <= 0) {
    input.classList.add('error');
    sharesDiv.innerHTML = '<span style="color:#ef4444;font-size:12px">净值无效</span>';
    tx.nav = null;
    return;
  }
  input.classList.remove('error');
  tx.nav = nav;
  const shares = (tx.amount * 10000 / nav);
  sharesDiv.innerHTML = `<span class="shares-preview">≈ ${shares.toLocaleString('zh-CN', {maximumFractionDigits: 2})} 份</span>`;
}

// ─── Generate OTC Excel ──────────────────────────────────────────────────────
function generateOTC() {
  const otcTx = transactions.filter(t => t.isOTC);
  if (otcTx.length === 0) {
    showMsg('generateMsg', '当前数据中没有场外基金(.OF)交易', 'warn');
    return;
  }

  // Check all redemptions have NAV
  const missing = otcTx.filter(t => t.tradeType === '赎回' && !t.nav);
  if (missing.length > 0) {
    showMsg('generateMsg', `⚠️ 以下赎回订单尚未填写净值，请先填写后再生成：<br>• ${missing.map(t=>t.assetName+'('+t.code+')').join('<br>• ')}`, 'error');
    return;
  }

  const wb = XLSX.utils.book_new();
  const headers = [
    '交易日期','产品代码*','申购代码','组合代码','基金代码*','交易类型*',
    '交易对手类型*','交易对手','分红设置','投资方式*','投资份额','投资金额','认购价格',
    '下一业务授权审批人','终批人','业务送审说明','是否纳入全行统一授信*','风险审批通知书编号',
    '下柜流水号','投资模式','切分审批通知书编号','子策略名称','母策略名称','销售机构',
    '转入基金代码','巨额赎回标识','全额转出'
  ];

  const rows = [headers];

  otcTx.forEach(t => {
    const amountYuan = Math.round(t.amount * 10000);
    if (t.tradeType === '申购') {
      rows.push([
        t.dateSerial, t.productCode, '', '', t.code, '申购', '外部', '',
