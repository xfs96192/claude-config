  // Column widths
  ws['!cols'] = [
    {wch:12},{wch:12},{wch:10},{wch:10},{wch:14},{wch:8},
    {wch:10},{wch:10},{wch:10},{wch:10},{wch:12},{wch:12},{wch:10},
    {wch:16},{wch:10},{wch:10},{wch:18},{wch:16},
    {wch:12},{wch:10},{wch:16},{wch:12},{wch:12},{wch:12},
    {wch:14},{wch:12},{wch:10}
  ];

  XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');
  const today = new Date();
  const fname = `场外基金下单_${today.getFullYear()}${String(today.getMonth()+1).padStart(2,'0')}${String(today.getDate()).padStart(2,'0')}.xlsx`;
  XLSX.writeFile(wb, fname);
  showMsg('generateMsg', `✅ 场外基金下单文件已生成：${fname}（${otcTx.length}笔交易）`, 'success');
}

