  }
  .nav-tip {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 2px;
  }
  .nav-tip.from-pos { color: #16a34a; font-weight: 500; }
  .table-wrap { overflow-x: auto; }
  .amount-display { font-weight: 500; color: #1e3a5f; }
  .code-cell { font-family: Consolas, monospace; font-size: 12px; }
  #parseBtn { margin-top: 12px; }
  .step-label {
    font-size: 11px;
    background: #2d6bb5;
