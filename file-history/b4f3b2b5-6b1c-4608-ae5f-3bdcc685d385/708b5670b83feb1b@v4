<body>

<!-- CDN check banner (shown if XLSX fails to load) -->
<div id="xlsxBanner" class="cdn-warn" style="display:none;margin:0;border-radius:0;border-left:none;border-bottom:1px solid #fde68a;">
  ⚠️ <b>SheetJS 库未加载</b> — 浏览器无法访问外部CDN（cdnjs.cloudflare.com）。
  浏览器端 Excel 上传与下载功能不可用。请使用 <b>「导出交易数据JSON」</b> + Python脚本 的方式生成下单文件。
</div>

<div class="header">
  <div class="logo">📊</div>
  <div>
    <h1>基金下单工具</h1>
    <div class="subtitle">场外基金 · 交易所证券 · 自动分类下单 · 持仓校验</div>
  </div>
</div>

<div class="main">

  <!-- Step 0: Upload position file -->
  <div class="card">
    <div class="card-title"><span class="step-label">0</span>上传持仓盈亏表（推荐）</div>
    <p style="font-size:13px;color:#475569;margin-bottom:14px;line-height:1.7">
      上传持仓盈亏明细Excel后，系统将自动：<br>
      &nbsp;&nbsp;① <b>自动填充基金净值</b>（使用「日终全价（元）-产品法估值」字段）<br>
      &nbsp;&nbsp;② <b>校验卖出/赎回份额是否充足</b>，份额不足时发出警告<br>
      &nbsp;&nbsp;③ <b>支持金额填写"全部"</b>，自动获取全部持仓份额
    </p>
    <div class="pos-upload-area" id="posUploadArea" onclick="document.getElementById('posFileInput').click()">
      <input type="file" id="posFileInput" class="pos-file-input" accept=".xlsx,.xls" onchange="loadPositionFile(this.files[0])">
      <div style="font-size:32px;margin-bottom:8px">📂</div>
      <div style="font-size:14px;color:#6b7280">点击选择文件，或将持仓盈亏明细.xlsx拖拽到此处</div>
      <div style="font-size:12px;color:#9ca3af;margin-top:4px">支持 .xlsx / .xls 格式</div>
    </div>
    <div id="positionStatus" class="pos-status"></div>
  </div>

  <!-- Step 1: Paste Data -->
  <div class="card">
    <div class="card-title"><span class="step-label">1</span>粘贴交易数据</div>
    <textarea id="inputData" placeholder="请从交易表格中复制数据并粘贴到此处（支持从Excel直接粘贴，列与列之间用Tab分隔）

格式：日期 [Tab] 产品名称 [Tab] 交易类型 [Tab] 基金代码 [Tab] 基金名称 [Tab] 金额/全部 [Tab] 万 [Tab] 产品代码 [Tab] 持仓变动(可选)

示例：
2026/3/17	逸动3个月最短持有期增强型	申购	016841.OF	博道惠泰优选C	35	万	9K706130	1200
2026/3/17	逸动6个月最短持有期增强型	赎回	015364.OF	汇丰晋信价值先锋C	全部	万	9K706130	-1600
2026/3/17	丰利逸动1个月最短持有期日开1号增强型	卖出	513010.SH	易方达恒生科技ETF	80	万	9K717810	-6700"></textarea>
    <div class="hint">
      ⓘ <b>.OF</b> 结尾 → 场外基金（申购/赎回） &nbsp;|&nbsp; <b>.SH/.SZ</b> 结尾 → 场内交易所（买入/卖出）<br>
      &nbsp;&nbsp; 金额列填写 <b>全部</b> 时，系统将从持仓表中获取全部持仓份额（需先上传持仓表）<br>
      &nbsp;&nbsp; 赎回订单的基金净值将从持仓表自动填入，也可手动修改
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="parseBtn" onclick="parseData()">🔍 解析交易数据</button>
      <button class="btn btn-gray" onclick="clearAll()">🗑 清空</button>
    </div>
    <div id="parseError"></div>
  </div>

  <!-- Step 2: Preview & NAV Input -->
  <div class="card" id="previewCard" style="display:none">
    <div class="card-title"><span class="step-label">2</span>交易预览 &amp; 净值填写</div>
    <div id="statsRow" class="stats-row"></div>
    <div id="navWarning" class="warning-box" style="display:none">
      ⚠️ 以下赎回订单需要填写基金净值（NAV），系统将自动计算赎回份额 = 金额 ÷ 净值
    </div>
    <div id="posWarnings"></div>
    <div class="table-wrap">
      <table id="previewTable">
        <thead>
          <tr>
            <th>#</th>
            <th>日期</th>
            <th>产品名称</th>
            <th>产品代码</th>
            <th>交易类型</th>
            <th>基金/资产代码</th>
            <th>基金/资产名称</th>
            <th>金额（万元）</th>
            <th>渠道</th>
            <th>基金净值 (NAV)</th>
            <th>赎回份额</th>
            <th>持仓校验</th>
          </tr>
        </thead>
        <tbody id="previewBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Step 3: Generate -->
  <div class="card" id="generateCard" style="display:none">
    <div class="card-title"><span class="step-label">3</span>生成下单文件</div>

    <!-- 推荐方式：Python后端（格式完全一致） -->
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:14px 16px;margin-bottom:14px">
      <div style="font-weight:600;color:#166534;margin-bottom:6px">⭐ 推荐方式：格式 100% 与模版一致（.xls）——无需联网</div>
      <div style="font-size:13px;color:#166534;line-height:1.7">
        1. 点击「<b>导出交易数据JSON</b>」，将文件保存到 <code style="background:#dcfce7;padding:1px 5px;border-radius:3px">基金下单</code> 文件夹<br>
        2. 告诉 Claude「请帮我生成下单Excel」<br>
        3. Claude 将自动运行 Python 脚本，直接在文件夹生成格式完全一致的 <b>.xls</b> 文件
      </div>
    </div>
    <div class="btn-row" style="margin-bottom:16px">
      <button class="btn btn-success" onclick="exportJSON()">
        📄 导出交易数据JSON（推荐）
      </button>
    </div>

    <div style="border-top:1px solid #e5e7eb;margin:16px 0;padding-top:14px">
      <div style="font-size:12px;color:#94a3b8;margin-bottom:6px">
        备用方式：直接在浏览器下载 .xlsx（需要能访问 cdnjs.cloudflare.com）
      </div>
      <div style="font-size:12px;color:#b45309;background:#fef3c7;padding:6px 10px;border-radius:4px;margin-bottom:10px">
        ⚠️ 如果您在内网环境中无法下载，请使用上方推荐的JSON+Python方式。内网浏览器通常无法访问外部CDN，导致Excel下载不可用。
      </div>
      <div class="btn-row">
        <button class="btn btn-orange" onclick="generateOTC()">⬇ 场外基金下单 (.xlsx)</button>
        <button class="btn btn-gray" onclick="generateExchange()">⬇ 交易所证券投资委托 (.xlsx)</button>
      </div>
    </div>
    <div id="generateMsg"></div>
  </div>

</div>

<script>
// ─── Global state ───────────────────────────────────────────────────────────
let transactions = [];
// positionData key: "PRODUCTCODE|FUNDCODE" -> {shares, nav, name}
let positionData = {};

// ─── XLSX CDN check ──────────────────────────────────────────────────────────
window.addEventListener('load', function() {
  if (typeof XLSX === 'undefined') {
    document.getElementById('xlsxBanner').style.display = '';
  }
});

// ─── Drag-and-drop support for position file upload ──────────────────────────
(function() {
  const area = document.getElementById('posUploadArea');
  area.addEventListener('dragover', function(e) {
    e.preventDefault();
    area.style.borderColor = '#2d6bb5';
    area.style.background = '#eff6ff';
  });
  area.addEventListener('dragleave', function() {
    if (!Object.keys(positionData).length) {
      area.style.borderColor = '#d1d5db';
      area.style.background = '#fafafa';
    }
  });
  area.addEventListener('drop', function(e) {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if (file) loadPositionFile(file);
  });
})();

// ─── Load position file ──────────────────────────────────────────────────────
function loadPositionFile(file) {
  if (!file) return;
  if (typeof XLSX === 'undefined') {
    showPositionStatus('error', 'XLSX库未加载，无法解析Excel文件。请使用JSON+Python方式。');
    return;
  }
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const wb = XLSX.read(e.target.result, { type: 'binary' });
      const ws = wb.Sheets[wb.SheetNames[0]];
      const data = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });
      if (data.length < 2) {
        showPositionStatus('error', '持仓文件为空或格式不正确');
        return;
      }
      // Find columns by header name (more robust than fixed indices)
      const headers = data[0].map(h => h ? String(h).trim() : '');
      const colProductCode = headers.indexOf('产品代码');
      const colExternalCode = headers.indexOf('外部代码');
      const colShares       = headers.indexOf('持仓面额');
      const colAssetName    = headers.indexOf('资产简称');
      // Find 日终全价（元）-产品法估值 (may contain full-width chars)
      const colNav = headers.findIndex(h => h.includes('日终全价') && h.includes('产品法估值'));

      if (colProductCode === -1 || colExternalCode === -1 || colShares === -1 || colNav === -1) {
        showPositionStatus('error',
          '持仓文件缺少必要列，请确认包含：产品代码、外部代码、持仓面额、日终全价（元）-产品法估值');
        return;
      }

      positionData = {};
      let count = 0;
      for (let i = 1; i < data.length; i++) {
        const row = data[i];
        const productCode  = row[colProductCode];
        const externalCode = row[colExternalCode];
        const shares       = row[colShares];
        const nav          = row[colNav];
        if (!productCode || !externalCode || shares === null || shares === undefined) continue;

        const key = String(productCode).trim() + '|' + String(externalCode).trim().toUpperCase();
        const sharesNum = Number(shares) || 0;
        if (positionData[key]) {
          positionData[key].shares += sharesNum;
        } else {
          positionData[key] = {
            shares: sharesNum,
            nav: (nav !== null && nav !== undefined) ? Number(nav) : null,
            name: colAssetName >= 0 ? (row[colAssetName] || '') : ''
          };
          count++;
        }
      }

      showPositionStatus('ok', `✅ 持仓数据已加载：${count} 条持仓记录（${file.name}）`);
      document.getElementById('posUploadArea').classList.add('loaded');

      // Re-enrich if transactions already parsed
      if (transactions.length > 0) {
        enrichTransactionsWithPosition();
        renderPreview();
      }
    } catch (err) {
      showPositionStatus('error', '读取持仓文件失败：' + err.message);
    }
  };
  reader.readAsBinaryString(file);
}

function showPositionStatus(type, msg) {
  const el = document.getElementById('positionStatus');
  el.className = 'pos-status ' + (type === 'ok' ? 'pos-ok' : 'pos-err');
  el.textContent = msg;
}

// ─── Enrich transactions with position data ──────────────────────────────────
function enrichTransactionsWithPosition() {
  transactions.forEach(t => {
    const key = t.productCode + '|' + t.code.toUpperCase();
    const pos = positionData[key];
    if (pos) {
      t.posShares = pos.shares;
      t.posNav    = pos.nav;
      t.posName   = pos.name;
      // Auto-fill NAV for 赎回 orders
      if (t.tradeType === '赎回' && pos.nav) {
        t.nav = pos.nav;
        t.navFromPosition = true;
      }
      // Handle "全部" amount
      if (t.isFullAmount) {
        if (t.tradeType === '赎回') {
          // For OTC redemption: shares = full position, no amount needed
          t.shares = pos.shares;
          t.amount = pos.nav ? parseFloat((pos.shares * pos.nav / 10000).toFixed(4)) : null;
          t.fullAmountResolved = true;
        } else if (t.tradeType === '卖出') {
          // For exchange sell: compute market value in 万
          if (pos.nav !== null) {
            const mv = (pos.nav >= 90)
              ? pos.shares * pos.nav / 100 / 10000   // bond: price per 100 face
              : pos.shares * pos.nav / 10000;          // ETF/fund: price per unit
            t.amount = parseFloat(mv.toFixed(4));
            t.shares = pos.shares;
            t.fullAmountResolved = true;
          }
        }
      }
    }
    // Validate position sufficiency for sell/redeem
    computePositionValidation(t);
  });
}

// Compute validation result and store on transaction
function computePositionValidation(t) {
  t.posValidation = null;
  if (t.posShares === undefined || t.posShares === null) return;

  if (t.tradeType === '赎回') {
    // Need NAV to compute shares required
    if (!t.nav) {
      t.posValidation = { status: 'pending', msg: '待填净值后校验' };
      return;
    }
    const sharesNeeded = t.isFullAmount ? t.shares : (t.amount * 10000 / t.nav);
    if (sharesNeeded <= t.posShares) {
      t.posValidation = {
        status: 'ok',
        msg: `份额充足（持仓 ${fmtNum(t.posShares)} 份，需 ${fmtNum(sharesNeeded)} 份）`
      };
    } else {
      const shortage = sharesNeeded - t.posShares;
      t.posValidation = {
        status: 'warn',
        msg: `份额不足！需 ${fmtNum(sharesNeeded)} 份，持仓仅 ${fmtNum(t.posShares)} 份，缺 ${fmtNum(shortage)} 份`
      };
    }
  } else if (t.tradeType === '卖出') {
    if (!t.posNav) {
      t.posValidation = { status: 'na', msg: '持仓净值缺失，无法校验' };
      return;
    }
    // For 全部, always sufficient
    if (t.isFullAmount) {
      t.posValidation = { status: 'ok', msg: `全部卖出（${fmtNum(t.posShares)} 份）` };
      return;
    }
    const availableWan = (t.posNav >= 90)
      ? t.posShares * t.posNav / 100 / 10000
      : t.posShares * t.posNav / 10000;
    if (t.amount <= availableWan) {
      t.posValidation = {
        status: 'ok',
        msg: `金额充足（持仓市值约 ${fmtNum(availableWan)} 万，委托 ${fmtNum(t.amount)} 万）`
      };
    } else {
      t.posValidation = {
        status: 'warn',
        msg: `金额不足！委托 ${fmtNum(t.amount)} 万，持仓市值约 ${fmtNum(availableWan)} 万`
      };
    }
  }
}

function fmtNum(n) {
  if (n === null || n === undefined) return '—';
  return Number(n).toLocaleString('zh-CN', { maximumFractionDigits: 2 });
}

// ─── Date utilities ─────────────────────────────────────────────────────────
function dateToSerial(str) {
  str = str.trim();
  if (!str) return 0;
  let m;
  if (m = str.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/)) {
    const d = new Date(+m[1], +m[2]-1, +m[3]);
    return Math.round((d - new Date(1899, 11, 30)) / 86400000);
  }
  const n = parseFloat(str);
  if (!isNaN(n) && n > 30000) return n;
  return 0;
}

function serialToDateStr(serial) {
  if (!serial) return '';
  const d = new Date(Math.round((serial - 25569) * 86400 * 1000));
  const utc = new Date(d.getTime() + d.getTimezoneOffset() * 60000);
  return `${utc.getFullYear()}/${utc.getMonth()+1}/${utc.getDate()}`;
}

function parseInputDateStr(str) {
  str = str.trim();
  let m;
  if (m = str.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/)) {
    return `${m[1]}/${m[2]}/${m[3]}`;
  }
  const n = parseFloat(str);
  if (!isNaN(n) && n > 30000) return serialToDateStr(n);
  return str;
}

// ─── Parse pasted data ───────────────────────────────────────────────────────
function parseData() {
  const raw = document.getElementById('inputData').value.trim();
  document.getElementById('parseError').innerHTML = '';

  if (!raw) {
    showError('parseError', '请先粘贴交易数据');
    return;
  }

  const lines = raw.split('\n').map(l => l.trim()).filter(l => l);
  const results = [];
  const errors = [];

  lines.forEach((line, idx) => {
    let cols = line.split('\t');
    if (cols.length < 8) {
      cols = line.split(/\s{2,}/);
    }
    while (cols.length > 0 && cols[cols.length-1].trim() === '') cols.pop();

    if (cols.length < 8) {
      errors.push(`第${idx+1}行数据不完整（期望至少8列，实际${cols.length}列）：${line.substring(0,60)}`);
      return;
    }

    const dateRaw     = cols[0].trim();
    const productName = cols[1].trim();
    const tradeType   = cols[2].trim();
    const code        = cols[3].trim();
    const assetName   = cols[4].trim();
    const productCode = cols[7].trim();

    // Amount: check for "全部" keyword
    let amountRaw = cols[5].trim().replace(/\xa0/g, '').replace(/万/g,'').trim();
    const isFullAmount = amountRaw === '全部' || amountRaw === 'all';
    let amount = null;

    if (!isFullAmount) {
      amount = parseFloat(amountRaw);
      if (isNaN(amount)) {
        errors.push(`第${idx+1}行金额无法解析："${cols[5]}"（填写数字或"全部"）`);
        return;
      }
    }

    // Validate "全部" requires position data
    if (isFullAmount && Object.keys(positionData).length === 0) {
      errors.push(`第${idx+1}行金额为"全部"，但尚未上传持仓盈亏表，请先在步骤0上传持仓表`);
      return;
    }

    const valid = ['申购','赎回','买入','卖出'];
    if (!valid.includes(tradeType)) {
      errors.push(`第${idx+1}行交易类型未识别："${tradeType}"，支持：申购/赎回/买入/卖出`);
      return;
    }

    const codeUpper = code.toUpperCase();
    const isOTC      = codeUpper.endsWith('.OF');
    const isExchange = codeUpper.endsWith('.SH') || codeUpper.endsWith('.SZ');

    if (!isOTC && !isExchange) {
      errors.push(`第${idx+1}行基金代码无法识别（应以.OF/.SH/.SZ结尾）："${code}"`);
      return;
    }

    if (isOTC && tradeType === '卖出') {
      errors.push(`第${idx+1}行：场外基金(.OF)不能使用"卖出"，应使用"赎回"`);
      return;
    }
    if (isExchange && tradeType === '赎回') {
      errors.push(`第${idx+1}行：场内基金(.SH/.SZ)不能使用"赎回"，应使用"卖出"`);
      return;
    }
    if (isExchange && tradeType === '申购') {
      errors.push(`第${idx+1}行：场内基金(.SH/.SZ)不能使用"申购"，应使用"买入"`);
      return;
    }

    results.push({
      id: idx + 1,
      dateRaw,
      dateStr: parseInputDateStr(dateRaw),
      dateSerial: dateToSerial(dateRaw),
      productName,
      productCode,
      tradeType,
      code,
      assetName,
      amount,         // in 万; null if isFullAmount (resolved later)
      isOTC,
      isExchange,
      isFullAmount,
      fullAmountResolved: false,
      nav: null,
      navFromPosition: false,
      shares: null,   // for full redemption
      posShares: undefined,
      posNav: undefined,
      posValidation: null,
      navInputId: `nav_${idx}`
    });
  });

  if (results.length === 0) {
    let msg = '未能解析任何有效交易数据。';
    if (errors.length > 0) msg += `<br><br>错误详情：<br>• ${errors.join('<br>• ')}`;
    showError('parseError', msg);
    return;
  }

  transactions = results;

  // Enrich with position data if available
  if (Object.keys(positionData).length > 0) {
    enrichTransactionsWithPosition();
  }

  renderPreview();

  if (errors.length > 0) {
    showError('parseError', `⚠️ 以下${errors.length}行解析失败：<br>• ${errors.join('<br>• ')}`);
  }
}

// ─── Render preview table ────────────────────────────────────────────────────
