    return;
  }
  const missing = transactions.filter(t => t.tradeType === '赎回' && !t.nav && !t.isFullAmount);
  if (missing.length > 0) {
    showMsg('generateMsg',
      `⚠️ 以下赎回订单尚未填写净值，导出后 Python 脚本将跳过这些订单：<br>• ${missing.map(t => t.assetName + '(' + t.code + ')').join('<br>• ')}`,
      'error');
  }

  const exportData = {
    exportTime: new Date().toISOString(),
    transactions: transactions.map(t => ({
      id: t.id,
      dateStr: t.dateStr,
      productName: t.productName,
      productCode: t.productCode,
      tradeType: t.tradeType,
      code: t.code,
      assetName: t.assetName,
      amount: t.amount,
      isOTC: t.isOTC,
      isExchange: t.isExchange,
      isFullAmount: t.isFullAmount,
      shares: t.shares || null,
      nav: t.nav || null
    }))
  };

  const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'transaction_data.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);

  showMsg('generateMsg',
    `✅ 已导出 <b>transaction_data.json</b>（${transactions.length} 笔交易）<br>` +
    `📌 请将文件保存到"基金下单"文件夹，然后告诉 Claude：<b>"请帮我生成下单Excel"</b>`,
    'success');
}

// ─── Helpers ─────────────────────────────────────────────────────────────────
function pad(n) { return String(n).padStart(2, '0'); }

function showError(containerId, msg) {
  document.getElementById(containerId).innerHTML = `<div class="error-msg">❌ ${msg}</div>`;
}

function showMsg(containerId, msg, type) {
  const cls = type === 'success' ? 'success-msg' : 'error-msg';
  document.getElementById(containerId).innerHTML = `<div class="${cls}">${msg}</div>`;
}

function clearAll() {
  document.getElementById('inputData').value = '';
  document.getElementById('parseError').innerHTML = '';
  document.getElementById('previewCard').style.display = 'none';
  document.getElementById('generateCard').style.display = 'none';
  document.getElementById('generateMsg').innerHTML = '';
  transactions = [];
}

// ─── Keyboard shortcut: Ctrl+Enter to parse ──────────────────────────────────
document.getElementById('inputData').addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') parseData();
});
</script>
