    border-radius: 6px;
    font-size: 13px;
    margin-top: 12px;
  }
  .success-msg {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 13px;
    margin-top: 12px;
  }
  .stats-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .stat-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
