  .pos-file-input { display: none; }
  .pos-status {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 500;
  }
  .pos-ok { color: #16a34a; }
  .pos-err { color: #dc2626; }
  /* Validation cell */
  .val-ok { color: #16a34a; font-size: 12px; }
  .val-warn { color: #dc2626; font-size: 12px; font-weight: 500; }
  .val-na { color: #94a3b8; font-size: 12px; }
  /* CDN warning banner */
  .cdn-warn {
    background: #fffbeb;
    border-left: 4px solid #f59e0b;
    padding: 12px 16px;
    font-size: 13px;
    color: #92400e;
    margin-bottom: 20px;
    border-radius: 0 6px 6px 0;
  }
</style>
