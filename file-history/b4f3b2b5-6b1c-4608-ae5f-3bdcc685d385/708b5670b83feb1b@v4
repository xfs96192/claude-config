  const exCount     = transactions.filter(t => t.isExchange).length;
  const redeemCount = transactions.filter(t => t.tradeType === '赎回').length;
  const warnCount   = transactions.filter(t => t.posValidation && t.posValidation.status === 'warn').length;

  document.getElementById('statsRow').innerHTML = `
    <div class="stat-box"><div class="num">${transactions.length}</div><div class="label">总笔数</div></div>
    <div class="stat-box"><div class="num" style="color:#16a34a">${otcCount}</div><div class="label">场外基金(.OF)</div></div>
    <div class="stat-box"><div class="num" style="color:#ea580c">${exCount}</div><div class="label">场内证券(.SH/.SZ)</div></div>
    <div class="stat-box"><div class="num" style="color:#9333ea">${redeemCount}</div><div class="label">需填净值(赎回)</div></div>
    ${warnCount > 0 ? `<div class="stat-box" style="border-color:#fca5a5"><div class="num" style="color:#dc2626">${warnCount}</div><div class="label">持仓不足警告</div></div>` : ''}
  `;

  document.getElementById('navWarning').style.display = redeemCount > 0 ? '' : 'none';

  // Position warnings summary
  const posWarnEl = document.getElementById('posWarnings');
  const insufficientList = transactions.filter(t => t.posValidation && t.posValidation.status === 'warn');
  if (insufficientList.length > 0) {
    posWarnEl.innerHTML = `<div class="warning-box" style="border-color:#fca5a5;background:#fef2f2;color:#b91c1c">
      ⚠️ <b>持仓份额不足警告（${insufficientList.length} 笔）：</b><br>
      ${insufficientList.map(t =>
        `• <b>${t.assetName}</b>（${t.code}）— ${t.posValidation.msg}`
      ).join('<br>')}
    </div>`;
  } else {
    posWarnEl.innerHTML = '';
  }

  transactions.forEach(t => {
    const tr = document.createElement('tr');

    const typeBadge = {
      '申购': '<span class="badge badge-green">申购</span>',
      '赎回': '<span class="badge badge-red">赎回</span>',
      '卖出': '<span class="badge badge-orange">卖出</span>',
      '买入': '<span class="badge badge-blue">买入</span>',
    }[t.tradeType] || t.tradeType;

    const channelBadge = t.isOTC
      ? '<span class="badge badge-blue">场外</span>'
      : '<span class="badge badge-orange">场内</span>';

    const isRedeem = t.tradeType === '赎回';

    // Amount display
    let amountDisplay;
    if (t.isFullAmount) {
      if (t.fullAmountResolved && t.amount !== null) {
        amountDisplay = `<span class="badge badge-purple">全部</span><br><span style="font-size:11px;color:#6b7280">≈ ${fmtNum(t.amount)} 万</span>`;
      } else {
        amountDisplay = `<span class="badge badge-purple">全部</span><br><span style="font-size:11px;color:#dc2626">持仓数据不足</span>`;
      }
    } else {
      amountDisplay = `<span class="amount-display">${fmtNum(t.amount)} 万</span>`;
    }

    // NAV cell
    let navCell;
    if (isRedeem) {
      const navVal  = t.nav ? t.nav.toFixed(4) : '';
      const navCls  = t.navFromPosition ? 'nav-input from-pos' : 'nav-input';
      const tipText = t.navFromPosition ? '来自持仓表' : 'Wind获取后填入';
      const tipCls  = t.navFromPosition ? 'nav-tip from-pos' : 'nav-tip';
      navCell = `
        <div><input class="${navCls}" id="${t.navInputId}" type="number" step="0.0001" min="0.0001"
                value="${navVal}" placeholder="输入净值" oninput="updateShares('${t.navInputId}', ${t.id})"></div>
        <div class="${tipCls}">${tipText}</div>`;
    } else {
      navCell = '<span style="color:#cbd5e1">—</span>';
    }

    // Shares cell
    let sharesCell;
    if (isRedeem) {
      if (t.isFullAmount && t.shares !== null) {
        sharesCell = `<span class="shares-preview">${fmtNum(t.shares)} 份（全部）</span>`;
      } else {
        sharesCell = `<div id="shares_${t.id}" style="color:#94a3b8;font-size:12px">待填净值</div>`;
      }
    } else {
      sharesCell = '<span style="color:#cbd5e1">—</span>';
    }

    // Position validation cell
    let posCell = '<span class="val-na">—</span>';
    if (t.posValidation) {
      if (t.posValidation.status === 'ok') {
        posCell = `<span class="val-ok">✅ ${t.posValidation.msg}</span>`;
      } else if (t.posValidation.status === 'warn') {
        posCell = `<span class="val-warn">⚠️ ${t.posValidation.msg}</span>`;
      } else if (t.posValidation.status === 'pending') {
        posCell = `<span class="val-na">${t.posValidation.msg}</span>`;
      } else {
        posCell = `<span class="val-na">${t.posValidation.msg}</span>`;
      }
    } else if (Object.keys(positionData).length > 0 && (t.tradeType === '赎回' || t.tradeType === '卖出')) {
      posCell = t.posShares === undefined
        ? '<span class="val-na">持仓中未找到该资产</span>'
        : '<span class="val-na">待填净值后校验</span>';
    } else if (Object.keys(positionData).length === 0) {
      posCell = '<span class="val-na">未加载持仓表</span>';
    }

    tr.innerHTML = `
      <td style="color:#94a3b8">${t.id}</td>
      <td>${t.dateStr}</td>
      <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${t.productName}">${t.productName}</td>
      <td class="code-cell">${t.productCode}</td>
      <td>${typeBadge}</td>
      <td class="code-cell">${t.code}</td>
      <td>${t.assetName}</td>
      <td>${amountDisplay}</td>
      <td>${channelBadge}</td>
      <td>${navCell}</td>
      <td id="shares_wrap_${t.id}">${sharesCell}</td>
      <td style="min-width:200px">${posCell}</td>
    `;
    tbody.appendChild(tr);

    // If NAV is pre-filled (from position), trigger share calculation
    if (isRedeem && t.nav && !t.isFullAmount) {
      setTimeout(() => updateShares(t.navInputId, t.id), 30);
    }
  });

  document.getElementById('previewCard').style.display = '';
  document.getElementById('generateCard').style.display = '';
}

// ─── Update share preview on NAV input ──────────────────────────────────────
function updateShares(inputId, txId) {
  const input   = document.getElementById(inputId);
  const wrapDiv = document.getElementById(`shares_wrap_${txId}`);
  const nav     = parseFloat(input.value);
  const tx      = transactions.find(t => t.id === txId);
  if (!tx) return;

  if (isNaN(nav) || nav <= 0) {
    input.classList.add('error');
    if (wrapDiv) wrapDiv.innerHTML = '<span style="color:#ef4444;font-size:12px">净值无效</span>';
    tx.nav = null;
    computePositionValidation(tx);
    updatePositionCell(tx);
    return;
  }

  input.classList.remove('error');
  tx.nav = nav;
  tx.navFromPosition = false; // user manually changed it

  const shares = tx.isFullAmount ? tx.shares : (tx.amount * 10000 / nav);
  if (wrapDiv) {
    wrapDiv.innerHTML = `<span class="shares-preview">≈ ${fmtNum(shares)} 份</span>`;
  }

  // Re-validate position
  computePositionValidation(tx);
  updatePositionCell(tx);
}

// Update the position validation cell for a single row
function updatePositionCell(tx) {
  // Find the cell by row index in the table
  const rows = document.getElementById('previewBody').rows;
  for (let i = 0; i < rows.length; i++) {
    const firstCell = rows[i].cells[0];
    if (firstCell && parseInt(firstCell.textContent) === tx.id) {
      const posCell = rows[i].cells[11];
      if (posCell && tx.posValidation) {
        if (tx.posValidation.status === 'ok') {
          posCell.innerHTML = `<span class="val-ok">✅ ${tx.posValidation.msg}</span>`;
        } else if (tx.posValidation.status === 'warn') {
          posCell.innerHTML = `<span class="val-warn">⚠️ ${tx.posValidation.msg}</span>`;
        } else {
          posCell.innerHTML = `<span class="val-na">${tx.posValidation.msg}</span>`;
        }
      }
      break;
    }
  }
  // Update warning summary
  const insufficientList = transactions.filter(t => t.posValidation && t.posValidation.status === 'warn');
  const posWarnEl = document.getElementById('posWarnings');
  if (insufficientList.length > 0) {
    posWarnEl.innerHTML = `<div class="warning-box" style="border-color:#fca5a5;background:#fef2f2;color:#b91c1c">
      ⚠️ <b>持仓份额不足警告（${insufficientList.length} 笔）：</b><br>
      ${insufficientList.map(t => `• <b>${t.assetName}</b>（${t.code}）— ${t.posValidation.msg}`).join('<br>')}
    </div>`;
  } else {
    posWarnEl.innerHTML = '';
  }
}

// ─── Generate OTC Excel ──────────────────────────────────────────────────────
function generateOTC() {
  const otcTx = transactions.filter(t => t.isOTC);
  if (otcTx.length === 0) {
    showMsg('generateMsg', '当前数据中没有场外基金(.OF)交易', 'warn');
    return;
  }
  const missing = otcTx.filter(t => t.tradeType === '赎回' && !t.nav && !t.isFullAmount);
  if (missing.length > 0) {
    showMsg('generateMsg', `⚠️ 以下赎回订单尚未填写净值：<br>• ${missing.map(t=>t.assetName+'('+t.code+')').join('<br>• ')}`, 'error');
    return;
  }
  const wb = XLSX.utils.book_new();
  const { ws, rowCount } = buildOTCSheet(otcTx);
  XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');
  const today = new Date();
  const fname = `场外基金下单_${today.getFullYear()}${pad(today.getMonth()+1)}${pad(today.getDate())}.xlsx`;
  XLSX.writeFile(wb, fname);
  showMsg('generateMsg', `✅ 场外基金下单文件已生成：${fname}（${rowCount}笔交易）`, 'success');
}

function buildOTCSheet(otcTx) {
  const headers = [
    '交易日期','产品代码*','申购代码','组合代码','基金代码*','交易类型*',
    '交易对手类型*','交易对手','分红设置','投资方式*','投资份额','投资金额','认购价格',
    '下一业务授权审批人','终批人','业务送审说明','是否纳入全行统一授信*','风险审批通知书编号',
    '下柜流水号','投资模式','切分审批通知书编号','子策略名称','母策略名称','销售机构',
    '转入基金代码','巨额赎回标识','全额转出'
  ];
  const rows = [headers];
  let rowCount = 0;

  otcTx.forEach(t => {
    const amountYuan = t.amount ? Math.round(t.amount * 10000) : '';
    if (t.tradeType === '申购') {
      rows.push([
        t.dateSerial, t.productCode, '', '', t.code, '申购', '外部', '',
        '分红再投资', '金额投资', '', amountYuan, '', '', '',
        '基金申购', '否', '', '', '基金池', '', '', '', '', '', '', ''
      ]);
      rowCount++;
    } else if (t.tradeType === '赎回') {
      let shares, fullRedeem;
      if (t.isFullAmount && t.shares !== null) {
        shares = parseFloat(t.shares.toFixed(2));
        fullRedeem = '是';
      } else {
        shares = parseFloat((t.amount * 10000 / t.nav).toFixed(2));
        fullRedeem = '';
      }
      rows.push([
        t.dateSerial, t.productCode, '', '', t.code, '赎回', '外部', '',
        '', '份额投资', shares, '', '', '', '',
        '基金赎回', '否', '', '', '基金池', '', '', '', '', '', '', fullRedeem
      ]);
      rowCount++;
    }
  });

  const ws = XLSX.utils.aoa_to_sheet(rows);
  for (let r = 1; r < rows.length; r++) {
    const cellAddr = XLSX.utils.encode_cell({ r, c: 0 });
    const cell = ws[cellAddr];
    if (cell && typeof cell.v === 'number') { cell.t = 'n'; cell.z = 'yyyy/m/d'; }
  }
  ws['!cols'] = [
    {wch:12},{wch:12},{wch:10},{wch:10},{wch:14},{wch:8},
    {wch:10},{wch:10},{wch:10},{wch:10},{wch:12},{wch:12},{wch:10},
    {wch:16},{wch:10},{wch:10},{wch:18},{wch:16},
    {wch:12},{wch:10},{wch:16},{wch:12},{wch:12},{wch:12},
    {wch:14},{wch:12},{wch:10}
  ];
  return { ws, rowCount };
}

