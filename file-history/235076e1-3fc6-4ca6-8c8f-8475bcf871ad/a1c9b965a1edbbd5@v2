        print(f"{'='*100}")
        header = f"{'资产':<14}" + "".join(f"{y:>7}" for y in years)
        print(header)
        print("-" * len(header))
        for aname in asset_names:
            row = f"{aname:<14}"
            for y in years:
                val = results[period][aname].get(y)
                if val is None:
                    row += f"{'N/A':>7}"
                elif aname == '10Y国债(bp)':
                    row += f"{val:>6.0f}b"
                else:
                    row += f"{val:>6.1f}%"
            print(row)

    # ── 统计（排除2020）─────────────────────────────────────────
    years_ex2020 = [y for y in years if y != 2020]
    print(f"\n{'='*100}")
    print("  统计摘要（排除2020年COVID年份）")
    print(f"{'='*100}")
    for period in periods:
        print(f"\n  [{period}]")
        for aname in asset_names:
            vals = [results[period][aname][y] for y in years_ex2020 if results[period][aname].get(y) is not None]
            if vals:
                unit = 'bp' if aname == '10Y国债(bp)' else '%'
                pos_rate = sum(1 for v in vals if v > 0) / len(vals) * 100
                print(f"    {aname:<14} 均值={np.mean(vals):+.1f}{unit}  中位数={np.median(vals):+.1f}{unit}  胜率={pos_rate:.0f}%  ({len(vals)}年)")

