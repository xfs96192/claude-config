    # ── 图1: 热力图 (2×2, 四个时期) ─────────────────────────────
    fig, axes = plt.subplots(2, 2, figsize=(26, 14))
    fig.suptitle('中国两会前后各资产表现热力图 (2008–2025)', fontsize=17, fontweight='bold', y=0.99)

    for idx, period in enumerate(periods):
        ax = axes[idx//2][idx%2]
        matrix = np.array([
            [results[period][a].get(y, np.nan) for y in years]
            for a in asset_names
        ], dtype=float)

        # 对债券行进行缩放以便颜色可比（可转债和股票都是%，债券是bp）
        # 独立归一化每行使颜色更直观
        max_abs = np.nanmax(np.abs(matrix))
        if max_abs == 0: max_abs = 1
        norm = TwoSlopeNorm(vmin=-max_abs, vcenter=0, vmax=max_abs)

        im = ax.imshow(matrix, cmap='RdYlGn', norm=norm, aspect='auto')

        ax.set_xticks(range(len(years)))
        ax.set_xticklabels([str(y) for y in years], rotation=45, ha='right', fontsize=9)
        ax.set_yticks(range(len(asset_names)))
        ax.set_yticklabels(asset_names, fontsize=11)
        ax.set_title(period, fontsize=14, fontweight='bold', pad=8)

        # 标注数值
        for i, aname in enumerate(asset_names):
            for j, y in enumerate(years):
                val = matrix[i, j]
                if np.isnan(val): continue
                unit = 'b' if aname == '10Y国债(bp)' else '%'
                txt = f"{val:+.0f}{unit}" if aname == '10Y国债(bp)' else f"{val:+.1f}{unit}"
                bg_intensity = abs(val) / max_abs
                color = 'white' if bg_intensity > 0.65 else 'black'
                ax.text(j, i, txt, ha='center', va='center', fontsize=7.5,
                        color=color, fontweight='bold')

        # 2020列标记
        idx_2020 = years.index(2020)
        ax.axvline(x=idx_2020 - 0.5, color='navy', lw=1.5, ls='--', alpha=0.6)
        ax.axvline(x=idx_2020 + 0.5, color='navy', lw=1.5, ls='--', alpha=0.6)

        plt.colorbar(im, ax=ax, shrink=0.85, pad=0.02)

    plt.tight_layout(rect=[0, 0, 1, 0.97])
