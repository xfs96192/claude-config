try:
    print("Fetching equity/commodity data...")
    raw_hs300 = c.csd("000300.SH", "CLOSE", fetch_start, fetch_end, "Ispandas=1")
    raw_zz500 = c.csd("000905.SH", "CLOSE", fetch_start, fetch_end, "Ispandas=1")
    raw_kzz   = c.csd("000832.SH", "CLOSE", fetch_start, fetch_end, "Ispandas=1")
    raw_gold  = c.csd("AU0.SHF",   "CLOSE", fetch_start, fetch_end, "Ispandas=1")
    raw_nh    = c.csd("000040.SH", "CLOSE", fetch_start, fetch_end, "Ispandas=1")

    print("Fetching 10Y treasury yield...")
    raw_bond = c.edb("E1000180", f"StartDate={fetch_start},EndDate={fetch_end},Ispandas=1")

    # ── 解析函数 ──────────────────────────────────────────────────
    def parse_csd(df):
        df = df.reset_index()
        df.columns = ['code', 'date', 'value']
        df['date'] = pd.to_datetime(df['date'], format='%Y/%m/%d')
        return df.set_index('date')[['value']].dropna().sort_index()

    def parse_edb(df):
        df2 = df[['DATES', 'RESULT']].copy()
        df2['DATES'] = pd.to_datetime(df2['DATES'], format='%Y/%m/%d')
        df2['RESULT'] = pd.to_numeric(df2['RESULT'], errors='coerce')
        return df2.rename(columns={'DATES':'date','RESULT':'value'}).set_index('date')[['value']].dropna().sort_index()

    ts = {
        '沪深300':     parse_csd(raw_hs300),
        '中证500':     parse_csd(raw_zz500),
        '可转债':      parse_csd(raw_kzz),
        '黄金':        parse_csd(raw_gold),
        '南华商品':    parse_csd(raw_nh),
        '10Y国债(bp)': parse_edb(raw_bond),
    }
    asset_names = list(ts.keys())
    print("Data loaded. Rows:", {k: len(v) for k, v in ts.items()})

    # ── 辅助取价函数 ──────────────────────────────────────────────
    def price_n_before(series, date_str, n):
        """第n个交易日前的收盘价（不含当日）"""
        d = pd.Timestamp(date_str)
        sub = series[series.index < d]
        if len(sub) < n: return None
        return float(sub.iloc[-n]['value'])

    def price_1_before(series, date_str):
        d = pd.Timestamp(date_str)
        sub = series[series.index < d]
        return float(sub.iloc[-1]['value']) if not sub.empty else None

    def price_first_in(series, date_str):
        """会期第一个交易日"""
        d = pd.Timestamp(date_str)
        sub = series[series.index >= d]
        return float(sub.iloc[0]['value']) if not sub.empty else None

    def price_last_in(series, date_str):
        """会期最后一个交易日"""
        d = pd.Timestamp(date_str)
        sub = series[series.index <= d]
        return float(sub.iloc[-1]['value']) if not sub.empty else None

    def price_n_after(series, date_str, n):
        """会后第n个交易日收盘价"""
        d = pd.Timestamp(date_str)
        sub = series[series.index > d]
        if len(sub) < n: return None
        return float(sub.iloc[n-1]['value'])

    def pct(end, base):
        if end is None or base is None or base == 0: return None
        return (end/base - 1) * 100

    def bp(end, base):
        if end is None or base is None: return None
        return (end - base) * 100

    # ── 计算四个时期收益 ──────────────────────────────────────────
    periods = ['前一月', '前一周', '两会期间', '后一周']
    results = {p: {a: {} for a in asset_names} for p in periods}

    for year, (s_date, e_date) in two_sessions.items():
        for aname, series in ts.items():
            is_bond = (aname == '10Y国债(bp)')
            calc = bp if is_bond else pct

            # 前一月: [−20TD, −1TD) before session start
            p20 = price_n_before(series, s_date, 20)
            p1  = price_1_before(series, s_date)
            results['前一月'][aname][year] = calc(p1, p20)

            # 前一周: [−5TD, −1TD) before session start
            p5 = price_n_before(series, s_date, 5)
            results['前一周'][aname][year] = calc(p1, p5)

            # 两会期间: first TD of session → last TD of session
            p_start = price_first_in(series, s_date)
            p_end   = price_last_in(series, e_date)
            results['两会期间'][aname][year] = calc(p_end, p_start)

            # 后一周: last TD of session → +5TD after session end
            p_base = price_last_in(series, e_date)
            p_a5   = price_n_after(series, e_date, 5)
            results['后一周'][aname][year] = calc(p_a5, p_base)

    # ── 打印完整数据表（所有年份）─────────────────────────────────
