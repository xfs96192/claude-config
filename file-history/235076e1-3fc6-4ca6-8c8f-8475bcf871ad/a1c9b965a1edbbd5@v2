    plt.savefig(p1, dpi=160, bbox_inches='tight')
    print(f"\n[图1已保存] {p1}")
    plt.close()

    # ── 图2–5: 每个时期的分组柱状图 ─────────────────────────────
    for period in periods:
        fig, ax = plt.subplots(figsize=(24, 8))

        n_a = len(asset_names)
