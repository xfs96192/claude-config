    # ══════════════════════════════════════════════════════════════
    output_dir = os.path.expanduser("~/Desktop")

    asset_colors = {
        '沪深300':     '#E63946',
        '中证500':     '#FF7F11',
        '可转债':      '#8338EC',
        '黄金':        '#D4A017',
