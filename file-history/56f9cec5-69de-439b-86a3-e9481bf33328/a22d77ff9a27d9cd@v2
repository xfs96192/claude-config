    """调用Claude CLI对文本进行结构化提取（可选）"""
    # 直接返回原文（后续可接入Claude API做智能摘要）
    return text


def write_to_vault(content: str, target_dir: Path, filename: str, source_path: Path):
    """写入Obsidian Vault"""
    target_dir.mkdir(parents=True, exist_ok=True)
    md_path = target_dir / f"{filename}.md"

    header = f"""---
source: {source_path.name}
source_path: {source_path}
extracted: {datetime.now().strftime('%Y-%m-%d')}
type: extracted
---

# {filename}

> 来源：`{source_path.name}`
> 提取时间：{datetime.now().strftime('%Y-%m-%d')}

"""

    with open(md_path, 'w', encoding='utf-8') as f:
        f.write(header + content)

    return md_path


# ─── 主流程 ─────────────────────────────────────────────────────────────

def scan_mode():
    """扫描模式：只统计，不写入"""
    print("\n📊 扫描结果（不写入文件）\n")
    total = 0
    for src_dir, dst_dir in EXTRACT_TARGETS.items():
        files = get_files(src_dir)
        total += len(files)
        print(f"  {src_dir.name}/")
        print(f"    → {len(files)} 个文件 → {dst_dir.relative_to(VAULT)}")
        for f in files[:5]:
            print(f"      • {f.name}")
        if len(files) > 5:
            print(f"      ... 还有 {len(files)-5} 个")
        print()
    print(f"总计：{total} 个文件")


def extract_mode(target_name: str = None):
    """提取模式：读取并写入Vault"""
    log = []

    targets = EXTRACT_TARGETS.items()
    if target_name:
        targets = [(k, v) for k, v in EXTRACT_TARGETS.items() if target_name in str(k)]

    for src_dir, dst_dir in targets:
        files = get_files(src_dir)
        if not files:
            continue

        print(f"\n📂 处理：{src_dir.name}/ ({len(files)} 个文件)")

        for filepath in files:
            print(f"  ⏳ {filepath.name}...", end='', flush=True)
            text = extract_text(filepath)

            if len(text) < 50:
                print(" [内容过少，跳过]")
                continue

            filename = to_markdown_filename(filepath.stem)
            md_path = write_to_vault(text, dst_dir, filename, filepath)

            print(f" ✅ → {md_path.relative_to(VAULT)}")
            log.append({"source": str(filepath), "output": str(md_path), "chars": len(text)})

    # 写入日志
    log_path = VAULT / "投资经理/个人档案/提取日志.json"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with open(log_path, 'w', encoding='utf-8') as f:
        json.dump(log, f, ensure_ascii=False, indent=2)

    print(f"\n✅ 完成！共提取 {len(log)} 个文件")
    print(f"📝 日志：{log_path}")


def build_index():
    """生成知识库索引文件"""
    print("\n📚 生成知识库索引...")

    index_lines = [
        "# 知识库总索引\n",
        f"> 最后更新：{datetime.now().strftime('%Y-%m-%d %H:%M')}\n",
        "\n## 文件统计\n"
    ]

    total = 0
    for folder in sorted(VAULT.rglob('*')):
        if folder.is_dir() and not folder.name.startswith('.'):
            md_files = list(folder.glob('*.md'))
            if md_files:
                rel = folder.relative_to(VAULT)
                index_lines.append(f"- **{rel}/** — {len(md_files)} 个文件")
                total += len(md_files)

    index_lines.append(f"\n**总计：{total} 个知识文件**\n")
    index_lines.append("\n## 分类导航\n")
    index_lines.append("- [[投资经理/产品手册/产品总览|产品手册]]\n")
    index_lines.append("- [[投资经理/工作流程/每日流程|工作流程]]\n")
    index_lines.append("- [[研究相关/市场复盘|市场复盘]]\n")
    index_lines.append("- [[数据知识库/数据源总览|数据源]]\n")

    index_path = VAULT / "INDEX.md"
    with open(index_path, 'w', encoding='utf-8') as f:
        f.write("\n".join(index_lines))

    print(f"✅ 索引已生成：{index_path}")


