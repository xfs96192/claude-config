# ─── 工具函数 ────────────────────────────────────────────────────────────

def extract_docx(filepath: Path) -> str:
    """提取Word文档文本"""
    try:
        from docx import Document
        doc = Document(str(filepath))
        paragraphs = []
        for para in doc.paragraphs:
            text = para.text.strip()
            if text:
                # 标题段落加粗
                if para.style.name.startswith('Heading'):
                    level = para.style.name.replace('Heading ', '').replace('标题 ', '')
                    try:
                        level = int(level)
                        paragraphs.append(f"\n{'#' * (level + 1)} {text}\n")
                    except:
                        paragraphs.append(f"\n## {text}\n")
                else:
                    paragraphs.append(text)

        # 提取表格
        for table in doc.tables:
            rows = []
            for i, row in enumerate(table.rows):
                cells = [cell.text.strip().replace('\n', ' ') for cell in row.cells]
                rows.append("| " + " | ".join(cells) + " |")
                if i == 0:
                    rows.append("|" + "|".join(["---"] * len(cells)) + "|")
            if rows:
                paragraphs.append("\n" + "\n".join(rows) + "\n")

        return "\n".join(paragraphs)
    except Exception as e:
        return f"[提取失败: {e}]"


def extract_pptx(filepath: Path) -> str:
    """提取PPT文本"""
    try:
        from pptx import Presentation
        prs = Presentation(str(filepath))
        slides = []
        for i, slide in enumerate(prs.slides, 1):
            texts = []
            for shape in slide.shapes:
                if hasattr(shape, "text") and shape.text.strip():
                    texts.append(shape.text.strip())
            if texts:
                slides.append(f"\n### 第{i}页\n" + "\n".join(texts))
        return "\n".join(slides)
    except Exception as e:
        return f"[提取失败: {e}]"


def extract_text(filepath: Path) -> str:
    """根据文件类型提取文本"""
    suffix = filepath.suffix.lower()
    if suffix in ['.docx', '.doc']:
        return extract_docx(filepath)
    elif suffix in ['.pptx', '.ppt']:
        return extract_pptx(filepath)
    else:
        return f"[不支持的格式: {suffix}]"


def get_files(folder: Path, extensions=('.docx', '.doc', '.pptx', '.ppt')) -> list:
    """递归获取文件列表，排除临时文件"""
    files = []
    if not folder.exists():
        return files
    for f in folder.rglob('*'):
        if f.suffix.lower() in extensions and not f.name.startswith('~$') and f.is_file():
            files.append(f)
    return sorted(files)


def to_markdown_filename(name: str) -> str:
    """转换为合法的Markdown文件名"""
    name = name.replace('/', '-').replace('\\', '-').replace(':', '').replace('*', '')
    return name[:80]  # 限制长度


