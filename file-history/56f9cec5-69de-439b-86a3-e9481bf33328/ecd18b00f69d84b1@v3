    OBSIDIAN_DIR.mkdir(parents=True, exist_ok=True)
    out_path = OBSIDIAN_DIR / f"Twitter日报_{date_str}.md"
    out_path.write_text(md, encoding="utf-8")
    print(f"📝 已写入: {out_path}")
    print(f"   文件大小: {len(md):,} 字符")


if __name__ == "__main__":
    main()
