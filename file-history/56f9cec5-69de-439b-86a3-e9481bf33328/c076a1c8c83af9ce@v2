<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fanshengxia.twitter-daily-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/fanshengxia/.claude/skills/twitter-daily-digest/scripts/fetch_tweets.py</string>
    </array>

    <!-- 每天 08:00 Asia/Shanghai 执行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/fanshengxia/.claude/skills/twitter-daily-digest/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fanshengxia/.claude/skills/twitter-daily-digest/logs/stderr.log</string>

    <!-- 机器唤醒后如果错过了执行时间，补跑一次 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
