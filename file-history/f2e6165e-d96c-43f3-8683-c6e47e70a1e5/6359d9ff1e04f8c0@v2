/* ====== Series Operations Section ====== */
const SERIES_FIXED_COLS  = ['产品代码','产品简称','净资产(亿)','形态','业绩基准','本期年化','累计年化','杠杆','组合久期','组合静态','运作天','剩余天','产品经理'];
const SERIES_EQUITY_COLS = ['产品代码','产品简称','净资产(亿)','形态','业绩基准','本期年化','累计年化','杠杆','权益仓位','组合久期','运作天','剩余天','产品经理'];
const SERIES_FX_COLS     = ['产品代码','产品简称','净资产(亿)','形态','业绩基准','本期年化','累计年化','杠杆','运作天','剩余天','产品经理'];
const EQUITY_MU = new Set(['逸动短持','灵动短持','兴动短持','含权定开/封闭','优先股短持','ESG联名','和瑞BOF','外币市值']);
const FX_ONLY_MU = new Set(['外币低波']);
const MU_ORDER  = ['悦动稳享短持','悦动稳/纯享','优先股短持','丰利/增盈','行外非标驱动型固收+','和瑞BOF','悦动短持/定开','逸动短持','灵动短持','兴动短持','含权定开/封闭','ESG联名','外币低波','外币市值'];
const SERIES_PCT_COLS = new Set(['本期年化','累计年化','业绩基准','权益仓位']);

function getSeriesCols(mu) {
  if (FX_ONLY_MU.has(mu)) return SERIES_FX_COLS;
  if (EQUITY_MU.has(mu)) return SERIES_EQUITY_COLS;
  return SERIES_FIXED_COLS;
}

function formatSeriesVal(val, colName) {
  if (val == null || val === '') return '';
  const s = String(val);
  if (s.toLowerCase() === 'nan' || s === '') return '';
  if (TEXT_COL_NAMES.has(colName)) return s; // product code as text
  if (SERIES_PCT_COLS.has(colName)) {
    const n = parseFloat(val);
    if (!isFinite(n)) return s;
    // Values stored as decimals (e.g. 0.025 → 2.50%)
    return n < 2 && n > -2 ? (n * 100).toFixed(2) + '%' : n.toFixed(2) + '%';
  }
  if (['净资产(亿)','杠杆','组合久期','组合静态'].includes(colName)) {
    const n = parseFloat(val); return isFinite(n) ? n.toFixed(2) : s;
  }
  if (['运作天','剩余天'].includes(colName)) {
    const n = parseFloat(val); return isFinite(n) ? Math.round(n).toString() : s;
  }
  // Date columns
  if (['起息日','到期日'].includes(colName)) {
    if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
    const n = parseInt(val);
    if (!isNaN(n) && n > 40000) { // Excel serial date
      const d = new Date(Date.UTC(1899,11,30) + n*86400000);
      return d.toISOString().slice(0,10);
    }
    return s;
  }
  return s;
}

function generateSeriesTableHTML(rows, cols) {
  if (!rows || rows.length === 0) return '<div class="empty-state">无数据</div>';
  let html = '<div class="table-wrapper"><table class="tbl-sticky"><tr class="header-row">';
  for (const c of cols) html += '<th>' + escHtml(c) + '</th>';
  html += '</tr>';
  // Data rows
  let totalAum = 0;
  const aumIdx = cols.indexOf('净资产(亿)');
  for (const row of rows) {
    html += '<tr>';
    for (const c of cols) {
      let val = row[c];
      const display = formatSeriesVal(val, c);
      let cls = '';
      if (TEXT_COL_NAMES.has(c)) cls = 'code-cell';
      else if (NAME_COL_NAMES.has(c)) cls = 'name-cell';
      else if (['净资产(亿)','运作天','剩余天'].includes(c)) cls = 'num-cell';
      else if (SERIES_PCT_COLS.has(c)) {
        const n = typeof val === 'number' ? val : parseFloat(val);
        cls = 'num-cell' + (isFinite(n) && n < 0 ? ' val-negative' : '');
      }
      const titleAttr = NAME_COL_NAMES.has(c) && val != null ? ' title="'+escHtml(String(val))+'"' : '';
      html += '<td' + (cls ? ' class="'+cls.trim()+'"' : '') + titleAttr + '>' + escHtml(display) + '</td>';
    }
    html += '</tr>';
    if (aumIdx >= 0) {
      const v = parseFloat(row['净资产(亿)']);
      if (isFinite(v)) totalAum += v;
    }
  }
  // Summary row
  html += '<tr class="total-row">';
  for (let ci = 0; ci < cols.length; ci++) {
    const c = cols[ci];
    if (ci === 0) { html += '<td class="code-cell">—</td>'; continue; }
    if (ci === 1) { html += '<td style="font-weight:600">合计</td>'; continue; }
    if (c === '净资产(亿)') { html += '<td class="num-cell" style="font-weight:600">' + totalAum.toFixed(2) + '</td>'; continue; }
    // Weighted avg for performance cols
    if (SERIES_PCT_COLS.has(c)) {
      // compute AUM-weighted average
      let wSum = 0, wTotal = 0;
      for (const row of rows) {
        const w = parseFloat(row['净资产(亿)']);
        const v = parseFloat(row[c]);
        if (isFinite(w) && isFinite(v)) { wSum += w * v; wTotal += w; }
      }
      const avg = wTotal > 0 ? wSum / wTotal : null;
      html += '<td class="num-cell">' + (avg != null ? (avg < 2 && avg > -2 ? (avg*100).toFixed(2)+'%' : avg.toFixed(2)+'%') : '') + '</td>';
      continue;
    }
    html += '<td></td>';
  }
  html += '</tr>';
  html += '</table></div>';
  return html;
}

function rebuildSeriesSection(rawData) {
  const content = document.getElementById('series-ops-content');
  if (!content) return;
  if (!rawData || rawData.length === 0) { content.innerHTML = '<div class="empty-state">数据为空</div>'; return; }

  const data = rawData.filter(r => String(r['主要展示'] || '').trim() === '是');
  const groups = {};
  for (const row of data) {
    const mu = String(row['母分类'] || '').trim();
    if (!mu) continue;
    if (!groups[mu]) groups[mu] = [];
    groups[mu].push(row);
  }

  const order = MU_ORDER.filter(m => groups[m]);
  for (const mu of Object.keys(groups)) { if (!order.includes(mu)) order.push(mu); }

  // Nav buttons
  let navHTML = '<div class="series-nav">';
  for (const mu of order) navHTML += '<button class="series-nav-btn" onclick="scrollToSeries(\''+escHtml(mu)+'\')">'+escHtml(mu)+'</button>';
  navHTML += '</div>';

  let tablesHTML = '';
  for (const mu of order) {
    const rows = groups[mu];
    rows.sort((a, b) => (parseFloat(b['净资产(亿)']) || 0) - (parseFloat(a['净资产(亿)']) || 0));
    const cols = getSeriesCols(mu);
    const totalAum = rows.reduce((s, r) => s + (parseFloat(r['净资产(亿)']) || 0), 0);
    const avgRet = (() => {
      let wSum=0, wT=0;
      for (const r of rows) { const w=parseFloat(r['净资产(亿)']), v=parseFloat(r['本期年化']); if(isFinite(w)&&isFinite(v)){wSum+=w*v;wT+=w;} }
      return wT > 0 ? (wSum/wT*100).toFixed(2)+'%' : '—';
    })();
    tablesHTML += '<div class="series-block" id="series-mu-'+encodeURIComponent(mu)+'">';
    tablesHTML += '<div class="series-block-header">';
    tablesHTML += '<span class="series-block-title">'+escHtml(mu)+'</span>';
    tablesHTML += '<span class="series-block-stats">'+rows.length+'只 · 规模 '+totalAum.toFixed(2)+'亿 · 本期加权年化 '+avgRet+'</span>';
    tablesHTML += '</div>';
    tablesHTML += generateSeriesTableHTML(rows, cols);
    tablesHTML += '</div>';
  }

  content.innerHTML = navHTML + tablesHTML;
  initTableSort();
}

function scrollToSeries(mu) {
  const el = document.getElementById('series-mu-' + encodeURIComponent(mu));
  if (el) { const hh = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')) || 52; const y = el.getBoundingClientRect().top + window.pageYOffset - hh - 10; window.scrollTo({ top: y, behavior: 'smooth' }); }
