  e.target.value = '';
}

async function handleOverviewUpload(e) {
  const file = e.target.files[0]; if (!file) return;
  if (!file.name.match(/\.(xlsx|xls)$/i)) { showToast('请上传 .xlsx 格式的Excel文件','error'); return; }
  showToast('正在解析运作概览文件 '+escHtml(file.name)+' ...','');
  try {
    const wb = XLSX.read(await file.arrayBuffer(), {type:'array', cellDates:false});
