      const ws = wb.Sheets[name];
      const jsonData = XLSX.utils.sheet_to_json(ws, {header:1, defval:null, raw:true});
      sheets[name] = {data:jsonData, col_count:jsonData[0]?jsonData[0].length:0, merged_cells:(ws['!merges']||[]).map(m=>XLSX.utils.encode_range(m))};
    }
    preprocessSheets(sheets);
