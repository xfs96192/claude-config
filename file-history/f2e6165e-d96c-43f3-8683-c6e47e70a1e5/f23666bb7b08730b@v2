ROWSPAN_FUNC = """/* ====== Rowspan Helper ====== */
function computeRowspanMap(data, colIdx) {
  // Returns map: row_index → rowspan count (0 = skip/merged)
  const map = {};
  let i = 1; // skip header
  while (i < data.length) {
    const val = String(data[i][colIdx] == null ? '' : data[i][colIdx]).trim();
    if (!val) { i++; continue; }
    let j = i + 1;
    while (j < data.length && String(data[j][colIdx] == null ? '' : data[j][colIdx]).trim() === val) j++;
    map[i] = j - i;
    for (let k = i + 1; k < j; k++) map[k] = 0;
    i = j;
  }
  return map;
}
"""
