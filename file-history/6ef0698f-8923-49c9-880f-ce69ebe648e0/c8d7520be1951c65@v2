    def last_before(df, ts):
        """Last available (date, value) on or before ts."""
        if df is None: return None, np.nan
        avail = df.index[df.index <= ts]
        if len(avail) == 0: return None, np.nan
        d = avail[-1]
        return d, df.loc[d, 'value']

    def first_after(df, ts):
        """First available (date, value) on or after ts."""
        if df is None: return None, np.nan
        avail = df.index[df.index >= ts]
        if len(avail) == 0: return None, np.nan
        d = avail[0]
        return d, df.loc[d, 'value']

    def nth_trading_day(df, base_ts, n):
        """Date n trading days from base_ts (negative = before)."""
        if df is None: return None
        dates = df.index.sort_values()
        avail = dates[dates <= base_ts]
        if len(avail) == 0: return None
        base = avail[-1]
        pos = np.searchsorted(dates, base)
        new_pos = pos + n
        if 0 <= new_pos < len(dates):
            return dates[new_pos]
        return None

    def pct_change(v_start, v_end, is_yield=False):
        if np.isnan(v_start) or np.isnan(v_end): return np.nan
        if is_yield:  return (v_end - v_start) * 100   # bp
        if v_start == 0: return np.nan
        return (v_end / v_start - 1) * 100              # %

