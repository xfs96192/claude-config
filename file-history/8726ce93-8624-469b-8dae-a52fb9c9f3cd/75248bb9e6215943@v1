#!/bin/bash
# 市场指数复盘自动化脚本 v3.0
# 数据源: iChoice (EMQuantAPI) + AKShare
# 用法: ./run_market_review.sh [YYYY-MM-DD]
# 如果不提供日期，则使用当天日期

set -e

# 项目根目录
PROJECT_ROOT="/Users/fanshengxia/Desktop/市场观点美化"
DATA_DIR="${PROJECT_ROOT}/data"
DASHBOARD_DIR="${PROJECT_ROOT}/asset-analysis-real-data/asset-analysis-dashboard"

# 获取日期参数
if [ -n "$1" ]; then
    TARGET_DATE="$1"
else
    TARGET_DATE=$(date +%Y-%m-%d)
fi

echo "=================================================="
echo "市场指数复盘 - 自动化流程 v3.0"
echo "截止日期: ${TARGET_DATE}"
echo "数据源: iChoice (EMQuantAPI) + AKShare"
echo "覆盖指标: 36个（权益9/债券9/汇率6/商品12）"
echo "=================================================="

# 第一步：生成 iChoice + AKShare 数据
echo ""
echo "[1/4] 生成市场数据（iChoice + AKShare，约60-120秒）..."
cd "${DATA_DIR}"
python generate_tables_from_ichoice.py --date "${TARGET_DATE}"

# 第二步：转换为 JSON
echo ""
echo "[2/4] 转换 Excel 为 JSON..."
python excel_to_json_converter.py

# 第三步：启动前端服务（后台）
echo ""
echo "[3/4] 启动前端服务..."
cd "${DASHBOARD_DIR}"
./node_modules/.bin/vite --port 5173 --host 0.0.0.0 &
VITE_PID=$!
echo "Vite PID: ${VITE_PID}，等待20秒启动..."
sleep 20

# 第四步：截图
echo ""
echo "[4/4] 截图存档..."
SCREENSHOT_PATH="${PROJECT_ROOT}/市场复盘_${TARGET_DATE}.png"

# 写入截图脚本
cat > /tmp/screenshot_market_review.js << EOF
const puppeteer = require('puppeteer');
(async () => {
    const browser = await puppeteer.launch({
        headless: 'new',
        args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage', '--disable-gpu']
    });
    const page = await browser.newPage();
    await page.setViewport({ width: 1920, height: 1080 });
    try {
        await page.goto('http://192.168.8.144:5173/', { waitUntil: 'domcontentloaded', timeout: 60000 });
    } catch(e) { console.log('goto:', e.message); }
    await new Promise(resolve => setTimeout(resolve, 15000));
    await page.screenshot({
        path: '${SCREENSHOT_PATH}',
        fullPage: true
    });
    await browser.close();
    console.log('截图已保存: ${SCREENSHOT_PATH}');
})();
EOF

# 确保 puppeteer 已安装
cd /tmp
if [ ! -d "node_modules/puppeteer" ]; then
    echo "安装 puppeteer..."
    npm install puppeteer --no-save 2>/dev/null
fi

node /tmp/screenshot_market_review.js

# 关闭前端服务
echo ""
echo "关闭前端服务 (PID: ${VITE_PID})..."
kill ${VITE_PID} 2>/dev/null || true

echo ""
echo "=================================================="
echo "完成! 生成的文件："
echo "  - ${DATA_DIR}/指标值.xlsx"
echo "  - ${DATA_DIR}/近1月净值走势.xlsx"
echo "  - ${DATA_DIR}/asset_data.json"
echo "  - ${SCREENSHOT_PATH}"
echo "=================================================="
