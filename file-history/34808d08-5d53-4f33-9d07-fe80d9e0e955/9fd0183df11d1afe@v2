def write_report(ws, df):
    ROW_OFFSET = 3   # 标题占3行

    # ── 标题 ──
    ws.merge_cells('A1:O2')
    title_cell = ws['A1']
    title_cell.value = "部门重点产品业绩对比分析  |  截止日期：2026-03-19"
    title_cell.font = Font(name='微软雅黑', size=16, bold=True, color=C_WHITE)
    title_cell.fill = PatternFill("solid", fgColor=C_TITLE_BG)
    title_cell.alignment = Alignment(horizontal='center', vertical='center')
    ws.row_dimensions[1].height = 30
    ws.row_dimensions[2].height = 5

    # ── 列头定义 ──
    col_headers = [
        ('系列', 8),
        ('代码', 10),
        ('产品/基准名称', 28),
        ('近1月\n年化', 9),
        ('近3月\n年化', 9),
        ('近6月\n年化', 9),
        ('近1年\n年化', 9),
        ('成立以来\n年化', 10),
        ('2025年\n年化', 9),
        ('2026年\n年化', 9),
        ('成立以来\n最大回撤', 11),
        ('3月回撤\n(2026/03)', 11),
        ('3-4月回撤\n(2025)', 11),
        ('10-11月回撤\n(2025)', 13),
    ]

    HEADER_ROW = 3
    for col_idx, (header_text, col_width) in enumerate(col_headers, 1):
        cell = ws.cell(row=HEADER_ROW, column=col_idx)
        cell.value = header_text
        cell.font = Font(name='微软雅黑', size=10, bold=True, color=C_WHITE)
        cell.fill = PatternFill("solid", fgColor=C_TITLE_BG)
        cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
        cell.border = thin_border()
        ws.column_dimensions[get_column_letter(col_idx)].width = col_width
    ws.row_dimensions[HEADER_ROW].height = 36

    # ── 分隔符单元格设置 ──
    def write_section_header(row, text, bg_color, font_color=C_WHITE):
        ws.merge_cells(f'A{row}:N{row}')
        cell = ws.cell(row=row, column=1)
        cell.value = text
        cell.font = Font(name='微软雅黑', size=10, bold=True, color=font_color)
        cell.fill = PatternFill("solid", fgColor=bg_color)
        cell.alignment = Alignment(horizontal='left', vertical='center', indent=1)
        ws.row_dimensions[row].height = 20

    # ── 写入数据 ──
    data_rows = df.to_dict('records')
    current_row = HEADER_ROW + 1

    # 产品区
    products = [r for r in data_rows if r['类型'] == '产品']
    benchmarks = [r for r in data_rows if r['类型'] == '基准']

    write_section_header(current_row, "▌ 部门重点产品（7只）", C_HEADER_PRODUCT)
    current_row += 1

    prev_series = None
    for i, row in enumerate(products):
        code = row['代码']
        series = SERIES_MAP.get(code, '')
        abbrev = NAME_ABBREV.get(code, row['名称'][:20])
        bg = C_SECTION_PROD if i % 2 == 0 else C_WHITE

        # 系列分隔线
        if series != prev_series and prev_series is not None:
            # 在两系列间加一条细线
            for c in range(1, 15):
                ws.cell(row=current_row-1, column=c).border = thick_border_bottom()
        prev_series = series

        # 写单元格
        vals = [
            series, code, abbrev,
        ]
        for m in ALL_METRIC_COLS:
            vals.append(row.get(m, np.nan))

        for col_idx, val in enumerate(vals, 1):
            cell = ws.cell(row=current_row, column=col_idx)
            if isinstance(val, float) and np.isnan(val):
                cell.value = 'N/A'
                cell.font = Font(name='微软雅黑', size=10, color='AAAAAA')
            elif isinstance(val, float):
                cell.value = val
                cell.number_format = '0.00%'
                # 着色
                metric_name = ALL_METRIC_COLS[col_idx - 4] if col_idx >= 4 else None
                if metric_name:
                    is_ret = metric_name in RETURN_COLS
                    color_cell(ws, current_row, col_idx, val, is_return=is_ret)
                if not any(cell.fill.fgColor.rgb != '00000000' for _ in [1]):
                    cell.font = Font(name='微软雅黑', size=10)
            else:
                cell.value = val
                cell.font = Font(name='微软雅黑', size=10)

            cell.alignment = Alignment(horizontal='center', vertical='center')
            # 名称列左对齐
            if col_idx == 3:
                cell.alignment = Alignment(horizontal='left', vertical='center', indent=1)
            cell.border = thin_border()
            # 背景（未被着色时）
            if cell.fill.fgColor.rgb in ('00000000', '000000'):
                cell.fill = PatternFill("solid", fgColor=bg)

        ws.row_dimensions[current_row].height = 18
        current_row += 1

    # 基准区 - 空行间隔
    current_row += 1
    write_section_header(current_row, "▌ 业绩基准（6个）", C_HEADER_BENCH)
    current_row += 1

    prev_bench_series = None
    for i, row in enumerate(benchmarks):
        bench_series = BENCH_SERIES_MAP.get(row['名称'], '')
        bg = C_SECTION_BENCH if i % 2 == 0 else C_WHITE

        if bench_series != prev_bench_series and prev_bench_series is not None:
            for c in range(1, 15):
                ws.cell(row=current_row-1, column=c).border = thick_border_bottom()
        prev_bench_series = bench_series

        vals = [bench_series, '', row['名称']]
        for m in ALL_METRIC_COLS:
            vals.append(row.get(m, np.nan))

        for col_idx, val in enumerate(vals, 1):
            cell = ws.cell(row=current_row, column=col_idx)
            if isinstance(val, float) and np.isnan(val):
                cell.value = 'N/A'
                cell.font = Font(name='微软雅黑', size=10, color='AAAAAA')
            elif isinstance(val, float):
                cell.value = val
                cell.number_format = '0.00%'
                metric_name = ALL_METRIC_COLS[col_idx - 4] if col_idx >= 4 else None
                if metric_name:
                    is_ret = metric_name in RETURN_COLS
                    color_cell(ws, current_row, col_idx, val, is_return=is_ret)
                if not any(cell.fill.fgColor.rgb != '00000000' for _ in [1]):
                    cell.font = Font(name='微软雅黑', size=10)
            else:
                cell.value = val
                cell.font = Font(name='微软雅黑', size=10)

            cell.alignment = Alignment(horizontal='center', vertical='center')
            if col_idx == 3:
                cell.alignment = Alignment(horizontal='left', vertical='center', indent=1)
            cell.border = thin_border()
            if cell.fill.fgColor.rgb in ('00000000', '000000'):
                cell.fill = PatternFill("solid", fgColor=bg)

        ws.row_dimensions[current_row].height = 18
        current_row += 1

    # ── 图例区 ──
    current_row += 1
    ws.merge_cells(f'A{current_row}:N{current_row}')
    legend = ws.cell(row=current_row, column=1)
    legend.value = (
        "颜色说明：  收益率 → 绿色=正收益 | 红色=负收益    "
        "最大回撤 → 绿色=<0.3% | 黄色=0.3%~1% | 红色=>1%    "
        "N/A = 产品运作时间不足，无法计算该期指标"
    )
    legend.font = Font(name='微软雅黑', size=9, color='595959', italic=True)
    legend.fill = PatternFill("solid", fgColor="F8F9FA")
    legend.alignment = Alignment(horizontal='left', vertical='center', indent=1)
    ws.row_dimensions[current_row].height = 18

    current_row += 1
    ws.merge_cells(f'A{current_row}:N{current_row}')
    note = ws.cell(row=current_row, column=1)
    note.value = (
        "数据说明：产品净值数据来源周报V2净值缓存，Wind基金指数来源Wind导出数据，"
        "中债-新综合全价(1-3年)指数及沪深300来源iChoice，所有数据统一截止2026-03-19。"
    )
    note.font = Font(name='微软雅黑', size=9, color='595959', italic=True)
    note.fill = PatternFill("solid", fgColor="F8F9FA")
    note.alignment = Alignment(horizontal='left', vertical='center', indent=1)
    ws.row_dimensions[current_row].height = 18

    # ── 冻结 ──
    ws.freeze_panes = f'A{HEADER_ROW + 1}'

    # ── 分组列标注（收益率区 vs 回撤区） ──
    # 在列头上方加一行小标注
    ws.insert_rows(HEADER_ROW)
    ws.merge_cells(f'D{HEADER_ROW}:J{HEADER_ROW}')
    ret_header = ws.cell(row=HEADER_ROW, column=4)
    ret_header.value = "── 年化收益率 ──"
    ret_header.font = Font(name='微软雅黑', size=9, bold=True, color=C_WHITE)
    ret_header.fill = PatternFill("solid", fgColor=C_SUBHEADER)
    ret_header.alignment = Alignment(horizontal='center', vertical='center')

    ws.merge_cells(f'K{HEADER_ROW}:N{HEADER_ROW}')
    dd_header = ws.cell(row=HEADER_ROW, column=11)
    dd_header.value = "── 最大回撤（阶段）──"
    dd_header.font = Font(name='微软雅黑', size=9, bold=True, color=C_WHITE)
    dd_header.fill = PatternFill("solid", fgColor="70AD47")
    dd_header.alignment = Alignment(horizontal='center', vertical='center')

    # 填充 A-C 合并区域
    ws.merge_cells(f'A{HEADER_ROW}:C{HEADER_ROW}')
    ws.cell(row=HEADER_ROW, column=1).fill = PatternFill("solid", fgColor=C_TITLE_BG)
    ws.row_dimensions[HEADER_ROW].height = 16


write_report(ws, df)

