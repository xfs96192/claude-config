# === Helper Functions ===

def format_drawdown(dd_value, ws, row, col_val=COL_DD_VALUE, col_bp=COL_DD_BP):
    """Format drawdown values per template conventions"""
    if dd_value is None or pd.isna(dd_value) or dd_value == 0:
        ws.cell(row, col_val).value = "-"
        ws.cell(row, col_bp).value = "0bp"
    else:
        ws.cell(row, col_val).value = dd_value
        bp_value = int(round(abs(float(dd_value)) * 10000))
        ws.cell(row, col_bp).value = f"{bp_value}bp"


def find_latest_pdf():
    """Find the PDF with highest product number"""
    pdf_files = list(AUDIT_FORM_DIR.glob("*.pdf*"))
    if not pdf_files:
        return None

    # Extract product code from filename and find max
    def extract_code(f):
        m = re.match(r'(9K\d+)', f.name)
        return m.group(1) if m else ""

    latest = max(pdf_files, key=lambda f: extract_code(f))
    return latest


def extract_pdf_data(pdf_path):
    """Extract 非标驱动 product data from PDF"""
    print(f"  提取PDF: {pdf_path.name}")

    all_text = ""
    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            text = page.extract_text()
            if text:
                all_text += text + "\n"

    # Extract product code from filename
    code_match = re.match(r'(9K\d+)', pdf_path.name)
    product_code = code_match.group(1) if code_match else "未知"

    # Extract product number for short name
    num_match = re.search(r'(\d+)号', pdf_path.name)
    product_num = num_match.group(1) if num_match else "?"
    product_name = f"丰利合享{product_num}号"

    # Extract dates - look for 成立日/起息日 and 到期日
    # Common patterns in these PDFs
    start_date = None
    end_date = None

    # Try to find dates
    date_patterns = [
        r'(?:产品成立日|起息日)[：:\s]*(\d{4}[-/年]\d{1,2}[-/月]\d{1,2})',
        r'(?:到期日|产品到期日)[：:\s]*(\d{4}[-/年]\d{1,2}[-/月]\d{1,2})',
    ]

    for line in all_text.split('\n'):
        if '成立日' in line or '起息日' in line:
            dm = re.search(r'(\d{4})[年/-](\d{1,2})[月/-](\d{1,2})', line)
            if dm:
                start_date = datetime(int(dm.group(1)), int(dm.group(2)), int(dm.group(3)))
        if '到期日' in line:
            dm = re.search(r'(\d{4})[年/-](\d{1,2})[月/-](\d{1,2})', line)
            if dm:
                end_date = datetime(int(dm.group(1)), int(dm.group(2)), int(dm.group(3)))

    # Calculate run days
    run_days = (end_date - start_date).days + 1 if start_date and end_date else 0

    # Extract benchmark rates for each share class
    # Look for patterns like "A X.XX%" or "份额 X.XX%"
    shares = {}
    share_pattern = r'([A-F])(?:份额)?[^0-9]*?(\d+\.?\d*)\s*%'

    # Also try table extraction
    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            tables = page.extract_tables()
            for table in tables:
                for row in table:
                    row_text = ' '.join([str(c) for c in row if c])
                    if '业绩比较基准' in row_text or '基准下限' in row_text or '区间' in row_text:
                        for cell in row:
                            if cell:
                                cell_str = str(cell)
                                matches = re.findall(share_pattern, cell_str)
                                for m in matches:
                                    shares[m[0]] = float(m[1])

    # If table extraction didn't work, try text
    if not shares:
        # Search for benchmark info in text
        for line in all_text.split('\n'):
            if '基准' in line or '下限' in line:
                matches = re.findall(share_pattern, line)
                for m in matches:
                    shares[m[0]] = float(m[1])

    # Format benchmark string
    if shares:
        parts = []
        for s in sorted(shares.keys()):
            parts.append(f"{s}份额{shares[s]:.2f}%")
        benchmark_str = "；".join(parts)
    else:
        benchmark_str = "待手动填写"

    result = {
        "product_code": product_code,
        "product_name": product_name,
        "run_days": run_days,
        "benchmark": benchmark_str,
        "start_date": start_date,
        "end_date": end_date,
    }

    print(f"  产品代码: {product_code}")
    print(f"  产品名称: {product_name}")
    print(f"  运行天数: {run_days}")
    print(f"  业绩基准: {benchmark_str}")

    return result


