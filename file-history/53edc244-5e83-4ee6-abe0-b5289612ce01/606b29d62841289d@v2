import pandas as pd
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

df = pd.read_excel('数据/产品运作概览数据-母产品/产品运作概览20251225-仅母产品.xlsx')
df['到期日'] = pd.to_datetime(df['到期日'])
# Exclude placeholder dates (2099) and filter from 2026-03
df = df[(df['到期日'] >= '2026-03-01') & (df['到期日'].dt.year < 2099)]

df['到期月份'] = df['到期日'].dt.to_period('M').astype(str)

col_order = [
    '悦动稳享短持', '悦动稳/纯享', '优先股短持', '丰利/增盈',
    '行外非标驱动型固收+', '和瑞BOF', '悦动短持/定开', '逸动短持',
    '灵动短持', '兴动短持', '含权定开/封闭', 'ESG联名',
    '外币低波', '外币市值'
]

pivot = df.groupby(['到期月份', '母分类']).size().unstack(fill_value=0)
for c in col_order:
    if c not in pivot.columns:
        pivot[c] = 0
pivot = pivot[col_order].sort_index()
pivot['合计'] = pivot.sum(axis=1)

# Build display DataFrame
display = pivot.copy().astype(object)
for col in display.columns:
    display[col] = display[col].apply(lambda x: '-' if x == 0 else x)
display.reset_index(inplace=True)

print(f"Total months: {len(display)}")
print(display.to_string(index=False))

# ---- Build Excel ----
wb = Workbook()
ws = wb.active
ws.title = '到期产品只数统计'

thin = Side(style='thin')
border = Border(left=thin, right=thin, top=thin, bottom=thin)

blue_fill   = PatternFill('solid', start_color='4472C4', end_color='4472C4')
green_fill  = PatternFill('solid', start_color='548235', end_color='548235')
orange_fill = PatternFill('solid', start_color='C55A11', end_color='C55A11')
gold_fill   = PatternFill('solid', start_color='FFD966', end_color='FFD966')
alt_fill    = PatternFill('solid', start_color='DDEEFF', end_color='DDEEFF')

white_bold = Font(bold=True, color='FFFFFF', size=10)
dark_bold  = Font(bold=True, size=10)
normal     = Font(size=10)
center     = Alignment(horizontal='center', vertical='center', wrap_text=True)

# ---- Row 1: group headers ----
ws.merge_cells('A1:A2')
ws['A1'] = '只数'
ws['A1'].font = white_bold
ws['A1'].fill = blue_fill
ws['A1'].alignment = center

ws.merge_cells('B1:F1')
ws['B1'] = '中低波稳健产品'
ws['B1'].font = white_bold
ws['B1'].fill = blue_fill
ws['B1'].alignment = center

ws.merge_cells('G1:M1')
ws['G1'] = '中高波市值产品'
ws['G1'].font = white_bold
ws['G1'].fill = green_fill
ws['G1'].alignment = center

ws.merge_cells('N1:O1')
ws['N1'] = '外币产品'
ws['N1'].font = white_bold
ws['N1'].fill = orange_fill
ws['N1'].alignment = center

ws.merge_cells('P1:P2')
ws['P1'] = '合计'
ws['P1'].font = dark_bold
ws['P1'].fill = gold_fill
ws['P1'].alignment = center

# Apply border to all row1 cells including merged
for col_idx in range(1, 17):
    ws.cell(row=1, column=col_idx).border = border
    ws.cell(row=2, column=col_idx).border = border

# ---- Row 2: sub-category headers ----
# Skip col 1 (merged with A1) and col 16 (merged with P1)
sub_headers = col_order  # cols 2-15
sub_fills   = [blue_fill]*5 + [green_fill]*7 + [orange_fill]*2
for i, (val, fill) in enumerate(zip(sub_headers, sub_fills), start=2):
    cell = ws.cell(row=2, column=i, value=val)
    cell.font = white_bold
    cell.fill = fill
    cell.alignment = center
    cell.border = border

# ---- Data rows ----
for r_idx, row in enumerate(display.itertuples(index=False), start=3):
    is_alt = (r_idx % 2 == 0)
    for c_idx, val in enumerate(row, start=1):
        cell = ws.cell(row=r_idx, column=c_idx, value=val)
        cell.alignment = center
        cell.border = border
        if c_idx == 1:
            cell.font = dark_bold
        elif c_idx == 16:
            cell.font = dark_bold
            cell.fill = gold_fill
        elif is_alt:
            cell.fill = alt_fill
            cell.font = normal
        else:
            cell.font = normal

# ---- Column widths ----
ws.column_dimensions['A'].width = 11
for i in range(2, 16):
    ws.column_dimensions[get_column_letter(i)].width = 10
ws.column_dimensions['P'].width = 7

# ---- Row heights ----
ws.row_dimensions[1].height = 18
ws.row_dimensions[2].height = 52
for r in range(3, 3 + len(display)):
    ws.row_dimensions[r].height = 17

out_path = '输出结果/到期产品只数统计.xlsx'
wb.save(out_path)
print(f'\nSaved: {out_path}')
