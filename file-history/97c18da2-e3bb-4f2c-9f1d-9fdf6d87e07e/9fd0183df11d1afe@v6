def write_section_banner(ws, row, text, color):
    ws.merge_cells(f'A{row}:N{row}')
    c = ws.cell(row=row, column=1)
    c.value = text
    c.font = Font(name='微软雅黑', size=10, bold=True, color=C_WHITE)
    c.fill = PatternFill("solid", fgColor=color)
    c.alignment = Alignment(horizontal='left', vertical='center', indent=2)
    ws.row_dimensions[row].height = 20

def write_data_rows(ws, start_row, records, series_map, name_abbrev,
                    odd_color, is_product=True):
    row = start_row
    prev_series = None
    for i, rec in enumerate(records):
        code = rec.get('代码', '')
        series = series_map.get(code if is_product else rec['名称'], '')
        name = name_abbrev.get(code, rec['名称']) if is_product else rec['名称']
        bg = odd_color if i % 2 == 0 else C_WHITE

        # 系列分隔线（在上一行底部加粗边框）
        if series != prev_series and prev_series is not None:
            for ci in range(1, 15):
                cell = ws.cell(row=row-1, column=ci)
                b = cell.border
                cell.border = Border(
                    left=b.left, right=b.right, top=b.top,
                    bottom=Side(style='medium', color='2E4057')
                )
        prev_series = series

        ws.row_dimensions[row].height = 18

        # 固定列
        for ci, val, align in [
            (COL_SERIES, series, 'center'),
            (COL_CODE,   code if is_product else '', 'center'),
            (COL_NAME,   name, 'left'),
        ]:
            c = ws.cell(row=row, column=ci)
            c.value = val
            c.font = Font(name='微软雅黑', size=10)
            c.fill = PatternFill("solid", fgColor=bg)
            c.alignment = Alignment(
                horizontal=align, vertical='center',
                indent=(1 if align=='left' else 0)
            )
            c.border = box()

        # 数值列
        for mi, metric in enumerate(ALL_METRICS):
            col_idx = COL_RETURN_START + mi  # D=4 开始
            val = rec.get(metric, np.nan)
            is_ret = metric in RETURN_COLS
            color_value_cell(ws, row, col_idx, val, is_ret)
            # 背景（未着色时）
            cell = ws.cell(row=row, column=col_idx)
            if cell.fill.fgColor.rgb in ('00000000', '000000', 'FF000000'):
                cell.fill = PatternFill("solid", fgColor=bg)

        row += 1
    return row

